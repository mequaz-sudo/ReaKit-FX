        k >= 0 ? ( ALT ? ( qzg_delete(k); k = -1; ) : qzg_toggle_power(k); )
               : !ALT ? ( k = qzg_new_band(qzg_x2f(mx), qzg_y2d(my), 0); );   // Stereo: all the strip's curve shows
      ) : ( qzg_ect = qzg_now; qzg_ecx = mx; qzg_ecy = my; qzg_ecs = _srf; qzg_eck = k; );
      k >= 0 ? (
        qzg_ed = k; qzg_eo = _srf; qzg_et = qzg_now; qzg_ex0 = mx; qzg_ey0 = my; qzg_em = 0;
        qzg_ef0 = qzg_v(k, 3); qzg_eg0 = qzg_v(k, 4); qzg_eq0 = qzg_v(k, 5);
        qzg_ehot = 1; qzg_ehv = k;
      );
      lmb_down = 0;
    );
    // the wheel over a dot = its Q, as the window's and ReEQ's (whose strip is its window drawn small; the user,
    // 2026-10-30: "Scroll wheel adjust q"): up = narrower, the window's step; cuts keep theirs (their height is their Q,
    // set by the drag). Off the dots the notch is dropped, as it always was. REAPER hands a strip the wheel only after
    // a click on it (rk_srf_wheel, measured 2026-10-08).
    frame_wheel != 0 ? (
      k = qzg_emb_hit(mx, my, 12 * qzg_s);
      k >= 0 && qzg_has_q(qzg_shape(k)) && !qzg_is_cut(qzg_shape(k)) ? (
