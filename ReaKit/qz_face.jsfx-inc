    qzg_lb != 1 ? ( k = 0; loop(16, qzg_on(k) && qzg_place(k) && qzg_cvon[k] ? qzg_band_fill(k, 1); k += 1; ); );
    qzg_draw_ptot(1.2 * s);
    k = 0; loop(16, qzg_on(k) && qzg_place(k) && qzg_cvon[k] ? qzg_draw_band_curve(k, 1); k += 1; );
