    qzg_col(qzg_p_zero, 1); qzg_hline(0, gfx_w, qzg_d2y(0));
    // the window's layers at the strip's size, with every On band filled as ReEQ's strip does: the Stereo bands' fills
    // (with an edge) and the Bypassed outlines, the Mid / Side / Left / Right bands' fills, the placements' totals,
    // the Mid / Side / Left / Right lines, then the summed line on top
