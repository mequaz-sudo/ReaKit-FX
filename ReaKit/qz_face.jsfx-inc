);
// one strip dot (hot: the hovered or dragged one), in the strip's node look; the caller set rk_curve_style
function qzg_emb_dot(k, hot) local(nl, c, rad) (
  nl = qzg_look(qzv_sn); c = qzg_bcol(k);
  rad = (nl == 1 ? 2.5 / 0.85 * (hot ? 1.5 : 1) : 6 / (nl == 2 ? RKCV_BADGE_K : 1)) * qzg_s;
  sprintf(#qzg_t, "%d", qzg_dn[k] + 1);
  rk_curve_node_paint_ex(qzg_emb_x(k), qzg_emb_y(k), rad, hot, hot && qzg_ed === k, qzg_on(k) ? 1 : 0.30,
                         ((c / 65536) | 0) / 255, (((c / 256) | 0) & 255) / 255, (c & 255) / 255, nl == 1 ? -1 : #qzg_t);
);
function qzg_embed() local(s, k, j, n, y0, r, w, h, f, sr, zone, want, t, fill) (
  qzg_txk = 1;                         // the strips keep their sizes (TEXT is the window's)
  qzg_once();
