// (C) 2026 EON Studios. EON Free Licence 1.0 (see Quezy_ReaKit.jsfx); ReEQ's gestures are reimplemented, MIT notice there.
// qz_face.jsfx-inc -- Quezy's window (EON, 2026-10-20; build step 4a). Design: .docs/specs/mockups/Quezy_mockup_v8.html
// (the "Midnight" look), spec .docs/specs/Spec_Quezy_Free_EQ_2026-10-10.md §3 (ReEQ's gestures) and §8.
//
// Everything here runs in @gfx only. Every name it owns starts qzg_ (state), qzv_ (view state the host saves in
// @serialize) or is a local; it never writes an audio-side name. The host:
//   imports rk_svf, rk_svf_match, qz_engine, rk_srf, rk_menu and this file, in that order (and freemem = rkm_setup(freemem))
//   @init:   freemem = qzg_setup(freemem); then qzg_b1..qzg_b16 .qz_band_init() -- the DISPLAY filter bank, @init
//            only (qz_band_init writes rk_svf's plugin-wide SAMPLE_RATE)
//   @gfx:    the house frame head (rk_srf), then qzg_window() or qzg_embed(), then rk_srf_store()
// The display bank is retargeted here from the sliders and snapped (qzg_snap), so the curve never reads the audio bank
// (instance members are plugin-wide, wiki 1.14). Every control writes sliders through qzg_set (slider(i) = v;
// slider_automate(slider(i))); @block derives the sound from the sliders itself, so a face change reaches the sound
// without @slider (wiki 00-rules, the Filter 1.1.2 lesson).
//
// 4a: graph (grid, labels, per-band and summed curves, dots, hover readout, drag tag, box select), the dB range pill,
// band bar, editor strip (shape, placement, cut style, Bell Prop Q, F / G / Q / slope, power, delete, fold), the output
// bar at the bottom (OUT, SCALE, MID/L, SIDE/R, M/S | L/R, polarities, LIMIT), ReEQ's gestures (select, ctrl+click, box
// select, group drag with ReEQ's inversion, alt fine, ctrl = Q lock, a cut's height = its Q, wheel = Q, ctrl+wheel =
// slope, double-click adds / toggles, alt+double-click deletes, the node menu with Split and Duplicate, drawn by
// rk_menu.jsfx-inc, which the host imports before this file), a plain strip view. Since: the listen (4b), the strip's
// dots (4c), the looks (rk_curve's Badge, 10-26), the analyser (5: rk_spectrum under the grid, its options in the
// graph menu, the piano keys, the phase curve, the listen trace; the strips show it, switchable).
// Not yet (spec §10): typed values, undo / redo, A/B, presets, hover help, bypass (7);
// dynamics (release 2).

@init

QZG_NB = 256;          // the curve's base points, log-spaced over 10 Hz .. 22050 Hz
QZG_NR = 19;           // and per drawn band with a Q, 19 where its curve turns fastest (qzg_owner)
QZG_NS = QZG_NB + 16 * QZG_NR;   // point slots: the base grid, then one block per band
QZG_FMIN = 10;
QZG_FMAX = 22050;
QZG_LF = log(2205);
QZG_NCOL = 8192;       // widest canvas the column painters cover

// the hover help's name for the control under the pointer (step 7; drawn by qzg_draw_help, defined before every user)
function qzg_hlp(str) ( strcpy(#qzg_help, str); qzg_hlp_on = 1; );
// ---- colours: 0xRRGGBB (Midnight, or the suite theme: qzg_palette) ----
function qzg_col(c, a) ( gfx_set(((c / 65536) | 0) / 255, (((c / 256) | 0) & 255) / 255, (c & 255) / 255, a); );
// band k's colour and number go through the display order (qzg_order): its slot, or its place left to right
function qzg_bcol(k) ( qzg_bc[qzg_dn[k]]; );
function qzg_bandcol(k, a) ( qzg_col(qzg_bc[qzg_dn[k]], a); );
// lerp colour a toward b by t (t may run past 0..1; each channel is clamped), as one opaque 0xRRGGBB
function qzg_lerpc(a, b, t) local(r, g, bl) (
  r = max(0, min(255, floor(((a / 65536) | 0) + (((b / 65536) | 0) - ((a / 65536) | 0)) * t + 0.5)));
  g = max(0, min(255, floor((((a / 256) | 0) & 255) + ((((b / 256) | 0) & 255) - (((a / 256) | 0) & 255)) * t + 0.5)));
  bl = max(0, min(255, floor((a & 255) + ((b & 255) - (a & 255)) * t + 0.5)));
  r * 65536 + g * 256 + bl;
);
// a suite theme slot (rk_theme: 0 BG, 1 PANEL, 2 TEXT, 3 TEXT_DIM, 4 ACCENT, 5 ACCENT2, 6 GRID, 7 BORDER) as 0xRRGGBB
function qzg_th_hex(slot) local(b) (
  b = slot * 3;
  floor(max(0, min(1, rkth_band(b))) * 255 + 0.5) * 65536 + floor(max(0, min(1, rkth_band(b + 1))) * 255 + 0.5) * 256 +
  floor(max(0, min(1, rkth_band(b + 2))) * 255 + 0.5);
);
// Quezy's other native looks (step 6; the mockup v8's CARBON / AURORA / EMBER tables), laid over Midnight's: the
// colours the mock gives each look are taken as they are; the ones Quezy tuned past the mock (chips, hovers, the
// plate's pills) keep Midnight's relation to their base; the text colours stay Midnight's (as in the mock).
// v: 1 Carbon, 2 Aurora, 3 Ember.
function qzg_native_look(v) local(win, pl, gr, gm, ze, plb, pan, drw, ln, chp, fld, ico, bc, bcs, mnu, mnl, mns, ktr, kbg, nof, acc, g0, g1, pm) (
  v == 1 ? (
    win = 0x111113; pl = 0x151517; gr = 0x1c1c20; gm = 0x2a2a30; ze = 0x37373f; plb = 0x55555e; pan = 0x1d1d21;
    drw = 0x18181b; ln = 0x2e2e34; chp = 0x1f1f24; fld = 0x0e0e10; ico = 0x18181c; bc = 0x1a1a1e; bcs = 0x27272d;
    mnu = 0x202024; mnl = 0x3c3c44; mns = 0x2b2b31; ktr = 0x2e2e34; kbg = 0x101012; nof = 0x2e2e34; acc = 0xc8ced6;
    g0 = 0x1a1a1d; g1 = 0x0e0e10;
    qzg_p_an1 = 0x7a7f8a; qzg_p_an2 = 0x6fa3c8; qzg_p_anp = 0xc8ced6;
  ) : v == 2 ? (
    win = 0x0c0a16; pl = 0x0f0c1d; gr = 0x19152d; gm = 0x262040; ze = 0x322a52; plb = 0x5a5280; pan = 0x19142b;
    drw = 0x140f24; ln = 0x2b2447; chp = 0x1c1731; fld = 0x0b0915; ico = 0x161128; bc = 0x18132a; bcs = 0x251d41;
    mnu = 0x1d1834; mnl = 0x3e3565; mns = 0x2b2449; ktr = 0x2b2447; kbg = 0x0c0a16; nof = 0x2b2447; acc = 0xc38bff;
    g0 = 0x130f27; g1 = 0x090713;
    qzg_p_an1 = 0x7d6bc4; qzg_p_an2 = 0x38d1b3; qzg_p_anp = 0xc9b8ff;
  ) : (
    win = 0x110c0a; pl = 0x15100d; gr = 0x201813; gm = 0x2e221b; ze = 0x3b2b21; plb = 0x6b5544; pan = 0x1e1611;
    drw = 0x19120e; ln = 0x34261d; chp = 0x221914; fld = 0x0e0a08; ico = 0x1b1410; bc = 0x1c1410; bcs = 0x2b2019;
    mnu = 0x231a14; mnl = 0x4b3729; mns = 0x33261d; ktr = 0x34261d; kbg = 0x110c0a; nof = 0x34261d; acc = 0xff8c32;
    g0 = 0x1b140f; g1 = 0x0d0907;
    qzg_p_an1 = 0xb07a52; qzg_p_an2 = 0xe6c27a; qzg_p_anp = 0xffd0a8;
  );
  qzg_c_win = win; qzg_c_pan = pan; qzg_c_drw = drw; qzg_c_line = ln; qzg_c_ktr = ktr;
  qzg_c_bch = bc; qzg_c_bchs = bcs; qzg_c_bchh = qzg_lerpc(bc, bcs, 0.67);
  qzg_c_chip = qzg_lerpc(chp, qzg_c_tx, 0.055); qzg_c_chiph = qzg_lerpc(chp, qzg_c_tx, 0.11);
  qzg_c_fld = fld; qzg_c_fldh = qzg_lerpc(fld, qzg_c_tx, 0.04);
  qzg_c_ico = ico; qzg_c_icoh = qzg_lerpc(ico, qzg_c_tx, 0.07); qzg_c_kbg = kbg;
  qzg_c_mnu = mnu; qzg_c_mnl = mnl; qzg_c_mns = mns;
  qzg_c_pill = qzg_lerpc(win, qzg_c_tx, 0.10); qzg_c_pillh = qzg_lerpc(win, qzg_c_tx, 0.15); qzg_c_off = plb;
  qzg_c_acc = acc; qzg_p_acc = acc;
  qzg_p_g0 = g0; qzg_p_g1 = g1; qzg_p_grid = gr; qzg_p_gmaj = gm; qzg_p_zero = ze; qzg_p_lbl = plb; qzg_p_noff = nof;
  qzg_p_inset = win; qzg_p_tag = mnu; qzg_p_strip = pl; qzg_p_dov = qzg_lerpc(win, 0x000000, 0.6);
  pm = qzg_lerpc(g0, g1, 0.5);
  qzg_p_rdo = qzg_lerpc(pm, qzg_p_tx, 0.13); qzg_p_pill = qzg_lerpc(pm, qzg_p_tx, 0.10); qzg_p_pillh = qzg_lerpc(pm, qzg_p_tx, 0.15);
  qzg_p_pkb = g1;
);
// The window's colours for this pass. NATIVE on (or no live theme): Quezy's Midnight, exactly the 4a picture. A live
// suite theme (rkth_active(): never the raw gmem test, the 3-Band's half-native bug): the CHROME follows it (the face
// below the graph, band bar, editor, fields, chips, output bar, the menu) by the rules fitted to the mock's EONC /
// DARKC / LIGHTC tables, and so does the PLATE, the graph (qzg_p_*: the user, 2026-10-20, "i want the main grid part
// to change with the theme as well", fully: a light graph under a light theme). Worked out from the theme's own slots,
// not a table per theme, so any of the house's themes works. Band colours never follow (the house rule).
// The colours from six base colours (a suite theme's slots, or a light native look): the CHROME and the PLATE by the
// rules fitted to the mock's EONC / DARKC / LIGHTC tables; a light base gets a light graph.
function qzg_pal_from(bg, pan, tx, dim, acc, bor) local(light, mchip, pm) (
  light = (((bg / 65536) | 0) * 0.2126 + (((bg / 256) | 0) & 255) * 0.7152 + (bg & 255) * 0.0722) / 255 > 0.5;
  qzg_c_win = bg; qzg_c_pan = pan; qzg_c_tx = tx; qzg_c_dim = dim; qzg_c_acc = acc;
  qzg_c_drw = qzg_lerpc(bg, pan, 0.54);
  qzg_c_line = qzg_lerpc(pan, bor, 0.75); qzg_c_ktr = qzg_c_line;
  qzg_c_bch = qzg_lerpc(bg, dim, 0.09); qzg_c_bchs = qzg_lerpc(pan, dim, 0.12);
  qzg_c_bchh = qzg_lerpc(qzg_c_bch, qzg_c_bchs, 0.67);
  mchip = qzg_lerpc(bg, pan, 1.6);
  qzg_c_chip = qzg_lerpc(mchip, tx, 0.065); qzg_c_chiph = qzg_lerpc(mchip, tx, 0.125);
  qzg_c_fld = qzg_lerpc(bg, bor, -0.21); qzg_c_fldh = qzg_lerpc(qzg_c_fld, tx, 0.05);
  qzg_c_ico = qzg_lerpc(bg, bor, 0.34); qzg_c_icoh = qzg_lerpc(qzg_c_ico, tx, 0.08);
  qzg_c_kbg = light ? qzg_lerpc(tx, bg, 0.06) : qzg_c_fld;
  qzg_c_kpt = light ? qzg_lerpc(bg, tx, 0.10) : tx;    // the knob's pointer: light on the knob's dark body
  qzg_c_mnu = light ? qzg_c_fld : pan; qzg_c_mnl = bor; qzg_c_mns = qzg_lerpc(bg, pan, 1.8);
  qzg_c_tx2 = qzg_lerpc(tx, dim, 0.47); qzg_c_fnt = qzg_lerpc(dim, pan, 0.5);
  qzg_c_pill = qzg_lerpc(bg, tx, 0.10); qzg_c_pillh = qzg_lerpc(bg, tx, 0.15);
  qzg_c_off = qzg_lerpc(qzg_c_fnt, dim, 0.37); qzg_c_lbl = qzg_lerpc(dim, tx, 0.13);
  qzg_c_gly = qzg_lerpc(dim, tx, 0.24); qzg_c_hot = qzg_lerpc(bg, tx, 1.15); qzg_c_chev = qzg_lerpc(dim, tx, 0.39);
  qzg_p_acc = acc;
  // the plate: a light theme gets a light graph (whiter at the top), a dark one a dark graph (lighter at the top, as
  // Midnight); lines and labels from BORDER and TEXT_DIM over the plate's middle, the curve and readouts in TEXT
  qzg_p_lt = light;                  // a light graph: marks in a light band colour need more weight (the dot tags, the ring)
  light ? ( qzg_p_g0 = qzg_lerpc(bg, 0xffffff, 0.45); qzg_p_g1 = qzg_lerpc(bg, pan, 0.25); )
        : ( qzg_p_g0 = qzg_lerpc(bg, pan, 0.6); qzg_p_g1 = qzg_lerpc(bg, 0x000000, 0.35); );
  pm = qzg_lerpc(qzg_p_g0, qzg_p_g1, 0.5);
  qzg_p_grid = qzg_lerpc(pm, bor, light ? 0.30 : 0.35); qzg_p_gmaj = qzg_lerpc(pm, bor, light ? 0.55 : 0.65);
  qzg_p_zero = qzg_lerpc(pm, tx, light ? 0.30 : 0.18); qzg_p_lbl = qzg_lerpc(pm, dim, light ? 0.85 : 0.6);
  qzg_p_curve = light ? tx : qzg_lerpc(tx, 0xffffff, 0.35);
  qzg_p_noff = qzg_lerpc(pm, bor, light ? 0.45 : 0.6);
  qzg_p_inset = light ? qzg_lerpc(bg, 0xffffff, 0.7) : qzg_lerpc(bg, 0x000000, 0.3);
  qzg_p_tag = light ? qzg_lerpc(bg, 0xffffff, 0.75) : pan;
  qzg_p_rdo = qzg_lerpc(pm, tx, 0.13); qzg_p_pill = qzg_lerpc(pm, tx, 0.10); qzg_p_pillh = qzg_lerpc(pm, tx, 0.15);
  qzg_p_tx = tx; qzg_p_tx2 = qzg_lerpc(tx, dim, 0.47); qzg_p_dim = dim; qzg_p_strip = pm;
  qzg_p_dov = light ? qzg_lerpc(bg, 0xffffff, 0.35) : qzg_lerpc(bg, 0x000000, 0.7); qzg_p_dova = light ? 0.70 : 0.62;
  qzg_p_crs = light ? tx : 0xffffff; qzg_p_crsa = light ? 0.25 : 0.18; qzg_p_sha = light ? 0.18 : 0.35;
  // the analyser: the main trace neutral (the 4-Band's TEXT_DIM-on-plate), the second (Side / Right) the accent, the
  // pre-EQ trace lighter, the listen trace the accent at full strength; the piano's keys from the text colours
  qzg_p_an1 = qzg_lerpc(pm, tx, 0.45); qzg_p_an2 = acc; qzg_p_anp = qzg_lerpc(pm, tx, 0.75); qzg_p_anl = acc;
  qzg_p_pkw = light ? qzg_lerpc(pm, tx, 0.12) : tx; qzg_p_pkb = light ? tx : qzg_p_g1;   // light: the whites a shade under the plate
);
function qzg_palette() (
  qzg_themed = rkth_active();
  qzg_themed ? (
    qzg_pal_from(qzg_th_hex(0), qzg_th_hex(1), qzg_th_hex(2), qzg_th_hex(3), qzg_th_hex(4), qzg_th_hex(7));
  ) : qzv_nlook == 4 ? (
    // Paper (step 6, the user: "A warm off white and a pure white"): warm off-white, the house's warm text, a deep
    // amber accent that holds up on a light plate
    qzg_pal_from(0xf3eee4, 0xe6dfd2, 0x2b2822, 0x6e675b, 0xc8691e, 0xc9c0af);
  ) : qzv_nlook == 5 ? (
    // White: pure white, cool greys, Midnight's teal darkened to read on white
    qzg_pal_from(0xffffff, 0xeef0f3, 0x1e2128, 0x6a707c, 0x12a085, 0xd3d6dc);
  ) : (
    qzg_c_win = 0x0f1218; qzg_c_pan = 0x1b202b; qzg_c_tx = 0xe6e9ee; qzg_c_dim = 0x6d7686; qzg_c_acc = 0x38D1B3;
    qzg_c_drw = 0x161b26; qzg_c_line = 0x2a3242; qzg_c_ktr = 0x2a3140;
    qzg_c_bch = 0x171c26; qzg_c_bchs = 0x232a38; qzg_c_bchh = 0x1f2532;
    qzg_c_chip = 0x252c3a; qzg_c_chiph = 0x303848; qzg_c_fld = 0x0d1016; qzg_c_fldh = 0x151a24;
    qzg_c_ico = 0x141822; qzg_c_icoh = 0x222937; qzg_c_kbg = 0x0f1218; qzg_c_kpt = 0xe6e9ee;
    qzg_c_mnu = 0x1d2330; qzg_c_mnl = 0x38415a; qzg_c_mns = 0x2c3446;
    qzg_c_tx2 = 0xb7bfcc; qzg_c_fnt = 0x3a4252; qzg_c_pill = 0x23272f; qzg_c_pillh = 0x2e333d;
    qzg_c_off = 0x4d5668; qzg_c_lbl = 0x7d8696; qzg_c_gly = 0x8a93a3; qzg_c_hot = 0xffffff; qzg_c_chev = 0x9aa3b2;
    qzg_p_acc = 0x38D1B3;
    qzg_p_g0 = 0x151b28; qzg_p_g1 = 0x0d1017; qzg_p_grid = 0x191f2a; qzg_p_gmaj = 0x252d3c; qzg_p_zero = 0x2e3748;
    qzg_p_lbl = 0x4d5668; qzg_p_curve = 0xf3f5f9; qzg_p_noff = 0x2a303c; qzg_p_inset = 0x0f1218; qzg_p_tag = 0x1d2330;
    qzg_p_rdo = 0x2a2e37; qzg_p_pill = 0x23272f; qzg_p_pillh = 0x2e333d; qzg_p_tx = 0xe6e9ee; qzg_p_tx2 = 0xb7bfcc;
    qzg_p_dim = 0x6d7686; qzg_p_strip = 0x121620; qzg_p_dov = 0x06080c; qzg_p_dova = 0.62;
    qzg_p_crs = 0xffffff; qzg_p_crsa = 0.18; qzg_p_sha = 0.35; qzg_p_lt = 0;
    qzg_p_an1 = 0x4f8aa6; qzg_p_an2 = 0x9b7fe0; qzg_p_anp = 0x8fd8ff; qzg_p_anl = 0xf0654c;   // the listen trace: ReEQ's orange
    qzg_p_pkw = 0xe6e9ee; qzg_p_pkb = 0x0d1017;
    qzv_nlook >= 1 && qzv_nlook <= 3 ? qzg_native_look(qzv_nlook | 0);   // Carbon, Aurora, Ember over Midnight
  );
  qzg_p_pm = qzg_lerpc(qzg_p_g0, qzg_p_g1, 0.5);   // the plate's middle (a Bypassed band's line mixes toward it)
);
// c1 over c2 at t, as one opaque colour (the rounded-rect helpers take opaque colours only)
function qzg_mix(c1, c2, t) (
  floor(((c1 / 65536) | 0) * t + ((c2 / 65536) | 0) * (1 - t) + 0.5) * 65536 +
  floor((((c1 / 256) | 0) & 255) * t + (((c2 / 256) | 0) & 255) * (1 - t) + 0.5) * 256 +
  floor((c1 & 255) * t + (c2 & 255) * (1 - t) + 0.5);
);

// ---- memory: the host hands over its next free word and gets the next one back ----
function qzg_setup(base) local(j)
(
  qzg_bc = base;                    // 16 band colours, fixed per slot (the mock's list)
  qzg_bc[0] = 0xEB4D4D; qzg_bc[1] = 0xF5992E; qzg_bc[2] = 0xE8C547; qzg_bc[3] = 0x61DB5C;
  qzg_bc[4] = 0x38D1B3; qzg_bc[5] = 0x4DA8F5; qzg_bc[6] = 0x7C83F7; qzg_bc[7] = 0xAD70F5;
  qzg_bc[8] = 0xE46FBE; qzg_bc[9] = 0xF07A5A; qzg_bc[10] = 0xA8D85A; qzg_bc[11] = 0x5AD0E6;
  qzg_bc[12] = 0x9AA3FF; qzg_bc[13] = 0xD58CF0; qzg_bc[14] = 0xF2A65A; qzg_bc[15] = 0x7ED3A0;
  // the curve (qzg_curves): what is evaluated, in slot order (the base grid, then band b's block at QZG_NB + QZG_NR b) ...
  qzg_fs = base + 16;               // QZG_NS slot frequencies
  qzg_ev = qzg_fs + QZG_NS;         // 16 rows of QZG_NS dB values
  qzg_rv = qzg_ev + 16 * QZG_NS;    // 16 x 16 stamps: row k's values at band b's block are from that block's generation
  qzg_oa = qzg_rv + 256;            // per band: its block is lit, the block's generation, its key (centre, half-width,
  qzg_og = qzg_oa + 16;             // a shelf's resonance offset)
  qzg_ok1 = qzg_og + 16;
  qzg_ok2 = qzg_ok1 + 16;
  qzg_ok3 = qzg_ok2 + 16;
  qzg_ok4 = qzg_ok3 + 16;
  qzg_cvon = qzg_ok4 + 16;          // per band: its drawn row was gathered (it was On when the views were last built)
  qzg_ssum = qzg_cvon + 16;         // the summed row in slot order
  qzg_mp = qzg_ssum + QZG_NS;       // merge scratch: each run's next point (17: the base grid last)
  // ... and what is drawn, in frequency order (qzg_np points; qzg_merge)
  qzg_ord = qzg_mp + 17;            // sorted position -> slot
  qzg_fq = qzg_ord + QZG_NS;        // point frequencies
  qzg_cv = qzg_fq + QZG_NS;         // 16 rows of dB values (the drawn bands' rows only)
  qzg_sum = qzg_cv + 16 * QZG_NS;   // the summed row
  qzg_px = qzg_sum + QZG_NS;        // each point's x this pass (qzg_xmap)
  qzg_cj = qzg_px + QZG_NS;         // per column edge: the first point at or right of it, and the edge's place between
  qzg_ct = qzg_cj + QZG_NCOL + 2;   // that point and the one before (qzg_xmap)
  qzg_kx = qzg_ct + QZG_NCOL + 2;   // a polyline's kept vertices, x and y (qzg_poly)
  qzg_ky = qzg_kx + QZG_NS;
  qzg_dty = qzg_ky + QZG_NS;        // 16 row-dirty flags
  qzg_sel = qzg_dty + 16;           // 16 selection flags
  qzg_af = qzg_sel + 16;            // drag anchors: freq, gain, Q, inverted
  qzg_ag = qzg_af + 16;
  qzg_aq = qzg_ag + 16;
  qzg_ai = qzg_aq + 16;
  qzg_bsel = qzg_ai + 16;           // scratch flags: the selection when a box select started; menu targets
  qzg_cy = qzg_bsel + 16;           // the summed curve's y per pixel column (QZG_NCOL + 1)
  qzg_srfm = qzg_cy + QZG_NCOL + 1; // per surface (0 window, 1 / 2 the strips, rk_srf's _srf): 4 words each
  qzg_fkey = qzg_srfm + 12;         // font slots 1..12: size * 2 + bold held there (0 = empty)
  qzg_hv = qzg_fkey + 13;           // 16 dot hover ramps 0..1
  qzg_dn = qzg_hv + 16;             // the display order: slot -> number - 1 (qzg_order)
  qzg_ds = qzg_dn + 16;             // and back: number - 1 -> slot
  qzg_ebt = qzg_ds + 16;            // the strip's OPEN bar fade, per surface (rk_srf's _srf 0..2)
  qzg_ebd = qzg_ebt + 3;            // and the fade last drawn there
  qzg_pss = qzg_ebd + 3;            // per placement (Mid, Side, Left, Right): its On bands summed, in slot order ...
  qzg_pt = qzg_pss + 4 * QZG_NS;    // ... and in drawn order (qzg_curves; ReEQ's group curves)
  qzg_pon = qzg_pt + 4 * QZG_NS;    // 4 flags: that placement has an On band (its total is drawn)
  qzg_dpat = qzg_pon + 4;           // per placement 0..4, 8 words: the line pattern (qzg_dash_poly)
  j = 0;
  loop(QZG_NB, qzg_fs[j] = QZG_FMIN * exp(QZG_LF * j / (QZG_NB - 1)); j += 1; );
  j = 0; loop(4, qzg_pon[j] = 0; j += 1; );
  // the patterns: a count, then where each piece ends along one period (times the scale), on and off in turn from on.
  // Stereo's is never drawn (its bands are fills); Mid long dashes, Side dots, Left dash-dot, Right dash-dot-dot.
  j = qzg_dpat;      j[0] = 2; j[1] = 6;  j[2] = 10;
  j = qzg_dpat + 8;  j[0] = 2; j[1] = 12; j[2] = 17;
  j = qzg_dpat + 16; j[0] = 2; j[1] = 2;  j[2] = 6;
  j = qzg_dpat + 24; j[0] = 4; j[1] = 9;  j[2] = 12; j[3] = 14; j[4] = 17;
  j = qzg_dpat + 32; j[0] = 6; j[1] = 9;  j[2] = 12; j[3] = 14; j[4] = 17; j[5] = 19; j[6] = 22;
  j = 0; loop(16, qzg_oa[j] = 0; qzg_og[j] = 0; qzg_cvon[j] = 0; j += 1; );   // no block lit, no row gathered yet
  j = 0; loop(256, qzg_rv[j] = -1; j += 1; );
  j = 0;
  loop(16, qzg_dty[j] = 1; qzg_sel[j] = 0; qzg_hv[j] = 0; qzg_dn[j] = j; qzg_ds[j] = j; j += 1; );
  j = 0; loop(25, qzg_srfm[j] = 0; j += 1; );
  j = 0; loop(3, qzg_ebt[j] = 0; qzg_ebd[j] = 0; j += 1; );
  qzg_phs = qzg_dpat + 40;          // the phase curve: the summed phase at the QZG_NB base points, radians (qzg_phase_curve)
  qzg_phs + QZG_NB;
);
// the window's own seeds, set on its first frame (never from @init: a name both sides write is a race candidate)
function qzg_once() (
  !qzg_ready ? ( qzg_prim = -1; qzg_drag = -1; qzg_sum_sig = -1; qzg_lsn = -1; qzg_lw = 0.10; qzg_ed = -1; qzg_ehv = -1;
                 qzg_ready = 1; );
);

// ---- slider access: band k (0..15), control c (0..12) ----
function qzg_n(k, c) ( 1 + 13 * k + c; );
function qzg_v(k, c) ( slider(1 + 13 * k + c); );
// ---- undo / redo and A / B (step 7, batch 2; spec §8: "a snapshot history of all band and output values, in memory,
//      buttons in the top bar"; E5: "two whole settings to flip between ... second set in @serialize") ----
// A snapshot is sliders 1..218 (the bands and the output section; never the link group or the theme rows). The host
// allocates qzg_hist (QZG_HN snapshots) and qz_abm (the other A / B slot, then a scratch copy) in @init. Every face edit
// goes through qzg_set, which marks the history dirty (qzg_hmark); a dirty history takes its next snapshot once the
// edit is over (no button held, no drag, 0.35 s after the last change: a wheel spin or a knob drag is one step). The
// first mark of an edit first brings the current snapshot up to what is live, so changes made elsewhere since
// (automation, the link group, a preset) are not undone with it. A restore writes every control but Mode, then the
// Modes (a band never plays the slot's old settings for a block), without marking.
QZG_HN = 48;
// cell i (0..218) of a snapshot is slider i + 1 for the bands and the output section, and the input trim (222) last
// (2026-10-31: QZ_SN = 219 cells, set by the host)
// (2026-11-04: QZ_SN = 284; cell 219 the lookahead (223), cells 220..283 the dynamics extras qz_dyp[0..63])
function qzg_sn_get(i) ( i < 218 ? slider(i + 1) : i == 218 ? slider(222) : i == 219 ? slider(223) : qz_dyp[i - 220]; );
function qzg_hist_snap(dst) local(i) ( i = 0; loop(QZ_SN, dst[i] = qzg_sn_get(i); i += 1; ); );
function qzg_hist_same(src) local(i, d) ( d = 1; i = 0; loop(QZ_SN, qzg_sn_get(i) !== src[i] ? d = 0; i += 1; ); d; );
function qzg_hmark() (
  !qzg_hdirty ? (
    qzg_htop > 0 && !qzg_hist_same(qzg_hist + qzg_hcur * QZ_SN) ? qzg_hist_snap(qzg_hist + qzg_hcur * QZ_SN);
    qzg_hdirty = 1;
  );
  qzg_hdt = time_precise();
);
function qzg_set(n, v) ( v !== slider(n) ? ( (n <= 218 || n == 222 || n == 223) && !qzg_hrest ? qzg_hmark(); slider(n) = v; slider_automate(slider(n)); ); );
// (the Codex review, 2026-10-30: writing the settings first let a band still On under its old Mode play a disabled
// band's stored settings for a block, e.g. a +30 dB bell kept in an Off slot of B.) So: first every band whose Mode
// goes down (On -> Bypassed / Off, Bypassed -> Off) takes its new Mode, then the settings, then the Modes that go up.
function qzg_restore(src) local(i, d) (
  qzg_hrest = 1;
  i = 1; loop(16, src[i - 1] < slider(i) ? qzg_set(i, src[i - 1]); i += 13; );
  i = 1; loop(218, !(i <= 208 && (i - 1) % 13 == 0) ? qzg_set(i, src[i - 1]); i += 1; );
  qzg_set(222, src[218]);
  qzg_set(223, src[219]);
  d = 0; i = 0; loop(64, qz_dyp[i] !== src[220 + i] ? d = 1; i += 1; );
  d ? ( memcpy(qz_dyp, src + 220, 64);   // the extras, and REAPER told (as qzg_dyp_set)
    qz_dydirty = (qz_dydirty + 1) % 1000000; slider_automate(qz_dydirty); );
  i = 1; loop(16, qzg_set(i, src[i - 1]); i += 13; );
  qzg_hrest = 0;
);
function qzg_hist_push() local(cur) (
  qzg_hdirty = 0;
  cur = qzg_hist + qzg_hcur * QZ_SN;
  !qzg_hist_same(cur) ? (
    qzg_htop = qzg_hcur + 1;           // a new edit drops the redo steps
    qzg_htop >= QZG_HN ? ( memcpy(qzg_hist, qzg_hist + QZ_SN, QZ_SN * (QZG_HN - 1)); qzg_htop = QZG_HN - 1; );
    qzg_hist_snap(qzg_hist + qzg_htop * QZ_SN);
    qzg_hcur = qzg_htop; qzg_htop += 1;
  );
);
// every pass, window or strip: the first snapshot, then an edit's snapshot once it is over
function qzg_hist_tick() (
  qzg_htop < 1 ? ( qzg_hist_snap(qzg_hist); qzg_hcur = 0; qzg_htop = 1; qzg_hdirty = 0; ) :
  qzg_hdirty && !LMB && !RMB && qzg_drag < 0 && !qzg_fdrag && !qzg_kdrag && qzg_ed < 0 && qzg_skd < 0 && !qzg_sdd && time_precise() - qzg_hdt > 0.35 ?
    qzg_hist_push();
);
function qzg_can_undo() ( qzg_hdirty || qzg_hcur > 0; );
function qzg_can_redo() ( !qzg_hdirty && qzg_hcur < qzg_htop - 1; );
function qzg_undo() (
  qzg_hdirty ? qzg_hist_push();        // an edit not yet taken in: take it, then step back over it
  qzg_hcur > 0 ? ( qzg_hcur -= 1; qzg_restore(qzg_hist + qzg_hcur * QZ_SN); );
);
function qzg_redo() ( qzg_can_redo() ? ( qzg_hcur += 1; qzg_restore(qzg_hist + qzg_hcur * QZ_SN); ); );
// A / B: the live controls are the slot shown (qzv_ab: 0 A, 1 B); qz_abm holds the other. A first switch copies the live
// settings into the other slot, so both start the same. A switch starts a fresh history (each slot its own story).
function qzg_ab_switch(to) (
  to != (qzv_ab | 0) ? (
    qzg_hdirty ? qzg_hist_push();
    !qzv_abset ? qzg_hist_snap(qz_abm);
    !qzv_abx ? ( qz_abm[219] = slider(223); memcpy(qz_abm + 220, qz_dyp, 64); qzv_abx = 1; );   // an older save's B
    qzg_hist_snap(qz_abm + QZ_SN);     // the live slot, kept aside
    qzg_restore(qz_abm);
    memcpy(qz_abm, qz_abm + QZ_SN, QZ_SN);
    qzv_ab = to; qzv_abset = 1;
    qzg_htop = 0;                      // the next pass snapshots the slot it now shows
  );
);
function qzg_ab_copy() ( qzg_hist_snap(qz_abm); qzv_abset = 1; qzv_abx = 1; );   // the live settings into the other slot
// round to a step, landing on the same double the slider's own text would parse to (7071 / 10000, not 7071 * 0.0001)
function qzg_round(v, st) local(inv) ( inv = floor(1 / st + 0.5); floor(v * inv + 0.5) / inv; );
function qzg_setf(k, f) ( qzg_set(qzg_n(k, 3), qzg_round(max(10, min(22050, f)), 0.01)); );
function qzg_setg(k, g) ( qzg_set(qzg_n(k, 4), qzg_round(max(-30, min(30, g)), 0.01)); );
function qzg_setq(k, q) ( qzg_set(qzg_n(k, 5), qzg_round(max(0.1, min(40, q)), 0.0001)); );
function qzg_setsl(k, sl) ( qzg_set(qzg_n(k, 6), max(0, min(19, sl | 0))); );
function qzg_mode(k) ( max(0, min(4, qzg_v(k, 0) | 0)); );
function qzg_shape(k) ( max(0, min(16, qzg_v(k, 2) | 0)); );
function qzg_place(k) ( max(0, min(4, qzg_v(k, 1) | 0)); );
function qzg_slope(k) ( max(0, min(19, qzg_v(k, 6) | 0)); );
function qzg_on(k) ( qzg_mode(k) >= 2; );
function qzg_live(k) ( qzg_mode(k) >= 1; );         // a band that exists (On or Bypassed)
// The look a surface asks for (view state, @serialize gate 4), clamped: rk_curve's numbers, bands 0 Fill / 1 Lines /
// 2 Both, nodes 0 Ring / 1 Dot / 2 Badge
function qzg_look(v) ( max(0, min(2, v | 0)); );

// ---- shape facts (slider order; 0..13 = ReEQ's ids) ----
function qzg_is_cut(sh) ( sh == 1 || sh == 2 || sh == 5 || sh == 6 || sh == 12 || sh == 13; );
function qzg_res_cut(sh) ( sh == 1 || sh == 5; );
function qzg_has_slope(sh) ( sh == 1 || sh == 2 || sh == 5 || sh == 6; );
function qzg_has_gain(sh) ( sh == 0 || sh == 3 || sh == 4 || sh == 9 || sh == 10 || sh == 12 || sh == 13 || sh >= 14; );
function qzg_has_q(sh) ( sh == 0 || sh == 1 || sh == 3 || sh == 4 || sh == 5 || sh == 7 || sh == 8 || sh == 9 || sh == 10 ||
                         sh == 11 || sh == 14; );
// (the user, 2026-10-21, "yes both": "Butterworth" spelled out, "BW" read as bandwidth; the analog cuts under ReEQ's
// own visible names, ReEQ 806 / 811 / 4381 / 4386, "Low Cut Analog" being its hidden slider list's)
function qzg_shape_name(sh) (
  sh == 0 ? "Peak" : sh == 1 ? "Low Cut" : sh == 2 ? "Low Cut Butterworth" : sh == 3 ? "Low Shelf" : sh == 4 ? "High Shelf" :
  sh == 5 ? "High Cut" : sh == 6 ? "High Cut Butterworth" : sh == 7 ? "Notch" : sh == 8 ? "Band Pass" : sh == 9 ? "Tilt Shelf" :
  sh == 10 ? "Pultec" : sh == 11 ? "All Pass" : sh == 12 ? "Low Channel (Analog)" : sh == 13 ? "High Channel (Analog)" :
  sh == 14 ? "Bell Prop Q" : sh == 15 ? "Flat Tilt" : "Flat Gain";
);
// a shape's own icon, its type (the editor's picker, which icon is lit, the bell test): 0 bell 1 low cut 2 high cut
// 3 low shelf 4 high shelf 5 notch 6 band pass 7 tilt 8 pultec 9 all pass 10 flat tilt 11 flat gain (12, a low cut
// with a hump, is drawn only: qzg_icon_of)
function qzg_glyph_of(sh) (
  sh == 0 || sh == 14 ? 0 : sh == 1 || sh == 2 || sh == 12 ? 1 : sh == 5 || sh == 6 || sh == 13 ? 2 : sh == 3 ? 3 :
  sh == 4 ? 4 : sh == 7 ? 5 : sh == 8 ? 6 : sh == 9 ? 7 : sh == 10 ? 8 : sh == 11 ? 9 : sh == 15 ? 10 : 11;
);
// The icon a band shows at gain g (its chip, the node menu's rows): what it plays, the user, 2026-10-21: "make sure they
// actually match what's there" (an icon code: 0..12, + 13 drawn upside down). A gain shape cutting is its icon upside
// down (each one's curve at -g is its curve at +g mirrored); a Pultec below 0 dB is a plain low shelf cut (its dip
// grows from 0 dB only with a boost, rk_svf 731-737); the analog channels above 0 dB boost: the high one is a shelf,
// the low one a cut with a hump under it, once the hump is worth drawing (rk_svf 755-771, qz_engine 186-198: its bump
// is +1.2 dB at +6, +3.5 at +9, +5.9 at +12). Gain 0 shows the type upright.
function qzg_gain_icon(gl) ( gl == 0 || gl == 3 || gl == 4 || gl == 7 || gl == 10 || gl == 11; );
function qzg_icon_of(sh, g) (
  sh == 10 && g < 0 ? 3 + 13 : sh == 12 && g >= 9 ? 12 : sh == 13 && g > 0 ? 4 :
  qzg_glyph_of(sh) + (qzg_gain_icon(qzg_glyph_of(sh)) && g < 0 ? 13 : 0);
);
// the gain band k plays: its slider times Scale (qz_band_apply's), for its dot and its icons (the review: the raw
// slider showed a boost at Scale 0 % and put the low channel's hump at the wrong gains away from 100 %)
function qzg_geff(k) ( qzg_v(k, 4) * qz_scale / 100; );
// ReEQ's 10-step slope list (6, 12, 18, 24, 30, 36, 48, 72, 96, 120 dB/oct) for the menu and ctrl+wheel
function qzg_sl10(j) ( j <= 5 ? j : j == 6 ? 7 : j == 7 ? 11 : j == 8 ? 15 : 19; );
function qzg_sl10_step(sl, d) local(j, best) (       // the list's next entry above / below slope index sl
  best = 0; j = 0;
  loop(10, qzg_sl10(j) <= sl ? best = j; j += 1; );
  d > 0 ? best += 1 : qzg_sl10(best) == sl ? best -= 1;
  qzg_sl10(max(0, min(9, best)));
);

// ---- text and shapes ----
// Fonts: each size + weight keeps its own slot, created once and then only selected (wiki 4.3: re-sizing one slot
// costs ~0.2 ms a call, and a frame asks for ~20 fonts). Slots 2..10 are this cache's; slot 1 is every library's
// scratch slot (rk_theme sets it per call), 11 is rk_menu's, 16 rk_vu's. Arial, bold for labels, regular for values.
function qzg_font(px, bold) local(sz, key, k, f) (
  sz = max(8, (px * max(1, qzg_txk)) | 0);   // qzg_txk: the window's TEXT size (1, 1.15, 1.3; the strips 1)
  key = sz * 2 + (bold ? 1 : 0);
  f = 0; k = 2;
  loop(9, f == 0 && qzg_fkey[k] == key ? f = k; k += 1; );
  f ? gfx_setfont(f) : (
    qzg_fnext = qzg_fnext < 2 || qzg_fnext >= 10 ? 2 : qzg_fnext + 1; qzg_fkey[qzg_fnext] = key;
    gfx_setfont(qzg_fnext, "Arial", sz, bold ? 'b' : 0);
  );
);
function qzg_text(s, x, y) ( gfx_x = x; gfx_y = y; gfx_drawstr(s); );
function qzg_text_c(s, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(s, 1 | 4, x + w, y + h); );
function qzg_text_r(s, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(s, 2 | 4, x + w, y + h); );
function qzg_text_l(s, x, y, w, h) ( gfx_x = x; gfx_y = y; gfx_drawstr(s, 4, x + w, y + h); );
function qzg_tw(s) local(w, h) ( w = h = 0; gfx_measurestr(s, w, h); w; );
function qzg_chip_w(lbl) ( qzg_font(11 * qzg_s, 1); qzg_tw(lbl) + 12 * qzg_s; );   // a chip's width for its label
// Filled rounded rect on whole pixels (opaque colours only: the corner discs overlap the rects). A disc of radius
// r - 0.5 centred at x + r - 0.5 covers exactly the 2r pixels x .. x + 2r - 1, so the corners meet the sides (a disc of
// radius r stood a pixel proud: "ears" on every pill).
function qzg_frr(x, y, w, h, r) (
  x = floor(x + 0.5); y = floor(y + 0.5); w = floor(w + 0.5); h = floor(h + 0.5);
  r = floor(max(0, min(r, min(w, h) / 2)));
  r < 1 ? gfx_rect(x, y, w, h) : (
    gfx_rect(x + r, y, w - 2 * r, h);
    gfx_rect(x, y + r, r, h - 2 * r);
    gfx_rect(x + w - r, y + r, r, h - 2 * r);
    gfx_circle(x + r - 0.5, y + r - 0.5, r - 0.5, 1, 1);
    gfx_circle(x + w - r - 0.5, y + r - 0.5, r - 0.5, 1, 1);
    gfx_circle(x + r - 0.5, y + h - r - 0.5, r - 0.5, 1, 1);
    gfx_circle(x + w - r - 0.5, y + h - r - 0.5, r - 0.5, 1, 1);
  );
);
function qzg_pill(x, y, w, h) ( qzg_frr(x, y, w, h, h / 2); );
// Lines grow with the window too (the user, 2026-10-21: "ensure everything scales in the plugin that should scale"):
// every outline, ring and icon stroke was a fixed pixel, so they thinned while the rest grew. Set per pass from the
// scale (qzg_window, qzg_embed): qzg_bw = one design pixel, rounded (outlines, rings, icon strokes); qzg_hl = a hairline,
// one pixel until the scale doubles (the grid, the crosshair, the box select, separators). At 100 % both are 1, so the
// design-size picture is unchanged.
// an outlined rounded box: the outline colour (alpha la) as the whole box, the fill qzg_bw inside it (gfx_roundrect
// rounds its radius to a whole number and never meets the fill, wiki 4.10)
function qzg_obox(x, y, w, h, r, fillc, linec, la) (
  qzg_col(linec, la); qzg_frr(x, y, w, h, r);
  qzg_col(fillc, 1); qzg_frr(x + qzg_bw, y + qzg_bw, w - 2 * qzg_bw, h - 2 * qzg_bw, max(0, r - qzg_bw));
);
// hairlines on whole pixels, qzg_hl wide, centred on the pixel column / row the 1 px line used
function qzg_vline(x, y0, y1) ( gfx_rect(floor(x) - floor((qzg_hl - 1) / 2), y0, qzg_hl, y1 - y0); );
function qzg_hline(x0, x1, y) ( gfx_rect(x0, floor(y) - floor((qzg_hl - 1) / 2), x1 - x0, qzg_hl); );
// a rectangle's outline, qzg_hl wide, inside the rect (gfx_rect's own outline mode is 1 px)
function qzg_orect(x, y, w, h) local(l) (
  x = floor(x); y = floor(y); w = floor(w); h = floor(h); l = qzg_hl;
  l <= 1 || w <= 2 * l || h <= 2 * l ? gfx_rect(x, y, w, h, 0) : (
    gfx_rect(x, y, w, l); gfx_rect(x, y + h - l, w, l); gfx_rect(x, y + l, l, h - 2 * l); gfx_rect(x + w - l, y + l, l, h - 2 * l);
  );
);
// A smoothed arc (or ring) stroke wd px wide around radius rc: 1 px arcs from its outer edge to its inner one, at most
// 0.7 px apart (spaced wider, they stripe). The step lands the old fixed pairs at 100 % exactly (the knob's three arcs
// 0.7 apart, the icons' two 0.5 apart). Opaque colours only: the arcs overlap.
function qzg_arcw(x, y, rc, a0, a1, wd) local(n, st, t) (
  n = max(1, ceil((wd - 1) / 0.7 - 0.0001) + 1); st = n > 1 ? (wd - 1) / (n - 1) : 0;
  t = 0; loop(n, gfx_arc(x, y, rc + (wd - 1) / 2 - t * st, a0, a1, 1); t += 1; );
);
function qzg_ringw(x, y, rc, wd) local(n, st, t) (
  n = max(1, ceil((wd - 1) / 0.7 - 0.0001) + 1); st = n > 1 ? (wd - 1) / (n - 1) : 0;
  t = 0; loop(n, gfx_circle(x, y, rc + (wd - 1) / 2 - t * st, 0, 1); t += 1; );
);
function qzg_in(px, py, x, y, w, h) ( px >= x && px < x + w && py >= y && py < y + h; );
// a thick segment as a quad (only for opaque strokes that need no smoothing)
function qzg_tline(x1, y1, x2, y2, wd) local(dx, dy, l, nx, ny) (
  dx = x2 - x1; dy = y2 - y1; l = sqrt(dx * dx + dy * dy);
  l > 0.01 ? (
    nx = -dy / l * wd * 0.5; ny = dx / l * wd * 0.5;
    gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
  );
);
// A smoothed stroke wd px wide, the same width at any slope: two anti-aliased 1 px lines offset along the segment's
// normal for its edges and, from 2 px, a solid quad between them (three spaced lines striped once a scaled window made
// them more than a pixel apart). Opaque colours only: the core and the edges overlap.
function qzg_aline(x1, y1, x2, y2, wd) local(dx, dy, l, nx, ny, o) (
  dx = x2 - x1; dy = y2 - y1; l = sqrt(dx * dx + dy * dy);
  l > 0.01 ? (
    nx = -dy / l; ny = dx / l;
    wd < 1.25 ? gfx_line(x1, y1, x2, y2, 1) : (
      o = (wd - 1) * 0.5;
      wd >= 2 ? gfx_triangle(x1 + nx * o, y1 + ny * o, x2 + nx * o, y2 + ny * o, x2 - nx * o, y2 - ny * o, x1 - nx * o, y1 - ny * o);
      gfx_line(x1 + nx * o, y1 + ny * o, x2 + nx * o, y2 + ny * o, 1);
      gfx_line(x1 - nx * o, y1 - ny * o, x2 - nx * o, y2 - ny * o, 1);
    );
  );
);
function qzg_arrow(cx, cy, sz, up) (      // a small smoothed chevron (the fold arrows, the steppers use qzg_chev)
  up ? ( qzg_aline(cx - sz, cy + sz * 0.45, cx, cy - sz * 0.45, 1.6 * qzg_s); qzg_aline(cx, cy - sz * 0.45, cx + sz, cy + sz * 0.45, 1.6 * qzg_s); )
     : ( qzg_aline(cx - sz, cy - sz * 0.45, cx, cy + sz * 0.45, 1.6 * qzg_s); qzg_aline(cx, cy + sz * 0.45, cx + sz, cy - sz * 0.45, 1.6 * qzg_s); );
);
function qzg_chev(cx, cy, sz, right) (    // a sideways chevron (the steppers' < >)
  right ? ( qzg_aline(cx - sz * 0.45, cy - sz, cx + sz * 0.45, cy, 1.5 * qzg_s); qzg_aline(cx + sz * 0.45, cy, cx - sz * 0.45, cy + sz, 1.5 * qzg_s); )
        : ( qzg_aline(cx + sz * 0.45, cy - sz, cx - sz * 0.45, cy, 1.5 * qzg_s); qzg_aline(cx - sz * 0.45, cy, cx + sz * 0.45, cy + sz, 1.5 * qzg_s); );
);

// ---- numbers as text (the mock's fq / fs / note / Q formats) ----
function qzg_ftxt(s, f) (
  f < 1000 ? sprintf(s, "%d Hz", f + 0.5) : f < 10000 ? sprintf(s, "%.2f kHz", f / 1000) : sprintf(s, "%.1f kHz", f / 1000);
);
function qzg_fs(s, f) (   // switching where the rounding does (the review): never "1000" or "10.0k", so "8.8k" is the widest
  f < 999.5 ? sprintf(s, "%d", f + 0.5) : f < 9950 ? sprintf(s, "%.1fk", f / 1000) : sprintf(s, "%dk", f / 1000 + 0.5);
);
// the nearest note and how far off it the frequency is, in cents, as ReEQ's readout (2484-2522): "A4 +00", "C#3 -07";
// octaves from C0 = 16.35 Hz (A4 = 440); the cents rounded (ReEQ floors them, so an exact note on the 0.01 Hz grid,
// 523.25 Hz, reads "C5 -01" there)
function qzg_note(s, f) local(x, n, c, pc, oct) (
  x = 69 + 12 * log(max(f, 1) / 440) / log(2);
  n = floor(x + 0.5); c = floor(100 * (x - n) + 0.5);
  oct = floor(n / 12) - 1; pc = n - floor(n / 12) * 12;
  sprintf(s, "%s%d %s%02d", pc == 0 ? "C" : pc == 1 ? "C#" : pc == 2 ? "D" : pc == 3 ? "D#" : pc == 4 ? "E" : pc == 5 ? "F" :
          pc == 6 ? "F#" : pc == 7 ? "G" : pc == 8 ? "G#" : pc == 9 ? "A" : pc == 10 ? "A#" : "B", oct, c < 0 ? "-" : "+", abs(c));
);
function qzg_axis(s, f) ( f >= 1000 ? sprintf(s, "%dk", f / 1000) : sprintf(s, "%d", f); );
function qzg_qtxt(s, q) ( q < 10 ? sprintf(s, "%.2f", q) : sprintf(s, "%.1f", q); );
function qzg_dbtxt(s, d) ( d <= -135.99 ? strcpy(s, "-inf") : sprintf(s, "%+.1f dB", d); );

// ---- the display bank: retarget from the sliders, snap, mark rows dirty ----
// a row is dirty when its band retargeted (rgen moved: a matched 6 dB cut sets only its one-pole, so the main stage's
// iter_t alone missed it, step 1b's review) or a glide is still open
function qzg_snap(k) instance(filter, rgen, dgen) (
  filter.iter_t < 1 || rgen !== dgen ? ( filter.rk_svf_set_to_target(); dgen = rgen; qzg_dty[k] = 1; );
);
// row k's dB at slots s0 .. s0 + n - 1 (-180 at a zero)
function qzg_row(k, s0, n) instance(filter, run_sr) local(s, row, m) (
  row = qzg_ev + k * QZG_NS; s = s0;
  loop(n,
    m = filter.rk_svfm_magnitude(qzg_fs[s], run_sr);   // exact for any coefficients, the one-pole included
    row[s] = m > 0.000000001 ? 20 * log10(m) : -180;
    s += 1;
  );
);
// The phase (spec §8, the user: "Yes and add phase curve"): one stage's, from the same complex response
// rk_svfm_mag1 takes the magnitude of (rk_svf_phase is one stage at the plugin-wide rate); the whole cascade's at freq
// as rk_svfm_magnitude runs it, the one-pole's DF1 response (B0 + B1 z^-1) / (1 + A1 z^-1) included; radians
function qzg_ph1(c1, s1, c2, s2)
  instance(g, k, m0, m1, m2)
  local(gsq, gm1, gk, p, nr, ni, dr, di, n2, x, y)
(
  gsq = g * g; gm1 = g * m1; gk = g * k; p = gsq - gk + 1;
  nr = gsq * m2 * (c2 + 2 * c1 + 1) - gm1 * (c2 - 1);
  ni = gsq * m2 * (s2 + 2 * s1) - gm1 * s2;
  dr = gsq + gk + c2 * p + c1 * (2 * gsq - 2) + 1;
  di = s2 * p + s1 * (2 * gsq - 2);
  n2 = dr * dr + di * di;
  x = m0 + (nr * dr + ni * di) / n2;
  y = (ni * dr - nr * di) / n2;
  atan2(y, x);
);
function qzg_phase_f(freq, fs)
  instance(nlp, onepole, op0, cas1, cas2, cas3, cas4, cas5, cas6, cas7, cas8, cas9)
  local(w, c1, s1, c2, s2, ph)
(
  w = 2 * $pi * freq / fs; c1 = cos(w); s1 = sin(w); c2 = cos(2 * w); s2 = sin(2 * w);
  ph = 0;
  nlp > 0 ? ph += this.qzg_ph1(c1, s1, c2, s2);
  nlp > 2 ? ph += cas1.qzg_ph1(c1, s1, c2, s2);
  nlp > 4 ? ph += cas2.qzg_ph1(c1, s1, c2, s2);
  nlp > 6 ? ph += cas3.qzg_ph1(c1, s1, c2, s2);
  nlp > 8 ? ph += cas4.qzg_ph1(c1, s1, c2, s2);
  nlp > 10 ? ph += cas5.qzg_ph1(c1, s1, c2, s2);
  nlp > 12 ? ph += cas6.qzg_ph1(c1, s1, c2, s2);
  nlp > 14 ? ph += cas7.qzg_ph1(c1, s1, c2, s2);
  nlp > 16 ? ph += cas8.qzg_ph1(c1, s1, c2, s2);
  nlp > 18 ? ph += cas9.qzg_ph1(c1, s1, c2, s2);
  onepole ? ph += atan2(-op0.B1 * s1, op0.B0 + op0.B1 * c1) - atan2(-op0.A1 * s1, 1 + op0.A1 * c1);
  ph;
);
function qzg_bphase(f) instance(filter, run_sr) ( filter.qzg_phase_f(f, run_sr); );
function qzg_phase_k(k, f) (
  k == 0 ? qzg_b1.qzg_bphase(f) : k == 1 ? qzg_b2.qzg_bphase(f) : k == 2 ? qzg_b3.qzg_bphase(f) : k == 3 ? qzg_b4.qzg_bphase(f) :
  k == 4 ? qzg_b5.qzg_bphase(f) : k == 5 ? qzg_b6.qzg_bphase(f) : k == 6 ? qzg_b7.qzg_bphase(f) : k == 7 ? qzg_b8.qzg_bphase(f) :
  k == 8 ? qzg_b9.qzg_bphase(f) : k == 9 ? qzg_b10.qzg_bphase(f) : k == 10 ? qzg_b11.qzg_bphase(f) : k == 11 ? qzg_b12.qzg_bphase(f) :
  k == 12 ? qzg_b13.qzg_bphase(f) : k == 13 ? qzg_b14.qzg_bphase(f) : k == 14 ? qzg_b15.qzg_bphase(f) : qzg_b16.qzg_bphase(f);
);
// the band's own dB at one frequency (the block search, qzg_seek)
function qzg_mag1(f) instance(filter, run_sr) local(m) (
  m = filter.rk_svfm_magnitude(f, run_sr); m > 0.000000001 ? 20 * log10(m) : -180;
);
function qzg_retarget() local(gs) (
  gs = qz_scale / 100;               // its own copy, never @block's qz_gscale
  // the rate the curve is designed and drawn at: @init (the bank's qz_band_init) does not re-run on a sample-rate
  // change (ext_noinit), and the matched maps read run_sr, so it follows srate here; fmax moves with it, so every
  // band then retargets at the new rate
  qzg_b1.run_sr = qzg_b2.run_sr = qzg_b3.run_sr = qzg_b4.run_sr = qzg_b5.run_sr = qzg_b6.run_sr = qzg_b7.run_sr =
  qzg_b8.run_sr = qzg_b9.run_sr = qzg_b10.run_sr = qzg_b11.run_sr = qzg_b12.run_sr = qzg_b13.run_sr = qzg_b14.run_sr =
  qzg_b15.run_sr = qzg_b16.run_sr = srate;
  // the display bank keeps a Bypassed band's shape (qz_band_apply's byp_shape; the audio bank never sets it), so the
  // window can draw it as an outline (ReEQ 558-577, 1958-2032)
  qzg_b1.byp_shape = qzg_b2.byp_shape = qzg_b3.byp_shape = qzg_b4.byp_shape = qzg_b5.byp_shape = qzg_b6.byp_shape =
  qzg_b7.byp_shape = qzg_b8.byp_shape = qzg_b9.byp_shape = qzg_b10.byp_shape = qzg_b11.byp_shape = qzg_b12.byp_shape =
  qzg_b13.byp_shape = qzg_b14.byp_shape = qzg_b15.byp_shape = qzg_b16.byp_shape = 1;
  // a reacting band is drawn where it is now (ReEQ 2: the curve moves, the resting setting a dotted outline)
  qzg_b1.gofs = qz_dyng[0]; qzg_b2.gofs = qz_dyng[1]; qzg_b3.gofs = qz_dyng[2]; qzg_b4.gofs = qz_dyng[3];
  qzg_b5.gofs = qz_dyng[4]; qzg_b6.gofs = qz_dyng[5]; qzg_b7.gofs = qz_dyng[6]; qzg_b8.gofs = qz_dyng[7];
  qzg_b9.gofs = qz_dyng[8]; qzg_b10.gofs = qz_dyng[9]; qzg_b11.gofs = qz_dyng[10]; qzg_b12.gofs = qz_dyng[11];
  qzg_b13.gofs = qz_dyng[12]; qzg_b14.gofs = qz_dyng[13]; qzg_b15.gofs = qz_dyng[14]; qzg_b16.gofs = qz_dyng[15];
  // the resonant cuts' law changed (an older save, @block's qz_law_chk): every band is drawn afresh under it
  qzg_law_seen !== qz_cut_law ? (
    qzg_law_seen = qz_cut_law;
    qzg_b1.c_q = qzg_b2.c_q = qzg_b3.c_q = qzg_b4.c_q = qzg_b5.c_q = qzg_b6.c_q = qzg_b7.c_q = qzg_b8.c_q = -1;
    qzg_b9.c_q = qzg_b10.c_q = qzg_b11.c_q = qzg_b12.c_q = qzg_b13.c_q = qzg_b14.c_q = qzg_b15.c_q = qzg_b16.c_q = -1;
  );
  // each band's retarget on the face's ONE workspace qzg_w, its record copied in and back (qzg_rec_in / qzg_rec_out,
  // GENERATED by qz_rec_gen.py; plan step 3, 2026-11-07): qz_band_apply's tree compiles once, not seventeen times.
  // The snap and the drawing (qzg_snap, qzg_row, qzg_bphase, qzg_mag1: small) stay on the band. qzg_w is @gfx's alone.
  qzg_b1.qzg_rec_in();  qzg_w.qz_band_apply(1, gs);   qzg_b1.qzg_rec_out();  qzg_b1.qzg_snap(0);
  qzg_b2.qzg_rec_in();  qzg_w.qz_band_apply(14, gs);  qzg_b2.qzg_rec_out();  qzg_b2.qzg_snap(1);
  qzg_b3.qzg_rec_in();  qzg_w.qz_band_apply(27, gs);  qzg_b3.qzg_rec_out();  qzg_b3.qzg_snap(2);
  qzg_b4.qzg_rec_in();  qzg_w.qz_band_apply(40, gs);  qzg_b4.qzg_rec_out();  qzg_b4.qzg_snap(3);
  qzg_b5.qzg_rec_in();  qzg_w.qz_band_apply(53, gs);  qzg_b5.qzg_rec_out();  qzg_b5.qzg_snap(4);
  qzg_b6.qzg_rec_in();  qzg_w.qz_band_apply(66, gs);  qzg_b6.qzg_rec_out();  qzg_b6.qzg_snap(5);
  qzg_b7.qzg_rec_in();  qzg_w.qz_band_apply(79, gs);  qzg_b7.qzg_rec_out();  qzg_b7.qzg_snap(6);
  qzg_b8.qzg_rec_in();  qzg_w.qz_band_apply(92, gs);  qzg_b8.qzg_rec_out();  qzg_b8.qzg_snap(7);
  qzg_b9.qzg_rec_in();  qzg_w.qz_band_apply(105, gs); qzg_b9.qzg_rec_out();  qzg_b9.qzg_snap(8);
  qzg_b10.qzg_rec_in(); qzg_w.qz_band_apply(118, gs); qzg_b10.qzg_rec_out(); qzg_b10.qzg_snap(9);
  qzg_b11.qzg_rec_in(); qzg_w.qz_band_apply(131, gs); qzg_b11.qzg_rec_out(); qzg_b11.qzg_snap(10);
  qzg_b12.qzg_rec_in(); qzg_w.qz_band_apply(144, gs); qzg_b12.qzg_rec_out(); qzg_b12.qzg_snap(11);
  qzg_b13.qzg_rec_in(); qzg_w.qz_band_apply(157, gs); qzg_b13.qzg_rec_out(); qzg_b13.qzg_snap(12);
  qzg_b14.qzg_rec_in(); qzg_w.qz_band_apply(170, gs); qzg_b14.qzg_rec_out(); qzg_b14.qzg_snap(13);
  qzg_b15.qzg_rec_in(); qzg_w.qz_band_apply(183, gs); qzg_b15.qzg_rec_out(); qzg_b15.qzg_snap(14);
  qzg_b16.qzg_rec_in(); qzg_w.qz_band_apply(196, gs); qzg_b16.qzg_rec_out(); qzg_b16.qzg_snap(15);
);
function qzg_fill(k, s0, n) (
  k == 0 ? qzg_b1.qzg_row(0, s0, n) : k == 1 ? qzg_b2.qzg_row(1, s0, n) : k == 2 ? qzg_b3.qzg_row(2, s0, n) :
  k == 3 ? qzg_b4.qzg_row(3, s0, n) : k == 4 ? qzg_b5.qzg_row(4, s0, n) : k == 5 ? qzg_b6.qzg_row(5, s0, n) :
  k == 6 ? qzg_b7.qzg_row(6, s0, n) : k == 7 ? qzg_b8.qzg_row(7, s0, n) : k == 8 ? qzg_b9.qzg_row(8, s0, n) :
  k == 9 ? qzg_b10.qzg_row(9, s0, n) : k == 10 ? qzg_b11.qzg_row(10, s0, n) : k == 11 ? qzg_b12.qzg_row(11, s0, n) :
  k == 12 ? qzg_b13.qzg_row(12, s0, n) : k == 13 ? qzg_b14.qzg_row(13, s0, n) : k == 14 ? qzg_b15.qzg_row(14, s0, n) :
  qzg_b16.qzg_row(15, s0, n);
);
// row k at band b's block, stamped with the block's generation
function qzg_fill_block(k, b) ( qzg_fill(k, QZG_NB + b * QZG_NR, QZG_NR); qzg_rv[k * 16 + b] = qzg_og[b]; );
function qzg_magdb(k, f) (
  k == 0 ? qzg_b1.qzg_mag1(f) : k == 1 ? qzg_b2.qzg_mag1(f) : k == 2 ? qzg_b3.qzg_mag1(f) : k == 3 ? qzg_b4.qzg_mag1(f) :
  k == 4 ? qzg_b5.qzg_mag1(f) : k == 5 ? qzg_b6.qzg_mag1(f) : k == 6 ? qzg_b7.qzg_mag1(f) : k == 7 ? qzg_b8.qzg_mag1(f) :
  k == 8 ? qzg_b9.qzg_mag1(f) : k == 9 ? qzg_b10.qzg_mag1(f) : k == 10 ? qzg_b11.qzg_mag1(f) : k == 11 ? qzg_b12.qzg_mag1(f) :
  k == 12 ? qzg_b13.qzg_mag1(f) : k == 13 ? qzg_b14.qzg_mag1(f) : k == 14 ? qzg_b15.qzg_mag1(f) : qzg_b16.qzg_mag1(f);
);
// Where band b's own curve strays furthest from the straight line between the ends of a range of log frequency, the
// range ua .. ub in half-bandwidths w from f: 13 even steps find the resonance (a step is at most a half-bandwidth, so a
// peak cannot hide between two), then 10 golden-section steps around the best one (to 1/100 of a half-bandwidth).
// Returns the offset, in half-bandwidths.
function qzg_seek(b, f, w, ua, ub) local(i, u, d, da, dz, best, bu, sg, lo, hi, x1, x2, v1, v2, g) (
  da = qzg_magdb(b, f * exp(ua * w)); dz = qzg_magdb(b, f * exp(ub * w));
  best = -1; bu = ua; sg = 1; i = 0;
  loop(13,
    u = ua + (ub - ua) * i / 12;
    d = qzg_magdb(b, f * exp(u * w)) - (da + (dz - da) * i / 12);
    abs(d) > best ? ( best = abs(d); bu = u; sg = d < 0 ? -1 : 1; );
    i += 1;
  );
  lo = max(ua, bu - (ub - ua) / 12); hi = min(ub, bu + (ub - ua) / 12); g = 0.381966;
  x1 = lo + g * (hi - lo); x2 = hi - g * (hi - lo);
  v1 = sg * (qzg_magdb(b, f * exp(x1 * w)) - (da + (dz - da) * (x1 - ua) / (ub - ua)));
  v2 = sg * (qzg_magdb(b, f * exp(x2 * w)) - (da + (dz - da) * (x2 - ua) / (ub - ua)));
  loop(10,
    v1 > v2 ? (
      hi = x2; x2 = x1; v2 = v1; x1 = lo + g * (hi - lo);
      v1 = sg * (qzg_magdb(b, f * exp(x1 * w)) - (da + (dz - da) * (x1 - ua) / (ub - ua)));
    ) : (
      lo = x1; x1 = x2; v1 = v2; x2 = hi - g * (hi - lo);
      v2 = sg * (qzg_magdb(b, f * exp(x2 * w)) - (da + (dz - da) * (x2 - ua) / (ub - ua)));
    );
  );
  (lo + hi) / 2;
);

// The curve's points (the user's picture, 2026-10-21: a Q 40 cut at 92 Hz drawn to -13 dB beside ReEQ's -27, its
// sound at -30): the 256-point grid is 3 % apart, so a narrow bell or notch fell between two points and was drawn far
// too shallow. Each drawn band (On) whose Q shapes its curve (bells, Bell Prop Q, shelves, Tilt, notch, band pass, the
// resonant cuts; not the Pultec, whose "Q" is its dip depth over fixed 0.7 curves, nor All Pass, flat in magnitude) now
// lights a block of 19 points where its curve turns fastest, in half-bandwidths w (1 / 2Q in log frequency, at most
// 0.25; Bell Prop Q's own narrowing counted), at the frequency the engine designs it at (qz_band_apply: 0.49 x srate at
// most):
//   - a bell, notch, band pass or resonant cut: its own frequency f, where a bell's or notch's extreme sits exactly,
//     then 1/32 .. 8 w either side, doubling (a cut's peak sits within a half-bandwidth or so of f: drawn within 0.1 dB
//     at every slope, Q and frequency measured, its worst near Nyquist where it is far off the graph anyway);
//   - a shelf or Tilt: a resonant peak on one side of f and a dip on the other, near f x / A^(1/2) (A = 10^(gain x
//     Scale / 40)) but up to 5 w away from there near the top (measured), so each found by qzg_seek over 6 w either
//     side of its estimate (its own side of f only), 9 points around each (0, 1/8, 3/8, 1, 3 w either side) and f
//     itself, sorted (the clusters overlap at small gains; qzg_merge needs each block in order).
// The key: frequency, half-width, the shelf estimate and the rate (the search runs on the filter as designed at this
// rate; a High Shelf turned Low Shelf at the same settings finds its resonances where the other did, measured). Returns 1
// when the block changed (lit, moved, narrowed, reshaped, put out): the drawn order is rebuilt and every drawn row
// refills that block (qzg_og; a block relit at the same place gets a new generation too: a row refilled while it was
// out kept its old stamp there).
function qzg_owner(b) local(sh, f, q, w, r, key, c0, c1, i, m, u, s, t, k) (
  sh = qzg_shape(b);
  qzg_live(b) && qzg_has_q(sh) && sh != 10 && sh != 11 ? (
    f = min(max(QZG_FMIN, min(qzg_v(b, 3), 0.49 * srate)), QZG_FMAX);
    q = max(0.1, qzg_v(b, 5)); sh == 14 ? q *= 10 ^ (abs(qzg_v(b, 4) * qz_scale / 100) / 40);
    w = min(0.25, 0.5 / q);
    r = sh == 3 || sh == 4 || sh == 9 ? abs(qzg_v(b, 4) * qz_scale / 100) * log(10) / 80 : -1;   // -1: one cluster
    key = srate;
    !qzg_oa[b] || f !== qzg_ok1[b] || w !== qzg_ok2[b] || r !== qzg_ok3[b] || key !== qzg_ok4[b] ? (
      qzg_oa[b] = 1; qzg_ok1[b] = f; qzg_ok2[b] = w; qzg_ok3[b] = r; qzg_ok4[b] = key; qzg_og[b] += 1;
      // the centres, in half-bandwidths from f: one (c0) for a single cluster, two (c0 below f, c1 above) for a shelf
      r < 0 ? ( c0 = 0; )
            : ( c0 = qzg_seek(b, f, w, -r / w - 6, min(0, -r / w + 6)); c1 = qzg_seek(b, f, w, max(0, r / w - 6), r / w + 6); );
      s = QZG_NB + b * QZG_NR; i = 0;
      loop(QZG_NR,
        r < 0 ? (                      // in order already: -8 .. -1/32, 0, 1/32 .. 8 around c0
          m = i - 9; u = c0 + (m == 0 ? 0 : sign(m) * 2 ^ (abs(m) - 6));
        ) : i == 9 ? ( u = 0; ) : (    // around c0 (points 0..8), f (9), around c1 (10..18)
          m = i < 9 ? i - 4 : i - 14;
          u = (i < 9 ? c0 : c1) + (m == 0 ? 0 : sign(m) * (abs(m) == 1 ? 0.125 : abs(m) == 2 ? 0.375 : abs(m) == 3 ? 1 : 3));
        );
        qzg_fs[s + i] = max(QZG_FMIN, min(QZG_FMAX, f * exp(u * w)));
        i += 1;
      );
      r >= 0 ? (                       // sort the block (19 points, insertion)
        i = 1;
        loop(QZG_NR - 1,
          t = qzg_fs[s + i]; k = i - 1;
          while (k >= 0 && qzg_fs[s + k] > t ? ( qzg_fs[s + k + 1] = qzg_fs[s + k]; k -= 1; 1; ) : 0;);
          qzg_fs[s + k + 1] = t; i += 1;
        );
      );
      1;
    ) : 0;
  ) : qzg_oa[b] ? ( qzg_oa[b] = 0; 1; ) : 0;
);
// The drawn order: the base grid and every lit block merged by frequency into qzg_ord / qzg_fq (qzg_np points). Every
// run is already in order, so each step takes the lowest of the runs' next points (the base grid's on a tie).
function qzg_merge() local(b, n, best, bf, f) (
  b = 0; loop(16, qzg_mp[b] = qzg_oa[b] ? 0 : QZG_NR; b += 1; );
  qzg_mp[16] = 0; n = 0;
  loop(QZG_NS,
    best = -1; bf = 0;
    qzg_mp[16] < QZG_NB ? ( best = 16; bf = qzg_fs[qzg_mp[16]]; );
    b = 0;
    loop(16,
      qzg_mp[b] < QZG_NR ? (
        f = qzg_fs[QZG_NB + b * QZG_NR + qzg_mp[b]];
        best < 0 || f < bf ? ( best = b; bf = f; );
      );
      b += 1;
    );
    best >= 0 ? (
      qzg_ord[n] = best == 16 ? qzg_mp[16] : QZG_NB + best * QZG_NR + qzg_mp[best];
      qzg_fq[n] = bf; qzg_mp[best] += 1; n += 1;
    );
  );
  qzg_np = n;
);
// The rows, the sum and the drawn views. Only drawn rows (live bands: On, or Bypassed, drawn as an outline) are
// evaluated: a dirty row refills its base points and every lit block; a clean one only the blocks that changed since it
// last saw them (one band dragged: its own row, plus its 19 points on each other drawn row). A row that is not drawn
// keeps its dirty flag until it is. The sum is the Stereo bands that are On (a Mid / Side / Left / Right band draws its
// own patterned curve, a Bypassed one its outline; neither is on the summed one). Each other placement with an On band
// gets its own total, of its own bands only (ReEQ's group curves, 2051-2192 and 4280-4311: not the Stereo bands).
// qzg_cvon says which bands' views were gathered: the window draws a band only when it was (a band its own input
// switched on later in the same pass would read a stale row, in an old point order: the review's one-frame flash).
function qzg_curves() local(k, b, j, re, any, sig, row, dst, p) (
  re = 0; b = 0; loop(16, qzg_owner(b) ? re = 1; b += 1; );
  re || qzg_np < QZG_NB ? qzg_merge();
  any = re; k = 0;
  loop(16,
    qzg_live(k) ? (
      qzg_dty[k] ? (
        qzg_fill(k, 0, QZG_NB); b = 0; loop(16, qzg_oa[b] ? qzg_fill_block(k, b); b += 1; );
        qzg_dty[k] = 0; any = 1;
      ) : (
        b = 0; loop(16, qzg_oa[b] && qzg_rv[k * 16 + b] !== qzg_og[b] ? ( qzg_fill_block(k, b); any = 1; ); b += 1; );
      );
    );
    k += 1;
  );
  sig = 0; k = 0;
  // which rows are drawn and which total each is in: 1 Bypassed (in none), On: 2 the sum, 3..6 Mid..Right's totals
  // (base 8: 8^15 * 6 and the rest stay exact in a double)
  loop(16, sig += 8 ^ k * (qzg_on(k) ? 2 + qzg_place(k) : qzg_live(k) ? 1 : 0); k += 1; );
  any || sig !== qzg_sum_sig ? (
    qzg_sum_sig = sig; qzg_cgen += 1;  // the curves' generation (the phase curve follows it)
    j = 0; loop(QZG_NS, qzg_ssum[j] = 0; j += 1; );
    j = 0; loop(4 * QZG_NS, qzg_pss[j] = 0; j += 1; );
    p = 0; loop(4, qzg_pon[p] = 0; p += 1; );
    k = 0;
    loop(16,
      qzg_cvon[k] = qzg_live(k);
      qzg_cvon[k] ? (
        row = qzg_ev + k * QZG_NS; dst = qzg_cv + k * QZG_NS;
        qzg_on(k) ? (
          p = qzg_place(k);
          p == 0 ? ( j = 0; loop(QZG_NS, qzg_ssum[j] += row[j]; j += 1; ); ) : (
            qzg_pon[p - 1] = 1; b = qzg_pss + (p - 1) * QZG_NS;
            j = 0; loop(QZG_NS, b[j] += row[j]; j += 1; );
          );
        );
        j = 0; loop(qzg_np, dst[j] = row[qzg_ord[j]]; j += 1; );
      );
      k += 1;
    );
    j = 0; loop(qzg_np, qzg_sum[j] = qzg_ssum[qzg_ord[j]]; j += 1; );
    p = 0;
    loop(4,
      qzg_pon[p] ? ( b = qzg_pss + p * QZG_NS; dst = qzg_pt + p * QZG_NS; j = 0; loop(qzg_np, dst[j] = b[qzg_ord[j]]; j += 1; ); );
      p += 1;
    );
  );
);
// The summed curve at f (the hover readout): the points either side found by halving, then interpolated in magnitude,
// not dB, over log frequency: beside a notch's zero (-180 dB at its own point) a straight line in dB read tens of dB
// too deep (the review: -117.7 dB half a pixel from a 1 kHz notch whose sound there is -41.5); a zero's magnitude grows
// in proportion to the distance, which magnitude interpolation follows.
function qzg_sum_at(f) local(lo, hi, m, t, a) (
  f = max(QZG_FMIN, min(QZG_FMAX, f)); lo = 0; hi = max(1, qzg_np - 1);
  loop(10, hi - lo > 1 ? ( m = floor((lo + hi) / 2); qzg_fq[m] <= f ? lo = m : hi = m; ); );
  t = max(0, min(1, log(max(f, qzg_fq[lo]) / qzg_fq[lo]) / max(0.0000001, log(qzg_fq[hi] / qzg_fq[lo]))));
  a = 10 ^ (qzg_sum[lo] / 20);
  a += (10 ^ (qzg_sum[hi] / 20) - a) * t;
  a > 0.000000001 ? 20 * log10(a) : -180;
);

// ---- graph mapping (the mock: the full width, 0 dB in the middle, +/-R 34 px inside the edges) ----
function qzg_f2x(f) ( qzg_gx + qzg_gw * log(max(f, QZG_FMIN) / QZG_FMIN) / QZG_LF; );
function qzg_x2f(x) ( max(QZG_FMIN, min(QZG_FMAX, QZG_FMIN * exp(QZG_LF * (x - qzg_gx) / qzg_gw))); );
// dB -> y, held inside the graph's own rect (in pixels: a dB limit put curves and fills off the graph at small ranges)
function qzg_d2y(d) ( max(qzg_gy, min(qzg_gy + qzg_gh, qzg_gy + qzg_gh / 2 - d / qzg_r * qzg_ghalf)); );
function qzg_y2d(y) ( (qzg_gy + qzg_gh / 2 - y) / qzg_ghalf * qzg_r; );
// a resonant cut's height from its Q (ReEQ get_filter_y): s = its 12 dB stages; 0 dB at the 6 dB slope. Under the new
// cut law (qz_cut_law 1, qz_engine qz_res_cut) every slope's corner is the 12 dB one's, so s is 1 at any slope from
// 12 dB up: the dot keeps its height and its Q across a slope change (qzg_slope_keep then keeps the Q as it is).
function qzg_cut_s(sl) local(s) ( s = floor((sl + 1) / 2); qz_cut_law ? min(s, 1) : s; );
function qzg_cut_db(sl, q) local(s) ( s = qzg_cut_s(sl); s < 1 ? 0 : s * (6 * log(max(0.1, q)) / log(2) + 3); );
function qzg_cut_q(sl, d) local(s) (      // the inverse (ReEQ set_filter_from_xy), clamped to the slider
  s = qzg_cut_s(sl);
  s < 1 ? 0.7071 : max(0.1, min(40, 2 ^ ((d / s - 3) / 6)));
);
// where a band's dot sits: a resonant cut shows its Q as height, gain shapes their gain x Scale, the rest 0 dB
function qzg_node_db(k) local(sh) (
  sh = qzg_shape(k);
  qzg_res_cut(sh) ? qzg_cut_db(qzg_slope(k), qzg_v(k, 5)) : qzg_has_gain(sh) ? qzg_geff(k) + qz_dyng[k] * qz_scale / 100 : 0;
);
// the dot's y: kept where the graph takes the mouse (from y 30, clear of the top bar, to the graph's foot), so a band
// beyond the range stays visible AND grabbable at the edge; drawing, hit tests, the menu and the tag all use it
function qzg_node_y(k) ( max(qzg_gy + 40 * qzg_s, min(qzg_gbot - 10 * qzg_s, qzg_d2y(qzg_node_db(k)))); );

// ---- icons (the mock's 17-point polylines) ----
function qzg_sg(u) ( 1 / (1 + exp(-u)); );
function qzg_ga(t, m, s) ( exp(-((t - m) / s) * ((t - m) / s)); );
// The gain shapes sit on a 0 dB line at mid-height (the audit, 2026-10-21): the flat side of a shelf and a bell's skirts
// there, the boost above, so upside down (a cut) a low shelf never reads as a high shelf boosting. Tilt Shelf is an S
// through 0 dB at f with flat ends (its curve: -g below, +g above), Flat Tilt the straight line; both over a dashed
// 0 dB line. The Pultec as ReEQ builds it: a low shelf boost plus a broad bell cut on the same frequency, which leaves
// a gentle dip just above the shelf (fitted to the sound at its default Q 20: the dip a fifth of the boost). 12: a low
// cut with a hump under it (the analog low channel boosting).
function qzg_glyph_y(gl, t) (
  gl == 0 ? 0.5 - 0.36 * qzg_ga(t, 0.5, 0.14) : gl == 3 ? 0.5 - 0.34 * (1 - qzg_sg((t - 0.45) * 14)) :
  gl == 4 ? 0.5 - 0.34 * qzg_sg((t - 0.55) * 14) : gl == 1 ? 0.38 + 0.58 * (1 - qzg_sg((t - 0.38) * 12)) :
  gl == 2 ? 0.38 + 0.58 * qzg_sg((t - 0.62) * 12) : gl == 5 ? 0.4 + 0.56 * qzg_ga(t, 0.5, 0.06) :
  gl == 6 ? 0.15 + 0.8 * (1 - qzg_ga(t, 0.5, 0.2)) : gl == 7 ? 0.5 + 0.32 * (1 - 2 * qzg_sg((t - 0.5) * 14)) :
  gl == 8 ? 0.5 - 0.34 * (1 - qzg_sg((t - 0.38) * 14)) + 0.17 * qzg_ga(t, 0.38, 0.225) :
  gl == 10 ? 0.88 - 0.76 * t : gl == 11 ? 0.28 :
  gl == 12 ? 0.5 + 0.38 * (1 - qzg_sg((t - 0.2) * 16)) - 0.30 * qzg_ga(t, 0.44, 0.13) : 0.5;
);
// The node menu's copy of the icons (rk_menu is imported first and cannot call qzg_glyph): the host's main @init calls
// this once, right after rkm_setup. The marks: All Pass's ring 1, Flat Gain's dashed line 2, the tilts' 3.
function qzg_menu_icons() local(i, j) (
  i = 0;
  loop(13,
    j = 0; loop(17, rkm_icon_def(i, j, qzg_glyph_y(i, j / 16)); j += 1; );
    rkm_icon_extra(i, i == 9 ? 1 : i == 11 ? 2 : i == 7 || i == 10 ? 3 : 0);
    i += 1;
  );
);
// Icon code c (qzg_icon_of: 0..12, + 13 upside down) in a w x h box, its line wd px wide, in the current colour, with
// its marks: All Pass's ring, the tilts' dashed 0 dB line, Flat Gain's dashed 0 dB line under (over, upside down) it
function qzg_glyph(c, x, y, w, h, wd) local(j, t, px, py, ox, oy, gl, fl, v) (
  fl = c >= 13; gl = fl ? c - 13 : c;
  j = 0;
  loop(17,
    t = j / 16; v = qzg_glyph_y(gl, t); px = x + t * w; py = y + (fl ? 1 - v : v) * h;
    j > 0 ? qzg_aline(ox, oy, px, py, wd);
    ox = px; oy = py; j += 1;
  );
  gl == 9 ? qzg_ringw(x + w / 2, y + h / 2, 0.28 * h, qzg_s);
  gl == 7 || gl == 10 || gl == 11 ? (
    v = y + (gl == 11 ? (fl ? 0.22 : 0.78) : 0.5) * h;
    j = 0; loop(5, qzg_aline(x + j * w / 5, v, x + j * w / 5 + w / 10, v, qzg_s); j += 1; );
  );
);

// ---- selection ----
function qzg_sel_count() local(k, n) ( n = 0; k = 0; loop(16, n += qzg_sel[k] && qzg_live(k) ? 1 : 0; k += 1; ); n; );
function qzg_sel_only(k) local(j) ( j = 0; loop(16, qzg_sel[j] = j == k; j += 1; ); qzg_prim = k; );
function qzg_sel_clear() local(j) ( j = 0; loop(16, qzg_sel[j] = 0; j += 1; ); qzg_prim = -1; );
function qzg_free_slot() local(k, f) ( f = -1; k = 0; loop(16, f < 0 && !qzg_live(k) ? f = k; k += 1; ); f; );
function qzg_live_count() local(k, n) ( n = 0; k = 0; loop(16, n += qzg_live(k); k += 1; ); n; );
// the bands an edit applies to: the selection when band k is in it, else k alone
function qzg_targets(k, j) ( qzg_live(j) && (qzg_sel[k] ? qzg_sel[j] : j == k); );
function qzg_snap_targets(k) local(j) ( j = 0; loop(16, qzg_bsel[j] = qzg_targets(k, j); j += 1; ); );

// nearest live band within rad px of (px, py); -1 if none; on a tie the lower slot (a split's two halves coincide)
function qzg_hit(px, py, rad) local(k, best, bd, d, x, y) (
  best = -1; bd = rad * rad + 0.001; k = 0;
  loop(16,
    qzg_live(k) ? (
      x = qzg_f2x(qzg_v(k, 3)); y = qzg_node_y(k);
      d = (px - x) * (px - x) + (py - y) * (py - y);
      d < bd ? ( bd = d; best = k; );
    );
    k += 1;
  );
  best;
);

// ---- band edits that touch several sliders ----
// copy every control but Mode; the caller sets Mode last (the sound reads the sliders while @gfx writes them, so a
// band switched on first would play the slot's old settings for a block)
function qzg_copy_band(src, dst) local(c) (
  c = 1; loop(12, qzg_set(qzg_n(dst, c), qzg_v(src, c)); c += 1; );
  qzg_sel[dst] = 0;
);
// ReEQ create_band (2732-2777): the shape from the frequency, the click's height (held inside the graph's range, ReEQ
// y_to_db) as the gain, or as a resonant cut's Q (set_filter_from_xy: its dot lands under the pointer). pl: the
// placement, or -1 to inherit the selected band's (the window; with no band left, Stereo, as ReEQ resets it)
function qzg_new_band(f, d, pl) local(k, sh) (
  k = qzg_free_slot();
  k >= 0 ? (
    d = max(-qzg_r, min(qzg_r, d));
    sh = f < 20 ? 1 : f < 30 ? 3 : f < 10000 ? 0 : f < 15000 ? 4 : 5;
    pl < 0 ? (
      pl = (qzg_prim >= 0 && qzg_live(qzg_prim)) ? qzg_place(qzg_prim) : (qzg_live_count() == 0 ? 0 : max(0, min(4, qzg_lastpl | 0)));
    );
    qzg_set(qzg_n(k, 2), sh);
    qzg_set(qzg_n(k, 1), pl);
    qzg_setf(k, f);
    qzg_setsl(k, 1);
    qzg_res_cut(sh) ? ( qzg_setg(k, 0); qzg_setq(k, qzg_cut_q(1, d)); )   // 12 dB: Q = 2^((d - 3) / 6), 0 dB = 0.7071
                    : ( qzg_setg(k, d / max(0.01, qz_scale / 100)); qzg_setq(k, sh == 3 || sh == 4 ? 0.36 : 0.7071); );
    qzg_set(qzg_n(k, 0), 2);
    qzg_sel_only(k);
  );
  k;
);
function qzg_add_bell() local(k) (           // the band bar's + ADD: a Bell at 1 kHz, 0 dB, Q 1
  k = qzg_free_slot();
  k >= 0 ? (
    qzg_set(qzg_n(k, 2), 0); qzg_setf(k, 1000); qzg_setg(k, 0); qzg_setq(k, 1); qzg_set(qzg_n(k, 1), 0);
    qzg_setsl(k, 1); qzg_set(qzg_n(k, 0), 2); qzg_sel_only(k);
  );
);
// Switch band k to shape sh with ReEQ's resets (its node menu, set_shape_selected_nodes 3221-3250, per band; its panel
// path, 5136-5161, disagrees with its own menu, so one rule here for the menu, the editor's icons and the cut-style
// chips). Nothing when sh is already the shape (ReEQ's panel guard; its menu re-pick reset is not copied).
//   slope: 12 dB when the old shape has none, or the new one is the Pultec; otherwise kept
//   Q:     the Pultec's 20; otherwise 0.7071, but kept between the two resonant cuts (ReEQ) and between Peak and Bell
//          Prop Q (the same Q in both)
//   gain:  always kept (the user, 2026-10-21: "changing the band shape zero gains the band ... change it"; ReEQ zeroes it
//          on a switch to a cut, notch, band pass or all pass, 3237-3240, which also lost it on the way back). Those
//          shapes ignore the gain, so nothing is heard; a bell or shelf picked later plays it again.
// A slope the new shape plays is written before the shape, one it ignores after it: @block may read between two writes,
// and the shape playing then always ignores the value.
// The Q the same way (the review): 0.7071 goes before the shape (a lower Q is safe under the old one, and written after,
// a new resonant cut could play an old Q 40 for a block), the Pultec's 20 after it (under an old resonant cut or shelf
// it would ring; the Pultec reads Q only as its dip depth, at most 10 dB, so a block of the old value is harmless).
function qzg_set_shape(k, sh) local(old, sl, qr) (
  old = qzg_shape(k);
  sh !== old ? (
    sl = !qzg_has_slope(old) || sh == 10 ? 1 : -1;                  // -1: kept
    qr = !((qzg_res_cut(old) && qzg_res_cut(sh)) || (qzg_glyph_of(old) == 0 && qzg_glyph_of(sh) == 0));
    sl >= 0 && qzg_has_slope(sh) ? qzg_setsl(k, sl);
    qr && sh != 10 ? qzg_setq(k, 0.7071);
    qzg_set(qzg_n(k, 2), sh);
    qr && sh == 10 ? qzg_setq(k, 20);
    sl >= 0 && !qzg_has_slope(sh) ? qzg_setsl(k, sl);
  );
);
function qzg_delete(k) ( qzg_set(qzg_n(k, 0), 0); qzg_sel[k] = 0; qzg_prim == k ? qzg_prim = -1; qzg_lsn == k ? qzg_lsn = -1; );
// The band after k (ReEQ's panel DELETE moves on to it, 5370-5384, as it intends: its end test reads a name it never
// sets, so its search stops at slot 0), in the display order (slot order, or left to right with the numbering on),
// wrapping past the last; -1 when none is left
function qzg_next_live(k) local(i, j, n) (
  n = -1; i = 1;
  loop(15, j = qzg_ds[(qzg_dn[k] + i) % 16]; n < 0 && j != k && qzg_live(j) ? n = j; i += 1; );
  n;
);
function qzg_toggle_power(k) ( qzg_set(qzg_n(k, 0), qzg_on(k) ? 1 : 2); );
// a new slope that keeps a resonant cut's height: Q re-derived for the new slope (ReEQ 3050-3094)
// (the review: @block may read between the two writes, so more stages take the new, lower Q first and fewer take the
// slope first; the state in between never peaks above the final one). Under the new cut law (qz_cut_law 1) the height
// does not depend on the slope, so only the slope is written (a Q re-derived through the height could move by an ulp).
function qzg_slope_keep(k, sl) local(d, q, s0, s1) (
  sl = max(0, min(19, sl | 0));
  !qz_cut_law && qzg_res_cut(qzg_shape(k)) && qzg_slope(k) >= 1 && sl >= 1 ? (
    d = qzg_cut_db(qzg_slope(k), qzg_v(k, 5)); q = qzg_cut_q(sl, d);   // from the old slope and Q, before any write
    s0 = floor((qzg_slope(k) + 1) / 2); s1 = floor((sl + 1) / 2);
    s1 > s0 ? ( qzg_setq(k, q); qzg_setsl(k, sl); ) : ( qzg_setsl(k, sl); qzg_setq(k, q); );
  ) : qzg_setsl(k, sl);
);

// Every popup goes through here: Quezy's own drawn menu (rk_menu.jsfx-inc, the user 2026-10-20: "the menus need our
// polish"). It answers later, from rkm_run at the end of the pass, so this returns 0; a test rig's stand-in may answer
// at once instead (any non-zero return is taken as the pick). Kept to one line: the rig swaps it by its exact text.
function qzg_menu(str) ( rkm_style(qzg_c_mnu, qzg_c_mnl, qzg_c_mns, qzg_c_tx, qzg_c_dim, qzg_c_acc); rkm_open(str, gfx_x, gfx_y, qzg_s); 0; );

// Copy / Paste of bands (step 7; spec §3b: "clipboard in gmem, one owner"): one clipboard for every Quezy in the
// session, EON_QUEZY_CLIP (31374100, .refs/gmem_regions_supplement.tsv): +0 how many bands (0 = empty), +1 a counter
// bumped LAST on every copy, +2.. per band its 13 controls (Mode, then the 12 qzg_copy_band copies), in band order.
// Only @gfx writes it, and only on a Copy pick (one writer at a time: a person's click). A paste takes free slots in
// order (what does not fit is left out), keeps each band's Mode and selects what it pasted.
QZG_CLIP = 31374100;
function qzg_clip_n() ( max(0, min(16, gmem[QZG_CLIP] | 0)); );
function qzg_clip_copy() local(j, n, c) (
  n = 0; j = 0;
  loop(16,
    qzg_bsel[j] && qzg_live(j) ? (
      c = 0; loop(13, gmem[QZG_CLIP + 2 + n * 13 + c] = qzg_v(j, c); c += 1; );
      n += 1;
    );
    j += 1;
  );
  n > 0 ? ( gmem[QZG_CLIP] = n; gmem[QZG_CLIP + 1] = (gmem[QZG_CLIP + 1] | 0) + 1; );
);
function qzg_clip_paste() local(i, n, k, c, first) (
  n = qzg_clip_n(); first = 1; i = 0;
  loop(n,
    (k = qzg_free_slot()) >= 0 ? (
      c = 1; loop(12, qzg_set(qzg_n(k, c), gmem[QZG_CLIP + 2 + i * 13 + c]); c += 1; );
      qzg_set(qzg_n(k, 0), max(1, min(4, gmem[QZG_CLIP + 2 + i * 13] | 0)));   // Mode last (never Off)
      first ? ( qzg_sel_only(k); first = 0; ) : ( qzg_sel[k] = 1; qzg_prim = k; );
    );
    i += 1;
  );
);
// the Shape submenu's order (slider shape numbers)
function qzg_menu_shape(i) (
  i == 0 ? 0 : i == 1 ? 14 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 9 : i == 5 ? 10 : i == 6 ? 1 : i == 7 ? 2 : i == 8 ? 12 :
  i == 9 ? 5 : i == 10 ? 6 : i == 11 ? 13 : i == 12 ? 7 : i == 13 ? 8 : i == 14 ? 11 : i == 15 ? 15 : 16;
);

// every band's gain to 0 dB (the band menu, the graph's menu and the 0 key): the bands with a gain; the cuts, their
// frequencies, Q, shapes and on / off untouched. One undo step (the history takes the pass's changes together).
function qzg_zero_all() local(j) (
  j = 0; loop(16, qzg_live(j) && qzg_has_gain(qzg_shape(j)) && qzg_v(j, 4) != 0 ? qzg_setg(j, 0); j += 1; );
);
// act on a node-menu pick r for the band the menu opened on (qzg_mk) and the selection it belongs to
function qzg_node_pick(r) local(j, sh, on, ns, n, k) (
  k = qzg_mk; on = qzg_mon; ns = qzg_mns;
  qzg_snap_targets(k);                 // the bands this item acts on, fixed before any of them changes
  // item 4, Zero all gains (2026-11-03), after Zero gain: the items below it keep their old numbers
  r == 4 ? ( qzg_zero_all(); r = -100; ) : r > 4 ? r -= 1;
  r == 1 ? ( j = 0; loop(16, qzg_bsel[j] ? qzg_set(qzg_n(j, 0), on ? 1 : 2); j += 1; ); ) :
  r == 2 ? ( j = 0; loop(16, qzg_bsel[j] && qzg_has_gain(qzg_shape(j)) ? qzg_setg(j, -qzg_v(j, 4)); j += 1; ); ) :
  r == 3 ? ( j = 0; loop(16, qzg_bsel[j] ? ( qzg_setg(j, 0); qzg_res_cut(qzg_shape(j)) ? qzg_setq(j, 0.7071); ); j += 1; ); ) :
  r >= 4 && r <= 20 ? (
    sh = qzg_menu_shape(r - 4);
    j = 0; loop(16, qzg_bsel[j] ? qzg_set_shape(j, sh); j += 1; );
  ) : ns && r >= 21 && r <= 30 ? (
    sh = qzg_sl10(r - 21);
    j = 0; loop(16, qzg_bsel[j] && qzg_has_slope(qzg_shape(j)) ? qzg_slope_keep(j, sh); j += 1; );
  ) : r > 20 + ns ? (
    r -= 20 + ns;                      // 1..5 placement, 6 split M/S, 7 split L/R, 8 duplicate, 9 copy, 10 paste, 11 delete
    r <= 5 ? ( j = 0; loop(16, qzg_bsel[j] ? qzg_set(qzg_n(j, 1), r - 1); j += 1; ); ) :
    r == 6 || r == 7 ? (               // the band becomes Mid (Left) and its copy Side (Right)
      j = 0;
      loop(16,
        qzg_bsel[j] && (n = qzg_free_slot()) >= 0 ? (
          qzg_copy_band(j, n); qzg_set(qzg_n(n, 1), r == 6 ? 2 : 4); qzg_set(qzg_n(j, 1), r == 6 ? 1 : 3);
          qzg_set(qzg_n(n, 0), qzg_v(j, 0));
        );
        j += 1;
      );
    ) :
    r == 9 ? qzg_clip_copy() :
    r == 10 ? qzg_clip_paste() :
    r == 8 ? (                         // the copy lands at f x 1.12 (the mock)
      j = 0;
      loop(16,
        qzg_bsel[j] && (n = qzg_free_slot()) >= 0 ? (
          qzg_copy_band(j, n); qzg_setf(n, qzg_v(j, 3) * 1.12); qzg_set(qzg_n(n, 0), qzg_v(j, 0));
        );
        j += 1;
      );
    ) :
    r == 11 ? ( j = 0; loop(16, qzg_bsel[j] ? qzg_delete(j); j += 1; ); );
  );
);

// ---- the node menu (window only: a strip gets no right-click). Items, numbered as gfx_showmenu numbers them:
//      1 Enable / Disable, 2 Invert gain, 3 Zero gain, (4 Zero all gains, taken off first) 4..20 Shape, then Slope (10, only for the cuts that have one),
//      Placement (5), Split M/S, Split L/R, Duplicate, Copy, Paste (greyed with nothing copied), Delete. The band's
//      current shape, slope and placement carry a tick. ----
function qzg_node_menu(k) local(r, j, sh, ns, sl, pl) (
  sh = qzg_shape(k); sl = qzg_slope(k); pl = qzg_place(k);
  gfx_x = qzg_f2x(qzg_v(k, 3)) + 8 * qzg_s; gfx_y = qzg_node_y(k) + 8 * qzg_s;
  strcpy(#qzg_m, qzg_on(k) ? "Disable|" : "Enable|");
  strcat(#qzg_m, "Invert gain|Zero gain|Zero all gains||>Shape|");
  j = 0;
  loop(17,
    j == 16 ? strcat(#qzg_m, "<");
    qzg_menu_shape(j) == sh ? strcat(#qzg_m, "!");
    // its icon as it would play on this band (the user: "those same shapes next to the names"; rk_menu's '^' prefix)
    sprintf(#qzg_t, "^%c", 97 + qzg_icon_of(qzg_menu_shape(j), qzg_geff(k))); strcat(#qzg_m, #qzg_t);
    strcat(#qzg_m, qzg_shape_name(qzg_menu_shape(j))); strcat(#qzg_m, "|");
    j += 1;
  );
  ns = qzg_has_slope(sh) ? 10 : 0;
  ns ? (
    strcat(#qzg_m, ">Slope|");
    j = 0;
    loop(10,
      j == 9 ? strcat(#qzg_m, "<");
      qzg_sl10(j) == sl ? strcat(#qzg_m, "!");
      sprintf(#qzg_t, "%d dB/oct|", (qzg_sl10(j) + 1) * 6); strcat(#qzg_m, #qzg_t);
      j += 1;
    );
  );
  strcat(#qzg_m, ">Placement|");
  j = 0;
  loop(5,
    j == 4 ? strcat(#qzg_m, "<");
    j == pl ? strcat(#qzg_m, "!");
    strcat(#qzg_m, j == 0 ? "Stereo|" : j == 1 ? "Mid|" : j == 2 ? "Side|" : j == 3 ? "Left|" : "Right|");
    j += 1;
  );
  // Split L/R beside ReEQ's Split M/S, and Copy / Paste of the selected bands across Quezys (step 7, spec §3b ZL row)
  strcat(#qzg_m, "|Split into mid + side|Split into left + right|Duplicate||Copy|");
  strcat(#qzg_m, qzg_clip_n() > 0 ? "Paste||Delete" : "#Paste||Delete");
  qzg_mk = k; qzg_mon = qzg_on(k); qzg_mns = ns;
  r = qzg_menu(#qzg_m);
  r ? qzg_node_pick(r) : qzg_mkind = 1;   // the answer comes from rkm_run (qzg_window's tail)
);

// ---- the display order ----
// "Number bands left to right" (qzv_renum, view state in @serialize gate 3; the user, 2026-10-20): each live band's
// number and colour come from its place on the frequency axis (lowest = 1; equal frequencies keep slot order), so
// band 1 is always the lowest and the colours run left to right; they swap as one band passes another. Off: the
// slot's own. Display only: the sliders, REAPER's parameter names ("B3 Freq") and automation stay with the slot.
function qzg_order() local(k, j, r, f, n) (
  n = qzg_live_count();
  k = 0;
  loop(16,
    !qzv_renum ? r = k : qzg_live(k) ? (
      r = 0; f = qzg_v(k, 3); j = 0;
      loop(16, qzg_live(j) && (qzg_v(j, 3) < f || (qzg_v(j, 3) === f && j < k)) ? r += 1; j += 1; );
    ) : (
      r = n; j = 0;                    // an empty slot: after the live bands, in slot order
      loop(k, !qzg_live(j) ? r += 1; j += 1; );
    );
    qzg_dn[k] = r; qzg_ds[r] = k;
    k += 1;
  );
);
// The graph's own menu, a right-click on empty graph (spec §8, "the window menu"; the analyser options join it in
// step 5): 1 the version, greyed (ReEQ's Settings menu, 4080-4082; rk_menu never returns it), 2 the numbering, 3..7
// the dB range (+-6 .. +-30), 8..44 the Analyser submenu (qzg_an_menu: source 8..14, display 15..17, ceiling 18..20,
// floor 21..23, tilt 24..28, window 29..32, FFT size 33..36, decay 37..39, 40 pre-EQ, 41 peaks, 42 piano, 43 phase
// curve, 44 freeze), 45..50 the native look (Midnight, Carbon, Aurora, Ember, Paper, White; step 6), 51..67 the link
// group (Off, 1..16; step 6). The window's and
// the strips' looks and the strips' analyser were items 8..20 until 2026-10-30; they live in the theme panel now
// (qzg_topbar), and the decode shifts past their old numbers.
function qzg_graph_pick(r) (
  r -= 1;                              // ReEQ's own decode: gfx_showmenu() - 1 (4134)
  r >= 7 ? r += 13;                    // the decode below still counts the 13 look rows that moved to the theme panel
  // (2026-10-31) Heat (29) joined Display before None, and Smoothing (53..57) after Decay: back to the old numbers
  r == 29 ? ( qzv_an_disp = 3; r = -100; ) :
  r == 30 ? r = 29 :
  r >= 53 && r <= 57 ? ( qzv_an_smooth = r - 53; r = -100; ) :
  r >= 58 ? r -= 6 :
  r >= 31 ? r -= 1;
  r == 1 ? qzv_renum = !qzv_renum :
  r >= 2 && r <= 6 ? qzv_range = (r - 1) * 6 :
  // the analyser (step 5; ReEQ's menu 4085-4131, its decode 4140-4171): a new source, size or window clears the peaks
  // as ReEQ's does; the peaks toggle too
  r >= 20 && r <= 26 ? ( qzv_an_mode = r - 20; rk_spectrum.set_show_peaks(qzv_an_peaks); ) :
  r >= 27 && r <= 29 ? qzv_an_disp = r - 27 :
  r >= 30 && r <= 32 ? qzv_an_ceil = r - 30 :
  r >= 33 && r <= 35 ? qzv_an_floor = r - 33 :
  r >= 36 && r <= 40 ? qzv_an_tilt = r - 36 :
  r >= 41 && r <= 44 ? ( qzv_an_win = r - 41; rk_spectrum.set_show_peaks(qzv_an_peaks); ) :
  r >= 45 && r <= 48 ? ( qzv_an_fft = r - 45; rk_spectrum.set_show_peaks(qzv_an_peaks); ) :
  r >= 49 && r <= 51 ? qzv_an_decay = r - 49 :
  r == 52 ? qzv_an_pre = !qzv_an_pre :
  r == 53 ? ( qzv_an_peaks = !qzv_an_peaks; rk_spectrum.set_show_peaks(qzv_an_peaks); ) :
  r == 54 ? qzv_an_piano = !qzv_an_piano :
  r == 55 ? qzv_an_phase = !qzv_an_phase :
  r == 56 ? qzg_an_frz = !qzg_an_frz :
  // the native looks (step 6): picking one while a suite theme shows picks NATIVE too, as the theme panel's NATIVE row
  // does (for every instance, the house rule) and ends this instance's lock
  r >= 57 && r <= 62 ? (
    qzv_nlook = r - 57;
    rkth_active() ? ( rkth_native_pick(1); rkth_locked = 0; );
  ) :
  // the link group (step 6): the slider, automated; rk_gmem_link watches the group before it joins (its LIVENESS)
  r >= 63 && r <= 79 ? qzg_set(219, r - 63) :
  r == 80 ? qzg_zero_all();            // Zero all gains (2026-11-03)
);
// a row of a pick list: ticked when it is the current value; last ends the submenu
function qzg_m_row(lbl, cur, v, last) (
  strcat(#qzg_m, cur == v ? (last ? "|<!" : "|!") : (last ? "|<" : "|"));
  strcat(#qzg_m, lbl);
);
// the Analyser submenu (ReEQ's, 4085-4131, plus Quezy's decay, piano, peaks, phase and freeze rows; items 8..44)
function qzg_an_menu() (
  strcat(#qzg_m, "|>Analyser|>Source");
  qzg_m_row("Full", qzv_an_mode, 0, 0); qzg_m_row("Mid", qzv_an_mode, 1, 0); qzg_m_row("Side", qzv_an_mode, 2, 0);
  qzg_m_row("Mid + Side", qzv_an_mode, 3, 0); qzg_m_row("Left", qzv_an_mode, 4, 0); qzg_m_row("Right", qzv_an_mode, 5, 0);
  qzg_m_row("Left + Right", qzv_an_mode, 6, 1);
  strcat(#qzg_m, "|>Display");
  qzg_m_row("Fill", qzv_an_disp, 0, 0); qzg_m_row("Line", qzv_an_disp, 1, 0); qzg_m_row("Heat", qzv_an_disp, 3, 0);
  qzg_m_row("None", qzv_an_disp, 2, 1);
  strcat(#qzg_m, "|>Range");
  qzg_m_row("Ceiling 0 dB", qzv_an_ceil, 0, 0); qzg_m_row("Ceiling +20 dB", qzv_an_ceil, 1, 0); qzg_m_row("Ceiling +40 dB", qzv_an_ceil, 2, 0);
  strcat(#qzg_m, "|");
  qzg_m_row("Floor -90 dB", qzv_an_floor, 0, 0); qzg_m_row("Floor -140 dB", qzv_an_floor, 1, 0); qzg_m_row("Floor -200 dB", qzv_an_floor, 2, 1);
  strcat(#qzg_m, "|>Tilt");
  qzg_m_row("0 dB/oct", qzv_an_tilt, 0, 0); qzg_m_row("1.5 dB/oct", qzv_an_tilt, 1, 0); qzg_m_row("3 dB/oct", qzv_an_tilt, 2, 0);
  qzg_m_row("4.5 dB/oct", qzv_an_tilt, 3, 0); qzg_m_row("6 dB/oct", qzv_an_tilt, 4, 1);
  strcat(#qzg_m, "|>Window");
  qzg_m_row("Hamming", qzv_an_win, 0, 0); qzg_m_row("Blackman-Harris", qzv_an_win, 1, 0); qzg_m_row("Blackman", qzv_an_win, 2, 0);
  qzg_m_row("Rectangular", qzv_an_win, 3, 1);
  strcat(#qzg_m, "|>FFT size");
  qzg_m_row("2048", qzv_an_fft, 0, 0); qzg_m_row("4096", qzv_an_fft, 1, 0); qzg_m_row("8192", qzv_an_fft, 2, 0); qzg_m_row("16384", qzv_an_fft, 3, 1);
  strcat(#qzg_m, "|>Decay");
  qzg_m_row("Slow", qzv_an_decay, 0, 0); qzg_m_row("Medium", qzv_an_decay, 1, 0); qzg_m_row("Fast", qzv_an_decay, 2, 1);
  strcat(#qzg_m, "|>Smoothing");       // ReEQ 2's (2026-10-31): the trace smoothed over a fraction of an octave
  qzg_m_row("Off", qzv_an_smooth, 0, 0); qzg_m_row("1/48 octave", qzv_an_smooth, 1, 0); qzg_m_row("1/24 octave", qzv_an_smooth, 2, 0);
  qzg_m_row("1/12 octave", qzv_an_smooth, 3, 0); qzg_m_row("1/6 octave", qzv_an_smooth, 4, 1);
  strcat(#qzg_m, "|");
  qzg_m_row("Pre-EQ trace", qzv_an_pre ? 1 : 0, 1, 0); qzg_m_row("Peaks", qzv_an_peaks ? 1 : 0, 1, 0);
  qzg_m_row("Piano keys", qzv_an_piano ? 1 : 0, 1, 0); qzg_m_row("Phase curve", qzv_an_phase ? 1 : 0, 1, 0);
  qzg_m_row("Freeze", qzg_an_frz ? 1 : 0, 1, 1);
);
function qzg_graph_menu() local(r, j) (
  gfx_x = mx; gfx_y = my;
  strcpy(#qzg_m, "#Version: "); strcat(#qzg_m, #qz_ver); strcat(#qzg_m, "||");
  strcat(#qzg_m, qzv_renum ? "!Number bands left to right||>Range" : "Number bands left to right||>Range");
  j = 1;
  loop(5,                              // the number after the escape through %d: "\xb16" would eat the 6 (wiki 1.15)
    sprintf(#qzg_t, qzg_r == j * 6 ? (j == 5 ? "|<!\xc2\xb1%d dB" : "|!\xc2\xb1%d dB") : (j == 5 ? "|<\xc2\xb1%d dB" : "|\xc2\xb1%d dB"), j * 6);
    strcat(#qzg_m, #qzg_t);
    j += 1;
  );
  strcat(#qzg_m, "|");                // a separator before the Analyser
  qzg_an_menu();
  strcat(#qzg_m, "|>Native look");    // items 45..50; no tick while a suite theme shows (the look is not on screen)
  j = qzg_themed ? -1 : qzv_nlook;
  qzg_m_row("Midnight", j, 0, 0); qzg_m_row("Carbon", j, 1, 0); qzg_m_row("Aurora", j, 2, 0);
  qzg_m_row("Ember", j, 3, 0); qzg_m_row("Paper", j, 4, 0); qzg_m_row("White", j, 5, 1);
  // the link group (step 6, spec §6): Off, 1..16; a group another Quezy is running is marked "in use" (its heartbeat,
  // rk_gmem_link's last cell of the group's block, stamped within the last 1.5 s, as the library's own menu dots)
  strcat(#qzg_m, "||>Link group");    // items 51..67
  qzg_m_row("Off", qz_link | 0, 0, 0);
  j = 1;
  loop(16,
    sprintf(#qzg_t, (qz_link | 0) != j && time_precise() - gmem[rk_link_base + (j - 1) * rk_link_blk + rk_link_blk - 1] < 1.5
                    ? "Group %d  (in use)" : "Group %d", j);
    qzg_m_row(#qzg_t, qz_link | 0, j, j == 16);
    j += 1;
  );
  strcat(#qzg_m, "||Zero all gains   (0 key)");   // the last item: 80 after qzg_graph_pick's decode
  r = qzg_menu(#qzg_m);
  r ? qzg_graph_pick(r) : qzg_mkind = 2;  // the answer comes from rkm_run (qzg_window's tail)
);

// ---- layout, top down: the graph, the band bar, the editor strip, the output bar (the user, 2026-10-20: the output
//      section in an always-visible bar at the bottom, nothing over the curve). Release 1's editor is one column,
//      104 px open / 26 folded at every width (the mock's 130 / 226 hold release 2's dynamics). The output bar is one
//      row where its knobs and chips fit (about 640 px wide with auto gain's two chips), two below. The graph takes
//      what is left. ----
function qzg_layout() local(s) (
  s = qzg_s;
  qzg_agw = qzg_chip_w("AUTO -24.0");          // auto gain's chip at its widest reading, and SET
  qzg_stw = qzg_chip_w("SET");
  qzg_wide = gfx_w >= (20 + 5 * 61 - 6 + 212 + 12) * s + qzg_agw + qzg_stw;
  qzg_obh = qzg_wide ? 34 * s : 58 * s;                        // the output bar, its 4 px bottom margin included
  qzg_edh = 104 * s;
  // the editor folds by itself before the graph gets too short, unless it was opened by hand in this short window
  // (qzg_fopen, this session only: the fields must stay reachable at every size, wiki 4.11)
  qzg_short = gfx_h - 36 * s - qzg_obh - qzg_edh < 150 * s;
  !qzg_short ? qzg_fopen = 0;
  qzg_fold = qzv_fold || (qzg_short && !qzg_fopen);
  qzg_eh = qzg_fold ? 26 * s : qzg_edh;
  qzg_gx = 0; qzg_gy = 0; qzg_gw = max(1, gfx_w);
  qzg_gh = max(80 * s, gfx_h - 36 * s - qzg_eh - qzg_obh);
  qzg_ghalf = max(10, qzg_gh / 2 - 34 * s);
  qzg_r = qzv_range >= 6 && qzv_range <= 30 ? floor(qzv_range / 6 + 0.5) * 6 : 24;
  qzg_bby = qzg_gh + 8 * s;
  qzg_edy = qzg_gh + 32 * s;
  qzg_oby = qzg_edy + qzg_eh + 4 * s;
  qzg_gbot = qzg_gh;                                            // where the graph stops taking the mouse
);

// ---- drawing: graph ----
// the graph's vertical gradient (Midnight #151b28 -> #0d1017) in 24 solid bands: a dark run is under 18 colour steps,
// so no band shows, and 24 rects cost a fraction of a per-pixel gradient
function qzg_draw_backdrop() local(j, t, y0, y1, r0, g0, b0, r1, g1, b1) (
  qzg_col(qzg_c_win, 1); gfx_rect(0, qzg_gy + qzg_gh, gfx_w, gfx_h - qzg_gy - qzg_gh);
  r0 = (qzg_p_g0 / 65536) | 0; g0 = ((qzg_p_g0 / 256) | 0) & 255; b0 = qzg_p_g0 & 255;
  r1 = (qzg_p_g1 / 65536) | 0; g1 = ((qzg_p_g1 / 256) | 0) & 255; b1 = qzg_p_g1 & 255;
  j = 0; y0 = qzg_gy;
  loop(24,
    t = (j + 0.5) / 24; y1 = qzg_gy + floor(qzg_gh * (j + 1) / 24 + 0.5);
    gfx_set((r0 + (r1 - r0) * t) / 255, (g0 + (g1 - g0) * t) / 255, (b0 + (b1 - b0) * t) / 255, 1);
    gfx_rect(qzg_gx, y0, qzg_gw, y1 - y0);
    y0 = y1; j += 1;
  );
);
function qzg_draw_grid() local(s, f, d, st, lst, gst, x, y, k, m) (
  s = qzg_s;
  m = 10;                              // vertical lines 20..90, 100..900, 1k..9k, then 10k and 20k
  loop(3,
    k = 1;
    loop(9,
      f = k * m;
      f >= 20 ? (
        qzg_col(k == 1 ? qzg_p_gmaj : qzg_p_grid, 1);
        qzg_vline(qzg_f2x(f), qzg_gy, qzg_gy + qzg_gh);
      );
      k += 1;
    );
    m *= 10;
  );
  qzg_col(qzg_p_gmaj, 1); qzg_vline(qzg_f2x(10000), qzg_gy, qzg_gy + qzg_gh);
  qzg_col(qzg_p_grid, 1); qzg_vline(qzg_f2x(20000), qzg_gy, qzg_gy + qzg_gh);
  st = qzg_r <= 12 ? 3 : 6;            // horizontal lines every 3 dB up to +/-12, else 6; labels right-aligned
  gst = lst = st;                      // a short graph thins them: lines 8 px apart at least, labels 16
  loop(4, gst / qzg_r * qzg_ghalf < 8 * s && gst < qzg_r ? gst *= 2; );
  loop(4, lst / qzg_r * qzg_ghalf < 16 * s && lst < qzg_r ? lst *= 2; );
  qzg_font(11 * s, 0);
  d = -qzg_r;
  loop(2 * qzg_r / st + 1,
    y = floor(qzg_d2y(d)) + 0.5;
    d == 0 || abs(d) - floor(abs(d) / gst + 0.001) * gst < 0.01 ? (
      qzg_col(d == 0 ? qzg_p_zero : qzg_p_grid, 1);
      qzg_hline(qzg_gx, qzg_gx + qzg_gw, y);
    );
    d != 0 && abs(d) < qzg_r - 0.01 && abs(d) - floor(abs(d) / lst + 0.001) * lst < 0.01 ? (
      sprintf(#qzg_t, d > 0 ? "+%d" : "%d", d);     // 7 px above its line, right edge 16 px in (the mock)
      qzg_col(qzg_p_lbl, 1); qzg_text_r(#qzg_t, gfx_w - 76 * s, y - 17 * s, 60 * s, 12 * s);
    );
    d += st;
  );
  qzg_col(qzg_p_lbl, 1);
  f = 20;
  loop(9,
    x = qzg_f2x(f);
    qzg_axis(#qzg_t, f);
    qzg_text_c(#qzg_t, x - 20 * s, qzg_gy + qzg_gh - 22 * s, 40 * s, 12 * s);
    f = f == 20 ? 50 : f == 50 ? 100 : f == 100 ? 200 : f == 200 ? 500 : f == 500 ? 1000 : f == 1000 ? 2000 :
        f == 2000 ? 5000 : 10000;
  );
);
// Translucent fills are painted one column at a time, each column once: quads that share an edge would double their
// alpha there and stripe the fill. Columns are 1 px up to a 720 px wide graph and wider beyond, so a full-screen window
// costs what a normal one does.
function qzg_cols() ( qzg_colw = max(1, ceil(qzg_gw / 720)); min(ceil(qzg_gw / qzg_colw), QZG_NCOL) | 0; );
// This pass's x for every drawn point, and for each column edge i (x = qzg_gx + i * qzg_colw) the first point at or
// right of it (qzg_cj) and where the edge sits between that point and the one before (qzg_ct, 0..1). Set on every
// drawn pass after the geometry and the curves: the window and the two strips share these and draw at their own widths.
function qzg_xmap() local(n, i, j, x, jj) (
  j = 0; loop(qzg_np, qzg_px[j] = qzg_f2x(qzg_fq[j]); j += 1; );
  n = qzg_cols(); i = 0; j = 0;
  loop(n + 1,
    x = qzg_gx + i * qzg_colw;
    while (j < qzg_np && qzg_px[j] < x ? ( j += 1; 1; ) : 0;);
    qzg_cj[i] = j;
    jj = max(1, min(qzg_np - 1, j));
    qzg_ct[i] = max(0, min(1, (x - qzg_px[jj - 1]) / max(0.000001, qzg_px[jj] - qzg_px[jj - 1])));
    i += 1;
  );
);
// a drawn row's dB at column edge i, between the points either side of it
function qzg_edge(row, i) local(j) ( j = max(1, min(qzg_np - 1, qzg_cj[i])); row[j - 1] + (row[j] - row[j - 1]) * qzg_ct[i]; );
// A drawn row's lowest and highest dB over column i (its two edges and every point inside), into qzg_xlo / qzg_xhi:
// a fill reaches the depth of a bell or notch narrower than its column (a sample at the column's middle missed it).
function qzg_cext(row, i) local(j, v) (
  qzg_xlo = qzg_xhi = qzg_edge(row, i);
  v = qzg_edge(row, i + 1); qzg_xlo = min(qzg_xlo, v); qzg_xhi = max(qzg_xhi, v);
  j = qzg_cj[i];
  loop(qzg_cj[i + 1] - j, v = row[j]; qzg_xlo = min(qzg_xlo, v); qzg_xhi = max(qzg_xhi, v); j += 1; );
);
// A drawn row as a polyline's vertices, into qzg_kx / qzg_ky (returns how many): a point closer than a pixel to the last
// vertex kept is skipped (a band's block packs points far tighter than that; a deep notch's points are many pixels apart
// in height, so its plunge keeps every one), so no skipped point lies a pixel or more off the line; the first and the
// last points are always kept. Every polyline (the summed line and its glow, the dashed lines, the strip) draws these.
function qzg_poly(row) local(j, n, x, y) (
  n = 0; j = 0;
  loop(qzg_np,
    x = qzg_px[j]; y = qzg_d2y(row[j]);
    n == 0 || j == qzg_np - 1 || (x - qzg_kx[n - 1]) * (x - qzg_kx[n - 1]) + (y - qzg_ky[n - 1]) * (y - qzg_ky[n - 1]) >= 1 ? (
      qzg_kx[n] = x; qzg_ky[n] = y; n += 1;
    );
    j += 1;
  );
  n;
);
// the window's backdrop colour at y (qzg_draw_backdrop's 24 bands), opaque
function qzg_plate_at(y) local(j) (
  j = max(0, min(23, floor((y - qzg_gy) / max(1, qzg_gh) * 24)));
  qzg_lerpc(qzg_p_g0, qzg_p_g1, (j + 0.5) / 24);
);
// The kept polyline (qzg_poly, its n vertices) in placement p's pattern along its length (qzg_dpat, times the scale:
// Mid long dashes, Side dots, Left dash-dot, Right dash-dot-dot), wd px wide, in colour c (opaque: qzg_aline overlaps its
// core and edges); a segment with both ends at or below fl is skipped (a Bypassed outline leaves out its run along the
// graph's floor) but still counts toward the pattern's phase. ko >= 0: each dash first cuts its own place, a line
// width longer at both ends, in the plate's colour (0 the window's backdrop at that height, 1 the strip's plate), so the
// pattern shows over a placement's total in a colour close to the band's own (the review: a red band on Right).
function qzg_dash_poly(n, wd, fl, p, c, ko) local(j, x0, y0, x1, y1, l, t0, t1, ph, acc, pt, per, i, g, ka, kb) (
  pt = qzg_dpat + 8 * max(0, min(4, p | 0)); per = pt[pt[0]] * qzg_s;
  j = 1; acc = 0;
  loop(n - 1,
    x0 = qzg_kx[j - 1]; y0 = qzg_ky[j - 1]; x1 = qzg_kx[j]; y1 = qzg_ky[j];
    l = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0));
    !(y0 >= fl && y1 >= fl) ? (
      t0 = 0; g = 0;
      while (t0 < l && g < 4096 ? (     // walk the segment piece by piece (a notch's plunge is hundreds of px long)
        ph = acc + t0 - floor((acc + t0) / per) * per;
        i = 1; while (i < pt[0] && ph >= pt[i] * qzg_s ? ( i += 1; 1; ) : 0;);
        t1 = min(l, t0 + pt[i] * qzg_s - ph);
        (i & 1) && t1 > t0 ? (
          ko >= 0 ? (
            ka = max(0, t0 - qzg_bw); kb = min(l, t1 + qzg_bw);
            qzg_col(ko ? qzg_p_strip : qzg_plate_at(y0 + (y1 - y0) * (t0 + t1) * 0.5 / l), 1);
            qzg_aline(x0 + (x1 - x0) * ka / l, y0 + (y1 - y0) * ka / l, x0 + (x1 - x0) * kb / l, y0 + (y1 - y0) * kb / l, wd);
          );
          qzg_col(c, 1);
          qzg_aline(x0 + (x1 - x0) * t0 / l, y0 + (y1 - y0) * t0 / l, x0 + (x1 - x0) * t1 / l, y0 + (y1 - y0) * t1 / l, wd);
        );
        t0 = max(t1, t0 + 0.01); g += 1;
        1;
      ) : 0;);
    );
    acc += l;
    j += 1;
  );
);
// A placement's own colour for its total (ReEQ's 4299-4308: Mid green, Side cyan, Left yellow, Right red), deeper on a
// light graph, where ReEQ's yellow and cyan would wash out
function qzg_pcol(p) (
  qzg_p_lt ? ( p == 1 ? 0x3A9A40 : p == 2 ? 0x1898AC : p == 3 ? 0xB08A0C : 0xC03434 )
           : ( p == 1 ? 0x5CBE62 : p == 2 ? 0x5BECFC : p == 3 ? 0xF0C91B : 0xD54142 );
);
// Each placement's total (qzg_pt) that has an On band, as a solid line wd px wide in its colour: drawn under the
// bands' own patterned lines, so a placement with one band shows its pattern over its colour
function qzg_draw_ptot(wd) local(p, n, j) (
  p = 0;
  loop(4,
    qzg_pon[p] ? (
      qzg_col(qzg_pcol(p + 1), 1); n = qzg_poly(qzg_pt + p * QZG_NS); j = 1;
      loop(n - 1, qzg_aline(qzg_kx[j - 1], qzg_ky[j - 1], qzg_kx[j], qzg_ky[j], wd); j += 1; );
    );
    p += 1;
  );
);
// a Bypassed band's line colour: its own colour toward the plate's middle, opaque (qzg_aline), so a band that plays
// nothing reads weaker than one that does (Quezy's On Stereo bands are faint fills, no outline)
function qzg_byp_col(k) ( qzg_lerpc(qzg_p_pm, qzg_bcol(k), qzg_p_lt ? (qzg_sel[k] ? 0.9 : 0.75) : (qzg_sel[k] ? 0.85 : 0.6)); );
// An On band's fill from 0 dB to its curve, column by column (each column from 0 dB to the farthest the curve reaches
// inside it): light in the window (a cut's fainter, it would be a slab down to the floor), near ReEQ's 0.5 on a strip
function qzg_band_fill(k, st) local(row, n, w, i, x, y0, y1, z) (
  row = qzg_cv + k * QZG_NS; z = qzg_d2y(0);
  qzg_bandcol(k, qzg_is_cut(qzg_shape(k)) ? (st ? (qzg_sel[k] ? 0.30 : 0.20) : (qzg_sel[k] ? 0.10 : 0.05))
                                          : (st ? (qzg_sel[k] ? 0.60 : 0.45) : (qzg_sel[k] ? 0.22 : 0.12)));
  n = qzg_cols(); w = qzg_colw; i = 0;
  loop(n,
    qzg_cext(row, i); x = qzg_gx + i * w;
    y0 = min(qzg_d2y(qzg_xhi), z); y1 = max(qzg_d2y(qzg_xlo), z);
    y1 - y0 >= 2 ? gfx_rect(x, y0, w, y1 - y0 + 0.5);
    i += 1;
  );
);
// An On Stereo band's outline in its own colour, opaque (its joints would double a translucent line): on a strip
// toward the plate (a full-colour 1 px edge beside its fill), in the window full colour, 1.4 px; its run along the floor
// left out, and its flat runs along 0 dB too (drawn over the summed curve, every band would paint the 0 dB line in its
// colour edge to edge). The band look (qzg_lb, set per surface: 0 Fill, 1 Lines, 2 Both) decides who draws it.
function qzg_band_edge(k, st) local(row, j, n, fl, z) (
  row = qzg_cv + k * QZG_NS; fl = qzg_gy + qzg_gh - 0.5; z = qzg_d2y(0);
  qzg_col(st ? qzg_lerpc(qzg_p_strip, qzg_bcol(k), qzg_sel[k] || qzg_lb == 1 ? 1 : 0.8)
             : qzg_lerpc(qzg_p_pm, qzg_bcol(k), qzg_sel[k] ? 1 : 0.9), 1);
  n = qzg_poly(row); j = 1;
  loop(n - 1,
    !(qzg_ky[j - 1] >= fl && qzg_ky[j] >= fl) && !(abs(qzg_ky[j - 1] - z) < 0.75 && abs(qzg_ky[j] - z) < 0.75) ?
      qzg_aline(qzg_kx[j - 1], qzg_ky[j - 1], qzg_kx[j], qzg_ky[j], (st ? 1 : 1.4) * qzg_s);
    j += 1;
  );
);
// The outlines over the summed curve (rk_curve's order: a band that overlaps no other IS the sum over its span, so an
// outline under the summed line would vanish and Lines would look empty): every On Stereo band's, in the window's
// Lines and Both and the strip's Lines.
function qzg_draw_edges(st) local(k) (
  qzg_lb == 1 || (qzg_lb == 2 && !st) ? (
    k = 0; loop(16, qzg_on(k) && qzg_place(k) == 0 && qzg_cvon[k] ? qzg_band_edge(k, st); k += 1; );
  );
);
// One band's curve. On: its fill (Stereo bands) or a line in its placement's pattern (Mid / Side / Left / Right).
// Bypassed: its real shape as a thin dimmed line, no fill (ReEQ 1958-2032: Disabled bands keep their outline),
// patterned for Mid / Side / Left / Right; its run along the floor left out. st: a strip (ReEQ's strip is its window
// drawn small: every band's fill at 0.5 with its own line on top), so the fill is stronger there, a Stereo band gets a
// thin edge in its colour, and the lines are thinner (the strip fills its Mid / Side / Left / Right bands itself, under
// the totals: qzg_embed).
function qzg_draw_band_curve(k, st) local(row, j, n, fl) (
  row = qzg_cv + k * QZG_NS; fl = qzg_gy + qzg_gh - 0.5;
  !qzg_on(k) ? (
    n = qzg_poly(row);
    qzg_place(k) == 0 ? (
      qzg_col(qzg_byp_col(k), 1); j = 1;
      loop(n - 1,
        !(qzg_ky[j - 1] >= fl && qzg_ky[j] >= fl) ? qzg_aline(qzg_kx[j - 1], qzg_ky[j - 1], qzg_kx[j], qzg_ky[j], (st ? 1 : 1.4) * qzg_s);
        j += 1;
      );
    ) : qzg_dash_poly(n, (st ? 1 : 1.4) * qzg_s, fl, qzg_place(k), qzg_byp_col(k), -1);   // under the totals: no cuts
  ) : qzg_place(k) == 0 ? (
    qzg_lb != 1 ? qzg_band_fill(k, st);
    st && qzg_lb == 2 ? qzg_band_edge(k, st);   // the strip's Both: its edge under the summed line (the look before
                                                // the looks); every other outline is drawn over it (qzg_draw_edges)
  ) : (
    qzg_dash_poly(qzg_poly(row), (st ? 1.2 : 1.8) * qzg_s, 1000000000, qzg_place(k), qzg_bcol(k), st ? 1 : 0);
  );
);
// the summed curve: its fill (a vertical fade, 0.02 at 0 dB up to 0.19 at 60 % of the range: the mock's gradient), a
// soft glow (faint smoothed lines offset along each segment's normal, fading outwards) and the 2.4 px line itself
function qzg_draw_sum() local(i, n, w, z, s, j, x0, y0, x1, y1, h, a1, nx, ny, l, o, ng, ar, ag, ab) (
  s = qzg_s; z = qzg_d2y(0);
  n = qzg_cols(); w = qzg_colw; i = 0;
  loop(n,                              // each column's farthest reach from 0 dB
    qzg_cext(qzg_sum, i); qzg_cy[i] = qzg_d2y(abs(qzg_xlo) > abs(qzg_xhi) ? qzg_xlo : qzg_xhi); i += 1;
  );
  ar = ((qzg_p_acc / 65536) | 0) / 255; ag = (((qzg_p_acc / 256) | 0) & 255) / 255; ab = (qzg_p_acc & 255) / 255;
  i = 0;
  loop(n,
    h = abs(qzg_cy[i] - z);
    h >= 2 ? (
      a1 = 0.02 + 0.17 * min(1, h / max(1, qzg_ghalf) / 0.6);
      qzg_cy[i] < z ? gfx_gradrect(qzg_gx + i * w, qzg_cy[i], w, h, ar, ag, ab, a1, 0, 0, 0, 0, 0, 0, 0, (0.02 - a1) / h)
                    : gfx_gradrect(qzg_gx + i * w, z, w, h, ar, ag, ab, 0.02, 0, 0, 0, 0, 0, 0, 0, (a1 - 0.02) / h);
    );
    i += 1;
  );
  ng = max(2, floor(4 * s + 0.5));     // glow lines one pixel apart at any scale (spaced wider, they stripe)
  n = qzg_poly(qzg_sum); j = 1;
  loop(n - 1,
    x0 = qzg_kx[j - 1]; y0 = qzg_ky[j - 1]; x1 = qzg_kx[j]; y1 = qzg_ky[j];
    l = sqrt((x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0));
    l > 0.01 ? (
      nx = -(y1 - y0) / l; ny = (x1 - x0) / l;
      o = 1;
      loop(ng,
        qzg_col(qzg_p_acc, 0.11 * (1 - o / (ng + 1)));
        gfx_line(x0 + nx * o, y0 + ny * o, x1 + nx * o, y1 + ny * o, 1);
        gfx_line(x0 - nx * o, y0 - ny * o, x1 - nx * o, y1 - ny * o, 1);
        o += 1;
      );
    );
    j += 1;
  );
  qzg_col(qzg_p_curve, 1);
  j = 1;
  loop(n - 1, qzg_aline(qzg_kx[j - 1], qzg_ky[j - 1], qzg_kx[j], qzg_ky[j], 2.4 * s); j += 1; );
);
// The window dot's resting radius in the node look nl: a Badge or a Ring 9.5 px (Quezy's dot before the looks), a Dot
// 6 px; it grows 12 % under the pointer (the hover ramp, qzg_window). Selection ring, placement arcs and stems sit
// around it.
function qzg_dot_r0(nl) ( (nl == 1 ? 6 : 9.5) * qzg_s; );
function qzg_dot_r(k) ( qzg_dot_r0(qzg_look(qzv_wn)) * (1 + 0.12 * qzg_hv[k]); );
// The dot's body in the window's node look, painted by the library (rk_curve_node_paint_ex: the user, 2026-10-26,
// "Library, upgraded": Quezy's dot is the library's Badge): the band's number inside a Badge or a Ring, none on a Dot;
// a Bypassed band at the library's off strength (hollow in a Badge). The Ring gets `on` (its full body and bright rim);
// the selection itself is Quezy's pulsing ring (qzg_draw_dot), so the Badge and the Dot never draw the library's.
function qzg_dot_body(k, x, y) local(nl, c, rad) (
  nl = qzg_look(qzv_wn); c = qzg_bcol(k);
  rad = qzg_dot_r0(nl) / (nl == 2 ? RKCV_BADGE_K : nl == 1 ? 0.85 : 1);   // the disc the library draws: qzg_dot_r0
  rk_curve_style(0, nl);
  sprintf(#qzg_t, "%d", qzg_dn[k] + 1);
  rk_curve_node_paint_ex(x, y, rad, qzg_hv[k], nl == 0, qzg_on(k) ? 1 : 0.30,
                         ((c / 65536) | 0) / 255, (((c / 256) | 0) & 255) / 255, (c & 255) / 255, nl == 1 ? -1 : #qzg_t);
);
function qzg_draw_dot(k) local(s, x, y, on, pl, r, t, j, tx, ty) (
  s = qzg_s;
  x = qzg_f2x(qzg_v(k, 3)); y = qzg_node_y(k); on = qzg_on(k); pl = qzg_place(k);
  r = qzg_dot_r(k);
  qzg_sel[k] ? (                       // the selection ring: 5 px from 3.5 px outside the dot (the primary one pulses)
    qzg_bandcol(k, qzg_p_lt ? (k == qzg_prim ? 0.65 + 0.25 * sin(4 * qzg_now) : 0.6)
                            : (k == qzg_prim ? 0.4 + 0.19 * sin(4 * qzg_now) : 0.33));
    t = 0; loop(max(1, floor(5 * s + 0.5)), gfx_circle(x, y, qzg_dot_r0(qzg_look(qzv_wn)) + 3.5 * s + t, 0, 1); t += 1; );
  );
  // the placement on the dot itself, ReEQ's draw_node_stereo (1729-1770; the user, 2026-10-21: "When M is the
  // placement it bubbles the dot. For sides, they are on the sides ... i need that"): quarter arcs just outside it, Mid
  // top and bottom, Side left and right, Left the left one, Right the right one; in the plate's text colour (ReEQ's white
  // on its black plate), 1.5 px, growing with the dot (gfx_arc: radians from 12 o'clock, clockwise)
  pl > 0 ? (
    qzg_col(qzg_p_tx, 1); t = r + 4.5 * s;
    pl == 1 ? ( qzg_arcw(x, y, t, -0.7854, 0.7854, 1.5 * s); qzg_arcw(x, y, t, 2.3562, 3.9270, 1.5 * s); );
    pl == 2 || pl == 3 ? qzg_arcw(x, y, t, 3.9270, 5.4978, 1.5 * s);
    pl == 2 || pl == 4 ? qzg_arcw(x, y, t, 0.7854, 2.3562, 1.5 * s);
  );
  qzg_dot_body(k, x, y);
  pl > 0 ? (                           // placement tag, on whole pixels; moved aside when a lower slot's tag sits there
    ty = floor(y - 21 * s + 0.5); tx = 0;
    j = 0;
    loop(k,
      qzg_live(j) && qzg_place(j) > 0 && abs(qzg_f2x(qzg_v(j, 3)) - x) < 4 * s && abs(qzg_node_y(j) - y) < 4 * s ?
        tx += floor(17 * s + 0.5);
      j += 1;
    );
    tx = floor(x + 7 * s + 0.5) + tx + 15 * s > gfx_w - 2 * s ? floor(x - 22 * s + 0.5) - tx : floor(x + 7 * s + 0.5) + tx;
    tx = max(2 * s, tx);
    qzg_p_lt ? ( qzg_obox(tx, ty, 15 * s, 14 * s, 4 * s, qzg_bcol(k), qzg_bcol(k), 1); qzg_font(11 * s, 1); qzg_col(0x0f1218, 1); )
            : ( qzg_obox(tx, ty, 15 * s, 14 * s, 4 * s, qzg_p_inset, qzg_bcol(k), 1); qzg_font(11 * s, 1); qzg_bandcol(k, 1); );
    qzg_text_c(pl == 1 ? "M" : pl == 2 ? "S" : pl == 3 ? "L" : "R", tx, ty, 15 * s, 14 * s);
  );
);
// A stem (ReEQ draw_node 1845-1888): from the dot's edge to where the band's own curve passes at its frequency, in its
// colour (dimmed for a Bypassed band, like its outline); a notch's goes to the floor. Shows where a cut, shelf, Tilt or
// Pultec dot (drawn at its Q height or gain) meets its curve. Not for Peak / Bell Prop Q: Quezy draws their dot at gain x
// Scale, on the curve (ReEQ's "Scale != 100" clause exists only because its node sits at the raw gain). Nothing when
// the curve passes inside the dot (Band Pass, All Pass, Flat Gain).
function qzg_draw_stem(k) local(s, sh, f, x, y, yc, r) (
  s = qzg_s; sh = qzg_shape(k);
  sh != 0 && sh != 14 ? (
    f = qzg_v(k, 3); x = qzg_f2x(f); y = qzg_node_y(k);
    yc = sh == 7 ? qzg_gy + qzg_gh : qzg_d2y(qzg_magdb(k, f));   // the display filter's own value (qzg_d2y clamps)
    r = qzg_dot_r(k);                                            // the dot's radius this pass (qzg_draw_dot)
    abs(yc - y) > r ? (
      qzg_col(qzg_on(k) ? qzg_bcol(k) : qzg_byp_col(k), 1);
      qzg_aline(x, yc > y ? y + r : y - r, x, yc, 1.6 * s);
    );
  );
);
function qzg_draw_tag(k) local(s, x, y, w, h, tx, ty, sh) (    // the value tag while a dot is dragged
  s = qzg_s; sh = qzg_shape(k);
  x = qzg_f2x(qzg_v(k, 3)); y = qzg_node_y(k);
  qzg_note(#qzg_t, qzg_v(k, 3)); strcat(#qzg_t, " \xc2\xb7 ");
  qzg_ftxt(#qzg_t2, qzg_v(k, 3)); strcat(#qzg_t, #qzg_t2);
  qzg_has_gain(sh) ? ( sprintf(#qzg_t2, " \xc2\xb7 %+.1f dB", qzg_v(k, 4)); strcat(#qzg_t, #qzg_t2); );
  qzg_has_q(sh) ? ( qzg_qtxt(#qzg_t3, qzg_v(k, 5)); sprintf(#qzg_t2, sh == 10 ? " \xc2\xb7 D %s" : " \xc2\xb7 Q %s", #qzg_t3);
                    strcat(#qzg_t, #qzg_t2); );
  qzg_font(11 * s, 0);
  w = qzg_tw(#qzg_t) + 16 * s; h = 18 * s;
  ty = y - 40 * s;
  ty < 32 * s ? ty = y + 22 * s;
  ty + h > qzg_gbot - 4 * s ? ty = max(32 * s, y - 40 * s);
  tx = max(4 * s, min(gfx_w - 16 * s - w, x - w / 2));
  qzg_obox(tx, ty, w, h, h / 2, qzg_p_tag, qzg_bcol(k), 1);
  qzg_col(qzg_p_tx, 1); qzg_text_c(#qzg_t, tx, ty, w, h);
);
// The phase curve (spec §8): the summed phase of the On Stereo bands (the bands on the summed curve) at the base
// points, wrapped to +-180, rebuilt when the curves change (qzg_cgen) and the curve shows; the display bank is
// snapped on its targets (qzg_retarget), so this is the phase of what plays
function qzg_phase_curve() local(j, k, ph, f) (
  qzg_ph_gen !== qzg_cgen ? (
    qzg_ph_gen = qzg_cgen;
    j = 0;
    loop(QZG_NB,
      f = qzg_fs[j]; ph = 0; k = 0;
      loop(16, qzg_on(k) && qzg_place(k) == 0 && qzg_cvon[k] ? ph += qzg_phase_k(k, f); k += 1; );
      ph -= 2 * $pi * floor(ph / (2 * $pi) + 0.5);
      qzg_phs[j] = ph;
      j += 1;
    );
  );
);
// drawn under the dots: +-180 degrees over the graph's own +-range height (0 degrees on the 0 dB line), a thin line
// in the second text colour, broken where the phase wraps
function qzg_draw_phase() local(s, j, x0, y0, x1, y1, p0, p1) (
  s = qzg_s;
  qzg_phase_curve();
  qzg_col(qzg_p_tx2, 0.7);
  x0 = qzg_f2x(qzg_fs[0]); p0 = qzg_phs[0]; y0 = qzg_gy + qzg_gh / 2 - p0 / $pi * qzg_ghalf;
  j = 1;
  loop(QZG_NB - 1,
    x1 = qzg_f2x(qzg_fs[j]); p1 = qzg_phs[j]; y1 = qzg_gy + qzg_gh / 2 - p1 / $pi * qzg_ghalf;
    abs(p1 - p0) < $pi ? qzg_aline(x0, y0, x1, y1, 1.2 * s);
    x0 = x1; y0 = y1; p0 = p1;
    j += 1;
  );
);
// ---- the analyser (build step 5): rk_spectrum, ReEQ's spectrum library, drawn under the grid; the audio side feeds
//      its rings (Quezy_ReaKit.jsfx, qz_an_feed) while a surface asks (qzm_an) ----
function qzg_an_col(i, c, a) ( rk_spectrum.set_color(i, ((c / 65536) | 0) / 255, (((c / 256) | 0) & 255) / 255, (c & 255) / 255, a); );
function qzg_an_shown(st) ( qzv_an_disp != 2 && (!st || qzv_an_strip); );
// What this instance asks the audio side to feed (the mailbox's bits; Quezy_ReaKit.jsfx @block): every pass, window
// and strip, drawn or skipped
function qzg_an_post() (
  // the ghost (ReEQ 2's): the selected band, reacting, listening to a sidechain or a free detector
  qz_ghost = qzg_prim >= 0 && qzg_mode(qzg_prim) >= 3 && qz_dyn_able(qzg_shape(qzg_prim)) &&
             (qz_dyn_listen >= 0.5 || qz_dyp[16 + qzg_prim] < 0.5) ? qzg_prim : -1;
  qzm_an = max(0, min(6, qzv_an_mode | 0)) + (qzv_an_pre || qz_ghost >= 0 ? 8 : 0) + (qzv_an_disp != 2 ? 16 : 0) + (qzv_an_strip ? 32 : 0);
);
// The library's settings for this surface (st = a strip): the graph's own x axis; the ceiling under the top bar and
// the floor above the frequency labels in the window (ReEQ: 10 px from the top, above its labels), the whole canvas
// in a strip; the saved options; the colours, dimmed while a listen plays (ReEQ's 0.5). gfx_texth is part of the
// library's y mapping, so one known font is set first and left.
function qzg_an_apply(st) local(s, yc, yf, fade, lines, heat, a1, a2, ap) (
  s = qzg_s;
  grf_w = gfx_w; grf_h = gfx_h;
  qzg_font(11 * s, 0);
  rk_spectrum.left_margin = qzg_gx; rk_spectrum.right_margin = gfx_w - qzg_gx - qzg_gw;
  yc = st ? 0 : qzg_gy + 30 * s; yf = st ? gfx_h : qzg_gy + qzg_gh - 24 * s;
  rk_spectrum.top_margin = yc; rk_spectrum.bottom_margin = gfx_h - yf - gfx_texth;
  rk_spectrum.ceiling = qzv_an_ceil == 1 ? 20 : qzv_an_ceil == 2 ? 40 : 0;
  rk_spectrum.noise_floor = qzv_an_floor == 1 ? -140 : qzv_an_floor == 2 ? -200 : -90;
  rk_spectrum.tilt = qzv_an_tilt == 0 ? 0 : qzv_an_tilt == 1 ? 1.5 : qzv_an_tilt == 2 ? 3 : qzv_an_tilt == 4 ? 6 : 4.5;
  rk_spectrum.windowtype != max(1, min(4, qzv_an_win + 1)) ? rk_spectrum.set_type(max(1, min(4, qzv_an_win + 1)));
  rk_spectrum.set_fft_size(2048 * 2 ^ max(0, min(3, qzv_an_fft | 0)));
  rk_spectrum.decay_k = qzv_an_decay == 0 ? 0.997 : qzv_an_decay == 2 ? 0.97 : 0.99;
  rk_spectrum.freeze = qzg_an_frz ? 1 : 0;
  lines = qzv_an_disp == 1; heat = qzv_an_disp == 3;
  rk_spectrum.smooth = qzv_an_smooth == 1 ? 1 / 48 : qzv_an_smooth == 2 ? 1 / 24 : qzv_an_smooth == 3 ? 1 / 12 : qzv_an_smooth == 4 ? 1 / 6 : 0;
  rk_spectrum.heat_r0 = 0x5C / 255; rk_spectrum.heat_g0 = 0x34 / 255; rk_spectrum.heat_b0 = 0x56 / 255;   // ReEQ 2's quiet
  fade = qz_l_run ? 0.5 : 1;
  a1 = lines ? 0.85 : heat ? 0.9 : 0.34; a2 = lines ? 0.85 : heat ? 0.8 : 0.30; ap = lines ? 0.75 : 0.26;
  qzg_an_col(0, qzg_p_an1, a1 * fade); qzg_an_col(1, qzg_p_an2, a2 * fade);
  qzg_an_col(2, qzg_p_anp, ap * fade); qzg_an_col(3, qzg_p_anp, ap * 0.8 * fade);
  qzg_an_col(4, qzg_p_anl, lines ? 0.95 : 0.45); qzg_an_col(5, qzg_p_anl, lines ? 0.8 : 0.35);
  rk_spectrum.set_fill(0, heat ? 2 : !lines); rk_spectrum.set_fill(1, heat ? 2 : !lines); rk_spectrum.set_fill(2, !lines);
  rk_spectrum.set_fill(3, !lines); rk_spectrum.set_fill(4, !lines); rk_spectrum.set_fill(5, !lines);
  rk_spectrum.show_peaks = qzv_an_peaks ? 1 : 0;
  rk_spectrum.peak_r = ((qzg_p_tx2 / 65536) | 0) / 255; rk_spectrum.peak_g = (((qzg_p_tx2 / 256) | 0) & 255) / 255;
  rk_spectrum.peak_b = (qzg_p_tx2 & 255) / 255; rk_spectrum.peak_a = 0.55;
);
// The traces (ReEQ 4252-4264): the main one (two for Mid + Side and Left + Right), the pre-EQ pair, the listen pair
// while a listen plays; then ReEQ's fade (4266-4269): the lower half of the range sinks into the plate
function qzg_draw_an(st) local(two, yc, yf, h, c) (
  two = qzv_an_mode == 3 || qzv_an_mode == 6;
  rk_spectrum.draw(0); two ? rk_spectrum.draw(1);
  qz_ghost >= 0 ? (                     // the ghost: the detector's signal, one faint trace in the band's colour
    qzg_an_col(2, qzg_bcol(qz_ghost), 0.30); rk_spectrum.draw(2);
  ) : qzv_an_pre ? ( rk_spectrum.draw(2); two ? rk_spectrum.draw(3); );
  qz_l_run ? ( rk_spectrum.draw(4); two ? rk_spectrum.draw(5); );
  yc = rk_spectrum.top_margin; yf = grf_h - rk_spectrum.bottom_margin - gfx_texth; h = max(2, floor((yf - yc) / 2));
  c = st ? qzg_p_strip : qzg_p_g1;
  gfx_gradrect(qzg_gx, yf - h, qzg_gw, h, ((c / 65536) | 0) / 255, (((c / 256) | 0) & 255) / 255, (c & 255) / 255, 0,
               0, 0, 0, 0, 0, 0, 0, 0.55 / h);
);
// how much of the main traces is still above the floor (0..1): a falling trace keeps the surface redrawing after the
// sound stops, until it has sunk (the redraw skip would otherwise hold it mid-fall)
function qzg_an_tail() local(k, n, m, two) (
  two = qzv_an_mode == 3 || qzv_an_mode == 6; n = rk_spectrum.map_numbins; m = 0; k = 1;
  loop(max(0, n - 1),
    m = max(m, rk_spectrum.bin_y0[k]);
    two ? m = max(m, rk_spectrum.bin_y1[k]);
    k += 1;
  );
  m;
);
// the surface must redraw for the analyser: it shows, is not frozen, and sound fed it within half a second or its
// traces are still falling
function qzg_an_live(st) ( qzg_an_shown(st) && !qzg_an_frz && (qzg_now - qz_an_last < 0.5 || qzg_an_tl > 0.02); );
// The piano keys: ReEQ's (spectrum.jsfx-inc draw_octave / draw_piano, MIT), copied after the user, 2026-10-30: "it just
// doesn't look like a real piano. Can you kind of copy re-EQ's piano?". Per octave, C to the next C on the log axis cut
// in seven equal white keys (sw), 60 px tall; the five black keys half a white wide, from 0.75 of a white, 35 px tall,
// none between E and F; a black key under the pointer wins over the white under it. The key under the pointer greys
// (ReEQ's 0.7) and a tinted column runs down the graph over that note's own span (ReEQ's 0.3, here the accent), and
// the hover readout snaps to its note (ReEQ 2350). Shown while the option is on, along the BOTTOM of the graph above the
// frequency labels (the user, 2026-10-30: "and the piano keys at the bottom"; ReEQ's sit at the top), the black keys
// hanging from the keys' top edge as on a keyboard seen from the player; the note's column runs up the graph from the
// keys. Sizes scale with the window, colours follow the look. qzg_pkf: the note, 0 for none.
function qzg_draw_piano() local(s, y, hw, hb, o, c, cx, sw, xp, k, x0, x1, hk, hx, hwid, hh, hf, semi, gx0, gx1) (
  s = qzg_s; qzg_pkf = 0; hk = 0;
  hw = 60 * s; hb = 35 * s; y = qzg_gy + qzg_gh - 24 * s - hw;
  gx0 = qzg_gx; gx1 = qzg_gx + qzg_gw;
  o = -5;
  loop(12,                             // the octaves of A0 .. A11 (A4 = 440), as ReEQ's draw_piano
    c = 440 * 2 ^ o * 2 ^ (-9 / 12);   // this octave's C
    cx = qzg_f2x(c); sw = (qzg_f2x(c * 2) - cx) / 7;
    cx < gx1 && cx + 7 * sw > gx0 ? (
      // the white keys, then (pointer over a black key first) the hover
      k = 0;
      loop(7,
        xp = cx + k * sw; x0 = max(gx0, floor(xp + 0.5)); x1 = min(gx1, floor(xp + sw - 1 + 0.5));
        x1 > x0 ? ( qzg_col(qzg_p_pkw, 1); gfx_rect(x0, y, x1 - x0, hw); );
        k += 1;
      );
      k = 0;
      loop(6,
        k != 2 && !hk && qzg_in(mx, my, cx + sw * 0.75 + k * sw, y, sw * 0.5, hb) ? (
          hk = 2; hx = cx + sw * 0.75 + k * sw; hwid = sw * 0.5; hh = hb; semi = k == 0 ? 1 : k == 1 ? 3 : k == 3 ? 6 : k == 4 ? 8 : 10;
          hf = c * 2 ^ (semi / 12);
        );
        k += 1;
      );
      k = 0;
      loop(7,
        !hk && qzg_in(mx, my, cx + k * sw, y, sw, hw) ? (
          hk = 1; hx = cx + k * sw; hwid = sw - 1; hh = hw; semi = k == 0 ? 0 : k == 1 ? 2 : k == 2 ? 4 : k == 3 ? 5 : k == 4 ? 7 : k == 5 ? 9 : 11;
          hf = c * 2 ^ (semi / 12);
        );
        k += 1;
      );
      hk == 1 && hf >= c && hf < c * 2 ? (
        x0 = max(gx0, floor(hx + 0.5)); x1 = min(gx1, floor(hx + hwid + 0.5));
        x1 > x0 ? ( qzg_col(qzg_lerpc(qzg_p_pkw, qzg_p_pkb, 0.3), 1); gfx_rect(x0, y, x1 - x0, hh); );
      );
      // the black keys over them
      k = 0;
      loop(6,
        k != 2 ? (
          xp = cx + sw * 0.75 + k * sw; x0 = max(gx0, floor(xp + 0.5)); x1 = min(gx1, floor(xp + sw * 0.5 + 0.5));
          x1 > x0 ? ( qzg_col(qzg_p_pkb, 1); gfx_rect(x0, y, x1 - x0, hb); );
        );
        k += 1;
      );
      hk == 2 && hf >= c && hf < c * 2 ? (
        x0 = max(gx0, floor(hx + 0.5)); x1 = min(gx1, floor(hx + hwid + 0.5));
        x1 > x0 ? ( qzg_col(qzg_lerpc(qzg_p_pkb, qzg_p_pkw, 0.4), 1); gfx_rect(x0, y, x1 - x0, hh); );
      );
    );
    o += 1;
  );
  // the hovered note's column down the graph, over its own span (a note to the next semitone)
  hk && qzg_drag < 0 && !qzg_box ? (
    qzg_pkf = hf;
    x0 = max(gx0, floor(qzg_f2x(hf) + 0.5)); x1 = min(gx1, floor(qzg_f2x(hf * 2 ^ (1 / 12)) + 0.5));
    x1 > x0 ? ( qzg_col(qzg_p_acc, 0.22); gfx_rect(x0, qzg_gy + 30 * s, x1 - x0, max(0, y - 5 * s - (qzg_gy + 30 * s))); );
  );
);
function qzg_draw_hover() local(s, f, w, h, x, y) (           // crosshair and the summed curve's readout
  s = qzg_s;
  f = qzg_pkf > 0 ? qzg_pkf : qzg_x2f(mx);     // over a piano key: that note
  qzg_col(qzg_p_crs, qzg_p_crsa); qzg_vline(qzg_pkf > 0 ? qzg_f2x(f) : mx, 32 * s, qzg_gbot);
  qzg_note(#qzg_t, f); strcat(#qzg_t, " \xc2\xb7 "); qzg_ftxt(#qzg_t2, f); strcat(#qzg_t, #qzg_t2);
  qzg_dbtxt(#qzg_t3, qzg_sum_at(f)); sprintf(#qzg_t2, " \xc2\xb7 %s", #qzg_t3); strcat(#qzg_t, #qzg_t2);   // a zero: "-inf"
  qzg_font(11 * s, 0);
  w = qzg_tw(#qzg_t) + 16 * s; h = 18 * s;
  x = max(4 * s, min(gfx_w - 4 * s - w, mx - w / 2));
  y = qzg_gh - (qzv_an_piano ? 46 + 60 + 6 : 46) * s;   // above the piano keys when they show
  qzg_col(qzg_p_rdo, 1); qzg_pill(x, y, w, h);
  qzg_col(qzg_p_tx, 1); qzg_text_c(#qzg_t, x, y, w, h);
);

// The house link controls (rk_gmem_link's own, as every linked EON plugin: the user, 2026-10-30, "i want the link group
// like all my plugins"): the gear (opens the 16-group grid) and the group badge (click = next group, right-click = the
// grid) at the window's top right; the badge alone in a strip's top right corner (click = next group). The accent as
// 0..1 for the library's calls.
function qzg_lk_rgb() ( qzg_lkr = ((qzg_p_acc / 65536) | 0) / 255; qzg_lkg = (((qzg_p_acc / 256) | 0) & 255) / 255; qzg_lkb = (qzg_p_acc & 255) / 255; );
// the library's widgets still moving (its hover glows, the grid's fade) or the grid open: keep redrawing
function qzg_lk_busy() (
  rk_menu_open || (rk_menu_anim > 0.001 && rk_menu_anim < 0.999) || (rk_gear_ht > 0.001 && rk_gear_ht < 0.999) ||
  (rk_badge_ht > 0.001 && rk_badge_ht < 0.999);
);
// an undo (dir -1) or redo (+1) arrow: an arc with a head, in the text colours, dim when there is nothing to do
function qzg_hist_arrow(cx, cy, r, dir, on, hot) local(oy, ex, ey) (
  qzg_col(!on ? qzg_p_dim : hot ? qzg_p_tx : qzg_p_tx2, !on ? 0.5 : 1);
  oy = cy + r * 0.25;
  gfx_arc(cx, oy, r, -$pi * 0.55, $pi * 0.55, 1);            // over the top (gfx_arc: 0 = up, clockwise)
  gfx_arc(cx, oy, r - 1, -$pi * 0.55, $pi * 0.55, 1);
  ex = cx + dir * r * sin($pi * 0.55); ey = oy - r * cos($pi * 0.55);   // the end it turns back at: left for undo
  gfx_triangle(ex, ey + r * 0.7, ex - r * 0.55, ey - r * 0.05, ex + r * 0.55, ey - r * 0.05);   // the head, pointing down
);
// one A / B button: lit when its slot shows; a click shows it, a right-click copies the slot shown into the other
function qzg_ab_btn(lbl, slot, x, y, w, h) local(hot) (
  hot = qzg_in(mx, my, x, y, w, h);
  qzg_col(qzv_ab == slot ? qzg_p_acc : hot ? qzg_p_pillh : qzg_p_pill, 1); qzg_frr(x, y, w, h, h / 2);
  qzg_font(11 * qzg_s, 1); qzg_col(qzv_ab == slot ? 0x0f1218 : hot ? qzg_p_tx : qzg_p_tx2, 1); qzg_text_c(lbl, x, y, w, h);
  hot ? ( qzg_cur = 32649; lmb_down ? ( qzg_ab_switch(slot); lmb_down = 0; ); rmb_down ? ( qzg_ab_copy(); rmb_down = 0; );
          qzg_hlp(slot == 0 ? "Setting A (click to show it; right-click copies the setting shown into the other)"
                            : "Setting B (click to show it; right-click copies the setting shown into the other)"); );
);
// ---- simple mode (spec §10b; the user: "fold the 4-Band into Quezy", then "I don't want to release it without that
//      four band layout", then with a picture of the 4-Band's strip: "I want the four band to look exactly like it did
//      before ... except I want us to add the rings ... when we go to simple mode, I want to go to this view right
//      here. And instead of it saying nodes ... simple to full"): the 4-Band's knob strip (qzg_skn_*, below) in the
//      strip AND the window, its NODES button reading FULL. Eight of Quezy's bands in fixed jobs: slot 0 the low cut,
//      1 the low shelf, 2-5 bells 1-4, 6 the high shelf, 7 the high cut, and OUT. Quezy's full ranges; new Quezys open
//      in FULL. A setup that does not fit the eight jobs (a ninth band, another shape, a Mid / Side / Left / Right band)
//      greys SIMPLE out, with a hover line saying why: a knob must never turn a band doing another job. One setting for
//      the window and the strips (@serialize gate 10), no new control. ----
// the job's band shapes: does slot k's band fit its job?
function qzg_sjob_fits(k, sh) (
  k == 0 ? sh == 1 || sh == 2 || sh == 12 : k == 1 ? sh == 3 : k <= 5 ? sh == 0 || sh == 14 :
  k == 6 ? sh == 4 : k == 7 ? sh == 5 || sh == 6 || sh == 13 : 0;
);
function qzg_simple_fits() local(k, ok) (
  ok = 1; k = 0;
  loop(16, qzg_live(k) ? ( (k > 7 || qzg_place(k) != 0 || !qzg_sjob_fits(k, qzg_shape(k))) ? ok = 0; ); k += 1; );
  ok;
);
function qzg_simple_on() ( qzv_simple == 1 && qzg_simple_fits(); );
// the knob column on a strip: simple mode on and a strip tall enough for it (the tall twin, or a tall track panel).
// A shorter strip (no GainKit Plus to swap, or the swap held while the song plays) keeps the curve, its SIMPLE chip
// lit: nine knobs and their names cannot share 70 px without piling up (the user's picture, 2026-10-31)
function qzg_sstrip() ( qzg_simple_on(); );   // any height: a short strip shrinks the column (qzg_skn_scaled)
// each job's home: its shape, frequency and Q (the 4-Band's defaults; the cuts 12 dB Butterworth)
function qzg_sjob_f(k) ( k == 0 ? 40 : k == 1 ? 80 : k == 2 ? 200 : k == 3 ? 500 : k == 4 ? 1400 : k == 5 ? 3500 : k == 6 ? 6000 : 18000; );
function qzg_sjob_q(k) ( k >= 2 && k <= 5 ? 1 : 0.7071; );
function qzg_sjob_sh(k) ( k == 0 ? 2 : k == 1 ? 3 : k <= 5 ? 0 : k == 6 ? 4 : 6; );
// slot k's band, set up at its job's home when it is not in use, Mode m written last (2 On, 1 Bypassed)
function qzg_sjob_band_m(k, m) (
  !qzg_live(k) ? (
    qzg_set(qzg_n(k, 2), qzg_sjob_sh(k)); qzg_set(qzg_n(k, 1), 0); qzg_setf(k, qzg_sjob_f(k)); qzg_setg(k, 0);
    qzg_setq(k, qzg_sjob_q(k)); qzg_setsl(k, 1); qzg_set(qzg_n(k, 0), m);
  );
);
function qzg_sjob_band(k) ( qzg_sjob_band_m(k, 2); );
// every job's band set up at its home, so the window's curve shows all eight dots from the start (the user, 2026-10-31:
// "in simple mode, when it's floating, can you show the nodes at default?"): the bells and shelves on at 0 dB (no change
// to the sound), the cuts set up Bypassed (their deck switch OFF). On SIMPLE, and on the window's simple passes.
function qzg_simple_setup() local(k) (
  k = 0; loop(8, qzg_sjob_band_m(k, k == 0 || k == 7 ? 1 : 2); k += 1; );   // the cuts Bypassed from the first write
);
// a running deck-knob drag: frequency and Q on a log scale (the whole range over 200 px), gain over 300 px; Alt 10x finer
function qzg_sdk_drag() local(dy, v) (
  qzg_sdd ? (
    LMB ? (
      ALT !== qzg_sdmod ? ( qzg_sdy0 = my; qzg_sdv0 = slider(qzg_sdd); qzg_sdmod = ALT; );
      abs(qzg_sdy0 - my) >= 1 ? (
        dy = (qzg_sdy0 - my) * (ALT ? 0.1 : 1) / qzg_s;
        v = qzg_sdlog ? qzg_sdv0 * (qzg_sdhi / qzg_sdlo) ^ (dy / 200) : qzg_sdv0 + (qzg_sdhi - qzg_sdlo) * dy / 300;
        v = max(qzg_sdlo, min(qzg_sdhi, v));
        qzg_set(qzg_sdd, qzg_round(v, qzg_sdkind == 1 ? 0.01 : qzg_sdkind == 2 ? 0.0001 : 0.1));
      );
    ) : qzg_sdd = 0;
  );
);
// one deck knob for slider n (kind 0 gain, 1 frequency, 2 Q, 3 OUT): Quezy's knob, its label and value under it.
// Drag, the wheel (0.5 dB / a semitone / x1.12), a double-click back to the job's home. A band not in use is drawn dim
// at its home and set up on the first touch.
function qzg_sdk_knob(n, cx, cy, kind, col, lbl, help) local(s, r, k, live, v, lo, hi, lg, a0, a1, hot, al, def)
(
  s = qzg_s; r = 13 * s; k = floor((n - 1) / 13);
  live = n > 208 || qzg_live(k);
  lo = kind == 0 || kind == 3 ? -30 : kind == 1 ? 10 : 0.1; hi = kind == 0 || kind == 3 ? 30 : kind == 1 ? 22050 : 40;
  lg = kind == 1 || kind == 2;
  def = kind == 0 || kind == 3 ? 0 : kind == 1 ? qzg_sjob_f(k) : qzg_sjob_q(k);
  v = live ? slider(n) : def;
  kind == 3 ? v = max(-30, v);
  hot = qzg_sdd == n || (!qzg_sdd && qzg_in(mx, my, cx - 28 * s, cy - r - 4 * s, 56 * s, 54 * s));   // one row's height: never the next knob's
  al = live ? 1 : 0.45;
  // ReaKit's knob (rk_knob_draw, every house style): the theme panel's KNOB while a suite theme shows, the SSL knob in
  // Quezy's own looks (the 3-Band's and GainKit's rule); the band colour dimmed for a band not in use. Frequency and Q
  // drawn on their log scale (the 4-Band's way: log value, log ends).
  a0 = rkth_active() && gmem[GS_THEME_KNOB_P] > 0 ? (gmem[GS_THEME_KNOB_P] | 0) : 1;
  a1 = qzg_lerpc(qzg_c_pan, col, al);
  rk_knob_draw(a0, cx, cy, r, lg ? log(max(lo, v)) : v, lg ? log(lo) : lo, lg ? log(hi) : hi, kind == 0 || kind == 3,
               hot ? 1 : 0, ((a1 / 65536) | 0) / 255, (((a1 / 256) | 0) & 255) / 255, (a1 & 255) / 255, 0,
               ((qzg_c_pan / 65536) | 0) / 255, (((qzg_c_pan / 256) | 0) & 255) / 255, (qzg_c_pan & 255) / 255);
  qzg_font(10 * s, 1); qzg_col(qzg_c_lbl, 1); qzg_text_c(lbl, cx - 30 * s, cy + r + 3 * s, 60 * s, 12 * s);
  kind == 1 ? ( qzg_ftxt(#qzg_t, v); ) : kind == 2 ? qzg_qtxt(#qzg_t, v) : sprintf(#qzg_t, "%+.1f", v);
  qzg_font(10 * s, 0); qzg_col(live ? (hot ? qzg_c_hot : qzg_c_tx) : qzg_c_off, 1); qzg_text_c(#qzg_t, cx - 30 * s, cy + r + 15 * s, 60 * s, 12 * s);
  hot ? ( qzg_cur = 32645; qzg_hlp(help); );
  hot && !qzg_sdd ? (
    lmb_down ? (
      n <= 208 ? qzg_sjob_band(k);
      qzg_now - qzg_sdc_t < qzg_dbl_t && qzg_sdc_n == n ? (
        qzg_set(n, def); qzg_sdc_t = 0;
      ) : (
        qzg_sdc_t = qzg_now; qzg_sdc_n = n;
        qzg_sdd = n; qzg_sdy0 = my; qzg_sdv0 = slider(n); qzg_sdlo = lo; qzg_sdhi = hi; qzg_sdlog = lg; qzg_sdkind = kind;
        qzg_sdmod = ALT; kind == 3 ? qzg_sdv0 = max(-30, qzg_sdv0);
      );
      lmb_down = 0;
    );
    frame_wheel != 0 ? (
      n <= 208 ? qzg_sjob_band(k);
      v = slider(n); kind == 3 ? v = max(-30, v);
      v = lg ? v * (kind == 1 ? 2 ^ (frame_wheel / 12) : 1.12 ^ frame_wheel) : v + 0.5 * frame_wheel;
      qzg_set(n, qzg_round(max(lo, min(hi, v)), kind == 1 ? 0.01 : kind == 2 ? 0.0001 : 0.1));
      frame_wheel = 0;
    );
  );
);
// a cut's ON / OFF chip: on = the band On, off = Bypassed (its settings kept); a cut not in use comes on at its home
function qzg_sdk_cut(k, cx, cy) local(s, on, w, h, hot) (
  s = qzg_s; w = 40 * s; h = 18 * s;
  on = qzg_live(k) && qzg_on(k);
  hot = !qzg_sdd && qzg_in(mx, my, cx - w / 2, cy - h / 2, w, h);
  qzg_col(on ? qzg_c_tx2 : hot ? qzg_c_chiph : qzg_c_chip, 1); qzg_pill(cx - w / 2, cy - h / 2, w, h);
  qzg_font(10 * s, 1); qzg_col(on ? 0x0f1218 : hot ? qzg_c_tx : qzg_c_tx2, 1); qzg_text_c(on ? "ON" : "OFF", cx - w / 2, cy - h / 2, w, h);
  hot ? ( qzg_cur = 32649; qzg_hlp(k == 0 ? "The low cut on or off (off keeps its frequency)" : "The high cut on or off (off keeps its frequency)"); );
  hot && lmb_down ? (
    !qzg_live(k) ? qzg_sjob_band(k) : qzg_set(qzg_n(k, 0), on ? 1 : 2);
    lmb_down = 0;
  );
);
// the deck: nine columns (LOW CUT, LOW, 1-4, HIGH, HIGH CUT, OUT), three rows (gain, frequency, Q), over the panel
// colour, under the curve
function qzg_simple_deck() local(s, y, cw, j, k, cx, r1, r2, r3, col) (
  s = qzg_s; y = qzg_gh + 4 * s;
  qzg_obox(4 * s, y, gfx_w - 8 * s, gfx_h - y - 4 * s, 10 * s, qzg_c_pan, qzg_c_line, 1);
  cw = (gfx_w - 16 * s) / 9;
  r1 = y + 38 * s; r2 = r1 + 54 * s; r3 = r2 + 54 * s;
  j = 0;
  loop(9,
    cx = 8 * s + cw * j + cw / 2;
    k = j;                             // the column's slot (8 = OUT)
    col = j == 8 ? qzg_c_tx : j == 0 || j == 7 ? qzg_c_tx2 : qzg_bcol(k);
    // the column's name: the bands' on a pill in their colour with dark text (a band colour as text read poorly on a
    // light plate), the cuts' and OUT's in the text colour
    qzg_font(11 * s, 1);
    j == 8 ? strcpy(#qzg_t, "OUT") : j >= 2 && j <= 5 ? sprintf(#qzg_t, "%d", qzg_dn[k] + 1) : (
      strcpy(#qzg_t2, j == 0 ? "LOW CUT" : j == 1 ? "LOW" : j == 6 ? "HIGH" : "HIGH CUT");
      sprintf(#qzg_t, "%d %s", qzg_dn[k] + 1, #qzg_t2);
      qzg_tw(#qzg_t) + (j == 0 || j == 7 ? 0 : 14 * s) > cw - 2 * s ? strcpy(#qzg_t, #qzg_t2);   // the cuts: no pill
    );
    j >= 1 && j <= 6 ? (
      qzg_col(col, 1); qzg_pill(cx - (qzg_tw(#qzg_t) + 14 * s) / 2, y + 5 * s, qzg_tw(#qzg_t) + 14 * s, 16 * s);
      qzg_col(0x0f1218, 1);
    ) : qzg_col(qzg_c_tx, 1);
    qzg_text_c(#qzg_t, cx - cw / 2, y + 6 * s, cw, 14 * s);
    j == 8 ? (
      qzg_sdk_knob(209, cx, r1, 3, col, "GAIN", "Output gain: drag or wheel; double-click for 0 dB");
    ) : j == 0 || j == 7 ? (
      qzg_sdk_cut(k, cx, r1);
      qzg_sdk_knob(qzg_n(k, 3), cx, r2, 1, col, "FREQ", j == 0 ? "Low cut frequency: drag or wheel; double-click: 40 Hz"
                                                                  : "High cut frequency: drag or wheel; double-click: 18 kHz");
    ) : (
      qzg_sdk_knob(qzg_n(k, 4), cx, r1, 0, col, "GAIN", "Gain: drag or wheel (Alt fine); double-click for 0 dB");
      qzg_sdk_knob(qzg_n(k, 3), cx, r2, 1, col, "FREQ", "Frequency: drag or wheel (a semitone a notch); double-click: its home");
      qzg_sdk_knob(qzg_n(k, 5), cx, r3, 2, col, "Q", "Q, the width: drag or wheel; double-click: its home");
    );
    j += 1;
  );
);
// SIMPLE | FULL in the top bar: SIMPLE greyed (with the reason on hover) while the setup does not fit simple mode's jobs
function qzg_simple_chips(x1, y, h) local(s, w1, w2, x, fit, hot) (
  s = qzg_s; qzg_font(11 * s, 1);
  w1 = qzg_tw("SIMPLE") + 14 * s; w2 = qzg_tw("FULL") + 14 * s; x = x1 - w1 - w2;
  fit = qzg_simple_fits();
  hot = qzg_in(mx, my, x, y, w1, h);
  qzg_col(qzg_simple_on() ? qzg_p_acc : hot && fit ? qzg_p_pillh : qzg_p_pill, 1); qzg_frr(x, y, w1, h, h / 2);
  qzg_col(qzg_simple_on() ? 0x0f1218 : !fit ? qzg_p_dim : hot ? qzg_p_tx : qzg_p_tx2, fit ? 1 : 0.6); qzg_text_c("SIMPLE", x, y, w1, h);
  hot ? ( fit ? qzg_cur = 32649;
          qzg_hlp(fit ? "Simple mode: the 4-Band's layout on knobs (eight bands in fixed jobs)"
                      : "Simple mode needs eight bands in fixed jobs: this setup has more, or other shapes or places");
          lmb_down ? ( fit ? ( qzv_simple = 1; qzg_simple_setup(); ); lmb_down = 0; ); );
  hot = qzg_in(mx, my, x + w1, y, w2, h);
  qzg_col(!qzg_simple_on() ? qzg_p_acc : hot ? qzg_p_pillh : qzg_p_pill, 1); qzg_frr(x + w1, y, w2, h, h / 2);
  qzg_col(!qzg_simple_on() ? 0x0f1218 : hot ? qzg_p_tx : qzg_p_tx2, 1); qzg_text_c("FULL", x + w1, y, w2, h);
  hot ? ( qzg_cur = 32649; qzg_hlp("The full window: the graph's dots, the band bar, the editor, all 16 bands");
          lmb_down ? ( qzv_simple = 0; lmb_down = 0; ); );
  x;
);
// the top bar's undo / redo / A | B group, right-aligned to x1
function qzg_topbar_hist(x1) local(s, y, h, w, x, hot, on) (
  s = qzg_s; h = 18 * s; y = qzg_lky - h / 2; w = 18 * s;
  qzg_ab_btn("A", 0, x1 - 2 * w, y, w, h);
  qzg_ab_btn("B", 1, x1 - w, y, w, h);
  x = x1 - 2 * w - 10 * s - h;         // redo, then undo to its left
  on = qzg_can_redo(); hot = qzg_in(mx, my, x, y, h, h);
  qzg_hist_arrow(x + h / 2, y + h / 2, 5 * s, 1, on, hot);
  hot && on ? ( qzg_cur = 32649; lmb_down ? ( qzg_redo(); lmb_down = 0; ); );
  hot ? qzg_hlp(on ? "Redo" : "Redo (nothing to redo)");
  x -= h + 2 * s;
  on = qzg_can_undo(); hot = qzg_in(mx, my, x, y, h, h);
  qzg_hist_arrow(x + h / 2, y + h / 2, 5 * s, -1, on, hot);
  hot && on ? ( qzg_cur = 32649; lmb_down ? ( qzg_undo(); lmb_down = 0; ); );
  hot ? qzg_hlp(on ? "Undo your last change" : "Undo (nothing to undo)");
  qzg_simple_chips(x - 8 * s, y, h);   // SIMPLE | FULL (simple mode, spec §10b)
);
// a native look's name for the theme panel's LOOK row (string literals, as rkth_xrow wants)
function qzg_nl_name(v) (
  v = ((v | 0) % 6 + 6) % 6;
  v == 1 ? "CARBON" : v == 2 ? "AURORA" : v == 3 ? "EMBER" : v == 4 ? "PAPER" : v == 5 ? "WHITE" : "MIDNIGHT";
);
// A double-click on the logo (rk_theme's rkth_dock_name, routed): Quezy's own helper when it runs ("Quezy helper.lua",
// band EON_QUEZY_HELPER: +0 its heartbeat, +2..+4 where this instance sits, +5 the counter LAST), else GainKit Plus
// (rk_theme's EMBED band, mode 4); neither = nothing. In its own window or the dock only (a strip's clicks open it).
QZG_HLP = 31374310;
function qzg_dock_name(x, y, w, h) local(_in, _now, _p, _f, _t) (
  !(gfx_ext_flags & 1) ? (
    (mouse_cap & 1) && !(qzg_dk_cap & 1) ? (
      _in = mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
      _now = time_precise();
      _in && qzg_dk_t > 0 && _now - qzg_dk_t < RKTH_DOCK_DBL ? (
        qzg_dk_t = 0;
        _p = 0; _f = 0; _t = get_host_placement(_p, _f);
        gmem[QZG_HLP] > 0 && abs(time() - gmem[QZG_HLP]) <= 3 ? (
          gmem[QZG_HLP + 2] = _t; gmem[QZG_HLP + 3] = _p; gmem[QZG_HLP + 4] = _f;
          gmem[QZG_HLP + 5] = (gmem[QZG_HLP + 5] | 0) + 1;
        ) : rkth_em_alive() ? (
          gmem[RKTH_EM_BASE + 8] = 4; gmem[RKTH_EM_BASE + 9] = _t; gmem[RKTH_EM_BASE + 10] = _p; gmem[RKTH_EM_BASE + 11] = _f;
          gmem[RKTH_EM_BASE + 12] = (gmem[RKTH_EM_BASE + 12] | 0) + 1;
        );
      ) : qzg_dk_t = _in ? _now : 0;
    );
    qzg_dk_cap = mouse_cap;
  );
);
// ---- the top bar (4a: the logo and the dB range pill) ----
function qzg_topbar() local(s, w, hot, tx, thw, thx, thy, p) (
  s = qzg_s;
  qzg_font(17 * s, 1); qzg_col(qzg_p_tx, 1); qzg_text("Quezy", 14 * s, 5 * s);
  w = qzg_tw("Quezy");
  qzg_col(qzg_p_acc, 1); gfx_circle(14 * s + w + 4 * s, 15 * s, 3 * s, 1, 1);
  // a double-click on the logo docks Quezy in its own dock tab, or floats it out of there (Gumbo's way, the user,
  // 2026-11-02: "I want Quezy to dock and undock like Gumbo"; Quezy's own helper or GainKit Plus runs the tab)
  qzg_dock_name(0, 0, 14 * s + w + 8 * s, 30 * s);
  // the track's name after the logo (rkth_track_name: drawn at 55 % of the current colour, nothing when short of room;
  // leaves gfx_x at its end), then the house theme toggle; its panel drops over the graph (the gate, qzg_th_gate)
  tx = 14 * s + w + 7 * s;
  thw = rkth_cl_hdr_w > 0 ? rkth_cl_hdr_w : 56 * s;
  gfx_x = tx + 6 * s; gfx_y = 5 * s; qzg_col(qzg_p_tx, 1);
  rkth_track_name(floor(17 * s), gfx_w - 8 * s - thw - 12 * s - qzg_lkw - gfx_x);   // the link controls' room kept
  thx = max(gfx_x, tx) + 12 * s; thy = 9 * s;
  qzg_thx = thx; qzg_thy = thy;        // where the chip sat this pass (the test rig reads it)
  qzg_th_st ? ( mx = qzg_th_mx; my = qzg_th_my; lmb_down = qzg_th_l; rmb_down = qzg_th_r; frame_wheel = qzg_th_w; );
  // the cluster's scale (NOT rkth_sc: that name is taken): the window's, smaller only when the paged panel would run
  // past the window's foot (rkth_need1: its height at scale 1 from last pass's rows; the GainKit fit)
  rkth_scale = min(s, max(0.5, (gfx_h - thy - RKTH_H_CHIP * s - 4 * s) / (rkth_need1(0) + 11)));
  rkth_namebar(qz_name_bar);
  rkth_embedrow();                     // EMBED row (MCP / TCP / OFF, served by GainKit Plus): Quezy joins the free set (step 8)
  // Quezy's look rows (the user, 2026-10-30: "half those right click options belong in the theme menu", then "All the
  // look choices"): the panel in pages, the window's bands and dots on LOOK, the strips' bands, dots and analyser on
  // STRIP. Each row's first state is the look Quezy starts with (the panel lights a row moved off it), so the
  // view-state numbers (rk_curve's: bands 0 Fill / 1 Lines / 2 Both, dots 0 Ring / 1 Plain / 2 Badge) map to rows.
  rkth_pages();
  // the native look (the user, 2026-10-30: "we click native and then it shows more of the options that native has
  // ... that should be an option in theme as well"): a row while NATIVE is on, stepping through the six looks. A row
  // holds three states, so it shows three NAMES around the current look: Midnight (the first look, the row unlit) as
  // state 0 with the next and the previous after it, any other look as state 1 between the previous and the next; a
  // click picks the next, a right-click the previous, round the six.
  p = qzv_nlook | 0;
  rkth_local_off ? (
    p == 0 ? rkth_xrow(0, "LOOK", 0, 3, qzg_nl_name(0), qzg_nl_name(1), qzg_nl_name(5))
           : rkth_xrow(0, "LOOK", 1, 3, qzg_nl_name(p - 1), qzg_nl_name(p), qzg_nl_name(p + 1));
    rkth_xhint(0, "Quezy's own looks: click for", "the next, right-click the last");
  ) : rkth_x0_ok = 0;
  rkth_xrow(1, "BANDS", qzg_look(qzv_wb), 3, "FILL", "LINES", "BOTH");
  rkth_xhint(1, "The window's bands: filled,", "outlined, or both");
  p = qzg_look(qzv_wn); rkth_xrow(2, "DOTS", p == 2 ? 0 : p + 1, 3, "BADGE", "RING", "PLAIN");
  rkth_xhint(2, "The window's dots: a numbered", "badge, a numbered ring, plain");
  p = qzg_look(qzv_sb); rkth_xrow(3, "BANDS", p == 2 ? 0 : p + 1, 3, "BOTH", "FILL", "LINES");
  rkth_xpage(3, 1); rkth_xhint(3, "The strips' bands: both,", "filled, or outlined");
  p = qzg_look(qzv_sn); rkth_xrow(4, "DOTS", p == 1 ? 0 : p == 0 ? 1 : 2, 3, "PLAIN", "RING", "BADGE");
  rkth_xpage(4, 1); rkth_xhint(4, "The strips' dots: plain, a", "numbered ring or badge");
  rkth_xrow(5, "ANALYSER", qzv_an_strip ? 0 : 1, 2, "ON", "OFF", "");
  rkth_xpage(5, 1); rkth_xhint(5, "The analyser on the strips", "(the window's: right-click)");
  rkth_xrow(6, "SHOW DOTS", qzv_dots ? 1 : 0, 2, "ALWAYS", "ON HOVER", "");
  rkth_xhint(6, "The window's dots: always, or", "only while the pointer is over it");
  rkth_xrow(8, "TEXT", qzv_txt | 0, 3, "NORMAL", "LARGE", "LARGER");
  rkth_xhint(8, "The window's text size", "");
  rkth_xrow(7, "WHEEL", qzv_swheel ? 1 : 0, 2, "STEPS", "SWEEP", "");
  rkth_xpage(7, 1); rkth_xhint(7, "Simple mode's bells: the wheel", "in steps or a smooth sweep");
  rkth_cluster_hdr(thx, thy, 0, 0);    // rows THEME, KNOB, NAME BAR, the look rows (no meter here)
  rkth_nb_pick >= 0 ? ( qzg_set(220, rkth_nb_pick); rkth_nb_pick = -1; );   // the NAME BAR row (0x100 follows in the host)
  (p = rkth_xpick(0)) >= 0 ? (
    qzv_nlook = (qzv_nlook | 0) == 0 ? (p == 1 ? 1 : p == 2 ? 5 : 0)          // from Midnight: 1 the next, 2 the previous
                                     : (((qzv_nlook | 0) + (p == 2 ? 1 : p == 0 ? -1 : 0)) % 6 + 6) % 6;
  );
  (p = rkth_xpick(1)) >= 0 ? qzv_wb = p;
  (p = rkth_xpick(2)) >= 0 ? qzv_wn = p == 0 ? 2 : p - 1;
  (p = rkth_xpick(3)) >= 0 ? qzv_sb = p == 0 ? 2 : p - 1;
  (p = rkth_xpick(4)) >= 0 ? qzv_sn = p == 0 ? 1 : p == 1 ? 0 : 2;
  (p = rkth_xpick(5)) >= 0 ? qzv_an_strip = p == 0;
  (p = rkth_xpick(7)) >= 0 ? qzv_swheel = p;
  (p = rkth_xpick(6)) >= 0 ? qzv_dots = p;
  (p = rkth_xpick(8)) >= 0 ? qzv_txt = p;
  qzg_set(221, rkth_local_off);        // NATIVE back to its row at once (the host head does it next pass anyway)
  qzg_th_st ? ( mx = my = -10000; lmb_down = rmb_down = 0; frame_wheel = 0; );
  !qzg_th_st && qzg_in(mx, my, thx, thy, thw, RKTH_H_CHIP * s) ? ( qzg_cur = 32649; qzg_hlp("Theme, looks and strip options"); );
  // undo, redo and A / B, left of the link controls (their room is in qzg_lkw): two arrows, then the A | B pair; a click
  // on A or B shows that slot, a right-click copies the slot shown into the other
  qzg_topbar_hist(qzg_lkx - qzg_lkbs - 5 * s - 10 * s);
  // the link gear and badge (the 3-Band's and the Filter's sizes: gear r = 0.2 of the bar, badge 0.36)
  qzg_lk_rgb();
  rk_link_draw_gear(qzg_lkx, qzg_lky, qzg_lkrr, qzg_lkr, qzg_lkg, qzg_lkb, mx, my, lmb_down);
  rk_link_draw_badge(qzg_lkx - qzg_lkbs - 5 * s, qzg_lky - qzg_lkbs / 2, qzg_lkbs, qzg_lkr, qzg_lkg, qzg_lkb, mx, my, lmb_down);
  qzg_in(mx, my, qzg_lkx - qzg_lkbs - 5 * s, qzg_lky - qzg_lkrr - 2 * s, qzg_lkbs + 4 * s, 2 * qzg_lkrr + 4 * s) ? (
    qzg_cur = 32649; qzg_hlp("Link group: click for the next group, right-click for all of them"); );
  qzg_in(mx, my, qzg_lkx - qzg_lkrr - 3 * s, qzg_lky - qzg_lkrr - 3 * s, 2 * qzg_lkrr + 6 * s, 2 * qzg_lkrr + 6 * s) ? (
    qzg_cur = 32649; qzg_hlp("Link groups: Quezys in one group move together; when Quezy is active"); );
  hot = qzg_in(mx, my, 8 * s, 34 * s, 40 * s, 18 * s);
  hot ? qzg_cur = 32649;
  hot ? qzg_hlp("The graph's dB range: click for the next (6 to 30)");
  sprintf(#qzg_t, "\xc2\xb1%d", qzg_r);
  qzg_col(hot ? qzg_p_pillh : qzg_p_pill, 1); qzg_pill(8 * s, 34 * s, 40 * s, 18 * s);
  qzg_font(11 * s, 1); qzg_col(hot ? qzg_p_tx : qzg_p_tx2, 1); qzg_text_c(#qzg_t, 8 * s, 34 * s, 40 * s, 18 * s);
  lmb_down && hot ? ( qzv_range = qzg_r >= 30 ? 6 : qzg_r + 6; lmb_down = 0; );   // cycles 6 / 12 / 18 / 24 / 30
  // BYPASS (E2, step 7): the dry sound at the EQ's loudness (the engine measures both while you play); lit while on,
  // with the gain the dry gets. The window only: closing it ends the bypass.
  qzg_font(11 * s, 1); qzg_bpw = qzg_tw("BYPASS -24.0") + 14 * s;
  hot = qzg_in(mx, my, 52 * s, 34 * s, qzg_bpw, 18 * s);
  hot ? ( qzg_cur = 32649; qzg_hlp("Bypass at the same loudness: hear the EQ in and out without the louder one winning"); );
  qzm_byp > 0 ? sprintf(#qzg_t, "BYPASS %+.1f", abs(qz_byp_db) < 0.05 ? 0 : qz_byp_db) : strcpy(#qzg_t, "BYPASS");
  qzg_col(qzm_byp > 0 ? 0xEB4D4D : hot ? qzg_p_pillh : qzg_p_pill, 1); qzg_pill(52 * s, 34 * s, qzg_bpw, 18 * s);
  qzg_col(qzm_byp > 0 ? 0x0f1218 : hot ? qzg_p_tx : qzg_p_tx2, 1); qzg_text_c(#qzg_t, 52 * s, 34 * s, qzg_bpw, 18 * s);
  lmb_down && hot ? ( qzm_byp = qzm_byp > 0 ? 0 : 1; lmb_down = 0; );
);

// ---- band bar ----
function qzg_bandbar() local(s, n, avail, cw, x, y, h, k, i, on, addw, hot, bg, tw4) (
  s = qzg_s; y = qzg_bby; h = 20 * s;
  qzg_font(11 * s, 0); tw4 = qzg_tw("8.8k");   // the widest chip label (Arial's digits share one width)
  n = qzg_live_count();
  addw = n < 16 ? 57 * s : 0;
  avail = gfx_w - 16 * s - addw;
  cw = n > 0 ? min(70 * s, floor(avail / n) - 4 * s) : 0;
  x = 8 * s;
  i = 0;
  loop(16,
    k = qzg_ds[i];                     // in the display order (left to right on the graph when renumbering)
    qzg_live(k) ? (
      cw >= 8 * s ? (
        on = qzg_on(k);
        hot = qzg_in(mx, my, x, y, cw, h);
        hot ? qzg_cur = 32649;
        hot ? qzg_hlp("Click to edit this band");
        bg = qzg_sel[k] ? qzg_c_bchs : hot ? qzg_c_bchh : qzg_c_bch;
        k == qzg_prim ? qzg_obox(x, y, cw, h, h / 2, bg, qzg_bcol(k), 1) : ( qzg_col(bg, 1); qzg_pill(x, y, cw, h); );
        cw >= max(62 * s, 48 * s + tw4) ? (   // room for the icon and the widest label (the audit: at 150 % and up
                                               // a 62-65 px chip ran the label into the icon)
          // the band's number on a disc in its colour, as its dot on the graph (the user, 2026-11-03: "give them the band
          // number at the bottom not just color type and freq")
          on ? qzg_bandcol(k, 1) : qzg_col(qzg_c_fnt, 1); gfx_circle(x + 11 * s, y + h / 2, 7 * s, 1, 1);
          sprintf(#qzg_t, "%d", qzg_dn[k] + 1); qzg_font(9 * s, 1); qzg_col(0x0f1218, 1); qzg_text_c(#qzg_t, x + 4 * s, y, 15 * s, h);
          qzg_col(on ? qzg_c_tx2 : qzg_c_off, 1);
          qzg_glyph(qzg_icon_of(qzg_shape(k), qzg_geff(k)), x + 20 * s, y + 5 * s, 16 * s, 10 * s, 1.3 * s);
          qzg_fs(#qzg_t, qzg_v(k, 3)); qzg_font(11 * s, 0); qzg_col(on ? qzg_c_tx2 : qzg_c_off, 1);
          qzg_text_r(#qzg_t, x, y, cw - 8 * s, h);
        ) : cw >= 34 * s ? (                 // the number and the frequency ("4 8.1k"), else the frequency
          qzg_fs(#qzg_t2, qzg_v(k, 3)); qzg_font(11 * s, 1); on ? qzg_bandcol(k, 1) : qzg_col(qzg_c_dim, 1);
          sprintf(#qzg_t, "%d %s", qzg_dn[k] + 1, #qzg_t2); qzg_tw(#qzg_t) > cw - 6 * s ? strcpy(#qzg_t, #qzg_t2);
          qzg_text_c(#qzg_t, x, y, cw, h);
        ) : cw >= 20 * s ? (
          sprintf(#qzg_t, "%d", qzg_dn[k] + 1); qzg_font(11 * s, 1); on ? qzg_bandcol(k, 1) : qzg_col(qzg_c_dim, 1);
          qzg_text_c(#qzg_t, x, y, cw, h);
        );
        lmb_down && hot ? ( qzg_sel_only(k); lmb_down = 0; );
      );
      x += cw + 4 * s;
    );
    i += 1;
  );
  n < 16 ? (
    hot = qzg_in(mx, my, x, y, 52 * s, h);
    hot ? qzg_cur = 32649;
    hot ? qzg_hlp("Add a bell at 1 kHz (or double-click the graph where you want one)");
    qzg_col(hot ? qzg_c_pillh : qzg_c_pill, 1); qzg_pill(x, y, 52 * s, h);
    qzg_font(11 * s, 1); qzg_col(hot ? qzg_c_tx : qzg_c_tx2, 1); qzg_text_c("+ ADD", x, y, 52 * s, h);
    lmb_down && hot ? ( qzg_add_bell(); lmb_down = 0; );
  );
);

// ---- editor widgets ----
// Apply a field value (kind 0 freq, 1 gain, 2 Q, 3 slope) to band k and, when k is in the selection, to the rest of
// it: frequency and Q by the same ratio, gain by the same dB, slope to the same step.
function qzg_field_set(kind, k, v) local(j, f0, g0, q0) (
  f0 = max(10, qzg_v(k, 3)); g0 = qzg_v(k, 4); q0 = max(0.1, qzg_v(k, 5));   // before any write
  j = 0;
  loop(16,
    qzg_targets(k, j) ? (
      kind == 0 ? qzg_setf(j, j == k ? v : qzg_v(j, 3) * v / f0) :
      kind == 1 ? ( qzg_has_gain(qzg_shape(j)) ? qzg_setg(j, j == k ? v : qzg_v(j, 4) + v - g0); ) :
      kind == 2 ? ( qzg_has_q(qzg_shape(j)) ? qzg_setq(j, j == k ? v : qzg_v(j, 5) * v / q0); ) :
                  ( qzg_has_slope(qzg_shape(j)) ? qzg_slope_keep(j, v); );
    );
    j += 1;
  );
);
// ---- hover help (step 7, batch 3; spec §8: "hover help on every control (one line at the bottom of the graph)") ----
// A control under the pointer names itself with qzg_hlp (string literals, or #qzg_help written in place); the line shows
// once the pointer has rested 0.45 s on the same control (no flicker while it crosses the face), never over a menu, the
// theme panel or the link grid or during a drag. The pending wait forces redraws (qzg_hlp_pend) until it shows.
function qzg_draw_help() local(s, y, w, h) (
  s = qzg_s;
  qzg_hlp_pend = 0;
  qzg_hlp_on && !rkm_on && !rk_menu_open && !rkth_open && !rkth_dd_open && !rkth_cl_open && qzg_drag < 0 && !qzg_fdrag &&
  !qzg_kdrag && !qzg_box ? (
    strcmp(#qzg_help, #qzg_hlast) != 0 ? ( strcpy(#qzg_hlast, #qzg_help); qzg_hlp_t = qzg_now; );
    qzg_now - qzg_hlp_t >= 0.45 ? (
      qzg_font(11 * s, 0);
      h = 18 * s; w = min(gfx_w - 16 * s, qzg_tw(#qzg_help) + 16 * s);
      y = qzg_gh - 24 * s - h - (qzv_an_piano ? 66 * s : 0);   // above the frequency labels (and the piano keys)
      qzg_col(qzg_p_rdo, 0.95); qzg_pill(8 * s, y, w, h);
      qzg_col(qzg_p_tx, 1); gfx_x = 16 * s; gfx_y = y; gfx_drawstr(#qzg_help, 4, 8 * s + w - 8 * s, y + h);
    ) : qzg_hlp_pend = 1;
  ) : strcpy(#qzg_hlast, "");
);
// a chip's help, from its label (the editor's and the output bar's chips share qzg_chip)
function qzg_chip_help(lbl) (
  strcmp(lbl, "ST") == 0 ? qzg_hlp("Placement: the band works on both sides (stereo)") :
  strcmp(lbl, "M") == 0 ? qzg_hlp("Placement: the band works on the mid (what both sides share)") :
  strcmp(lbl, "S") == 0 ? qzg_hlp("Placement: the band works on the side (what differs between them)") :
  strcmp(lbl, "L") == 0 ? qzg_hlp("Placement: the band works on the left side only") :
  strcmp(lbl, "R") == 0 ? qzg_hlp("Placement: the band works on the right side only") :
  strcmp(lbl, "RES") == 0 ? qzg_hlp("Cut style: resonant, its height sets a bump at the corner") :
  strcmp(lbl, "BUTTER") == 0 ? qzg_hlp("Cut style: Butterworth, the flattest corner") :
  strcmp(lbl, "ANLG") == 0 ? qzg_hlp("Cut style: analogue, the gentle corner of a hardware filter") :
  strcmp(lbl, "PROP Q") == 0 ? qzg_hlp("Proportional Q: the bell narrows as it boosts or cuts, console style") :
  strcmp(lbl, "M/S") == 0 ? qzg_hlp("The two gains and polarity buttons work on mid and side") :
  strcmp(lbl, "L/R") == 0 ? qzg_hlp("The two gains and polarity buttons work on left and right") :
  strcmp(lbl, "LIMIT") == 0 ? qzg_hlp("Clip the output at 0 dBFS so nothing goes over") :
  strcmp(lbl, "SET") == 0 ? qzg_hlp("Move auto gain's correction into OUT and switch auto gain off") :
  match("AUTO*", lbl) ? qzg_hlp("Auto gain: keeps the output as loud as the input while playing") :
  match("*M", lbl) || match("*L", lbl) ? qzg_hlp("Flip the polarity of the mid (or left) signal") :
  match("*S", lbl) || match("*R", lbl) ? qzg_hlp("Flip the polarity of the side (or right) signal");
);
// Typed values (E4; the user's plan: "double-click a field, type, Enter"): a double-click on a field opens it for typing
// (Ctrl + double-click resets it, ReEQ's habit). Digits, a point (or comma), a minus and k (x 1000) are taken; Enter or a
// click elsewhere sets it, Esc leaves it as it was; units in the text are ignored. Frequency in Hz (2k = 2000), gain in
// dB, Q as a number, slope in dB/oct (rounded to the nearest 6). The value goes through qzg_field_set, so a selection
// follows by the same ratio / step as a drag.
function qzg_parse(str) local(i, c, v, sg, fr, fd, any, mul) (
  v = 0; sg = 1; fr = 0; fd = 0.1; any = 0; mul = 1; i = 0;
  loop(strlen(str),
    c = str_getchar(str, i);
    c == '-' ? sg = -1 :
    c >= '0' && c <= '9' ? ( fr ? ( v += (c - '0') * fd; fd *= 0.1; ) : v = v * 10 + (c - '0'); any = 1; ) :
    c == '.' || c == ',' ? fr = 1 :
    c == 'k' || c == 'K' ? mul = 1000;
    i += 1;
  );
  any ? sg * v * mul : -1000000000;
);
function qzg_type_end(commit) local(v) (
  commit && qzg_ty && qzg_live(qzg_tyk) ? (
    v = qzg_parse(#qzg_ty);
    v > -1000000000 ? (
      qzg_ty == 1 ? qzg_field_set(0, qzg_tyk, v) : qzg_ty == 2 ? qzg_field_set(1, qzg_tyk, v) :
      qzg_ty == 3 ? qzg_field_set(2, qzg_tyk, v) : qzg_field_set(3, qzg_tyk, floor(v / 6 + 0.5) - 1);
    );
  );
  qzg_ty = 0;
);
// once per window pass, before anything else reads the key: the typing field takes it (and a click off the field ends
// the typing, setting the value; the click still goes on to what it hit)
function qzg_type_keys() local(c) (
  qzg_ty ? (
    !qzg_live(qzg_tyk) || qzg_tyk != qzg_prim || qzg_fold ? qzg_ty = 0 : (
      c = qzg_ch;
      c > 0 ? (
        c == 13 ? qzg_type_end(1) :
        c == 27 ? qzg_type_end(0) :
        c == 8 ? ( strlen(#qzg_ty) > 0 ? str_delsub(#qzg_ty, strlen(#qzg_ty) - 1, 1); ) :
        ((c >= '0' && c <= '9') || c == '.' || c == ',' || c == '-' || c == '+' || c == 'k' || c == 'K') && strlen(#qzg_ty) < 12 ?
          ( sprintf(#qzg_t5, "%c", c); strcat(#qzg_ty, #qzg_t5); );
        qzg_ch = 0;
      );
      (lmb_down || rmb_down) && !qzg_in(mx, my, qzg_tyx, qzg_tyy, qzg_tyw, qzg_tyh) ? qzg_type_end(1);
    );
  );
);
// A value field: a bold label, a regular value. A vertical drag changes it, the wheel steps it, a double-click opens it
// for typing (step 7), Ctrl + double-click resets it (frequency 500 Hz as ReEQ's ctrl + double-click on its dial, gain 0,
// Q 0.7071 or the Pultec's 20, slope 12 dB; with the selection, by the same ratio / step as the drag). A value the shape
// has no use for shows a dash. lbl 0 = no label; inset 1 = a stepper's field (clear of its arrows; the value centred when
// unlabelled), inset 2 = a narrow field: the value without its unit.
function qzg_field(kind, k, x, y, w, h, live, lbl, inset) local(s, v, hot) (
  s = qzg_s;
  hot = live && qzg_in(mx, my, x + (inset == 1 ? 18 * s : 0), y, w - (inset == 1 ? 36 * s : 0), h);
  hot ? qzg_cur = 32645;
  qzg_col(hot ? qzg_c_fldh : qzg_c_fld, 1); qzg_frr(x, y, w, h, 6 * s);
  lbl != 0 ? (
    qzg_font(11 * s, 1); live ? qzg_bandcol(k, 1) : qzg_col(qzg_c_fnt, 1);
    qzg_text_l(lbl, x + (inset == 1 ? 19 : 7) * s, y, w, h);
  );
  v = qzg_v(k, kind == 0 ? 3 : kind == 1 ? 4 : kind == 2 ? 5 : 6);
  !live && kind != 0 ? strcpy(#qzg_t, "\xe2\x80\x94") :
  kind == 0 ? qzg_ftxt(#qzg_t, v) : kind == 1 ? sprintf(#qzg_t, inset == 2 ? "%+.1f" : "%+.1f dB", v) :
  kind == 2 ? qzg_qtxt(#qzg_t, v) : sprintf(#qzg_t, "%d dB", ((v | 0) + 1) * 6);
  qzg_ty == kind + 1 && qzg_tyk == k ? (
    // typing: the field ringed in the accent, the text so far and a caret (the old value, dim, until a key is typed)
    qzg_col(qzg_c_acc, 1); qzg_orect(x, y, w, h);
    qzg_tyx = x; qzg_tyy = y; qzg_tyw = w; qzg_tyh = h;
    strlen(#qzg_ty) > 0 ? ( strcpy(#qzg_t, #qzg_ty); qzg_col(qzg_c_hot, 1); ) : qzg_col(qzg_c_off, 1);
    floor(qzg_now * 2) % 2 == 0 || strlen(#qzg_ty) == 0 ? strcat(#qzg_t, "|");
    qzg_hlp("Type a value, then Enter (Esc keeps the old one)");
  ) : qzg_col(live ? (hot ? qzg_c_hot : qzg_c_tx) : qzg_c_off, 1);
  qzg_font(11 * s, 0);
  inset == 1 && lbl == 0 ? qzg_text_c(#qzg_t, x, y, w, h) : qzg_text_r(#qzg_t, x, y, w - (inset == 1 ? 20 : 8) * s, h);
  hot && qzg_ty != kind + 1 ? (
    kind == 0 ? qzg_hlp("Frequency: drag or wheel; double-click to type it (2k = 2000 Hz); Ctrl+double-click: 500 Hz") :
    kind == 1 ? qzg_hlp("Gain: drag or wheel; double-click to type it; Ctrl+double-click: 0 dB") :
    kind == 2 ? qzg_hlp(qzg_shape(k) == 10 ? "Dip: how deep the Pultec's dip goes; double-click to type it"
                                           : "Q: the band's width, higher is narrower; double-click to type it") :
    qzg_hlp("Slope: how steep the cut is; double-click to type it in dB/oct");
  );
  hot ? (
    lmb_down ? (
      qzg_now - qzg_fld_t < qzg_dbl_t && qzg_fld_last == kind * 16 + k ? (
        CTRL ? (                       // Ctrl + double-click: the reset (ReEQ's)
          kind == 0 ? qzg_field_set(0, k, 500) :
          kind == 1 ? qzg_field_set(1, k, 0) : kind == 2 ? qzg_field_set(2, k, qzg_shape(k) == 10 ? 20 : 0.7071) :
          kind == 3 ? qzg_field_set(3, k, 1);
        ) : (                          // a double-click: type it
          qzg_ty = kind + 1; qzg_tyk = k; strcpy(#qzg_ty, "");
          qzg_tyx = x; qzg_tyy = y; qzg_tyw = w; qzg_tyh = h;
        );
        qzg_fld_t = 0; qzg_fdrag = 0;
      ) : (
        qzg_fld_t = qzg_now; qzg_fld_last = kind * 16 + k;
        qzg_fdrag = kind + 1; qzg_fk = k; qzg_fy0 = my; qzg_fv0 = v; qzg_fmod = ALT; qzg_fmoved = 0;
      );
      lmb_down = 0;
    );
    frame_wheel != 0 ? (
      kind == 0 ? qzg_field_set(0, k, v * 2 ^ (frame_wheel / 24)) : kind == 1 ? qzg_field_set(1, k, v + frame_wheel * 0.5) :
      kind == 2 ? qzg_field_set(2, k, v * 1.12 ^ frame_wheel) : qzg_field_set(3, k, (v | 0) + sign(frame_wheel));
      frame_wheel = 0;
    );
  );
);
// a field with step chevrons at both ends: the left 18 px steps down, the right 18 px up (Q x/÷1.25, slope +/-1)
function qzg_stepper(kind, k, x, y, w, h, live, lbl) local(s, v, hl, hr) (
  s = qzg_s;
  hl = live && qzg_in(mx, my, x, y, 18 * s, h); hr = live && qzg_in(mx, my, x + w - 18 * s, y, 18 * s, h);
  hl || hr ? qzg_cur = 32649;
  hl ? qzg_hlp(kind == 2 ? "One step wider (Q / 1.25)" : "One step gentler (6 dB/oct less)");
  hr ? qzg_hlp(kind == 2 ? "One step narrower (Q x 1.25)" : "One step steeper (6 dB/oct more)");
  live && lmb_down ? (
    v = qzg_v(k, kind == 2 ? 5 : 6);
    hl ? ( kind == 2 ? qzg_field_set(2, k, v / 1.25) : qzg_field_set(3, k, (v | 0) - 1); lmb_down = 0; ) :
    hr ? ( kind == 2 ? qzg_field_set(2, k, v * 1.25) : qzg_field_set(3, k, (v | 0) + 1); lmb_down = 0; );
  );
  qzg_field(kind, k, x, y, w, h, live, lbl, 1);
  qzg_col(!live ? qzg_c_fnt : hl ? qzg_c_hot : qzg_c_chev, 1); qzg_chev(x + 10 * s, y + h / 2, 3.5 * s, 0);
  qzg_col(!live ? qzg_c_fnt : hr ? qzg_c_hot : qzg_c_chev, 1); qzg_chev(x + w - 10 * s, y + h / 2, 3.5 * s, 1);
);
// a chip in colour col when on: returns 1 when clicked
function qzg_chip(lbl, x, y, w, h, on, col) local(s, hot) (
  s = qzg_s;
  hot = qzg_in(mx, my, x, y, w, h);
  hot ? qzg_cur = 32649;
  hot ? qzg_chip_help(lbl);
  qzg_col(on ? col : hot ? qzg_c_chiph : qzg_c_chip, 1);
  qzg_pill(x, y, w, h);
  qzg_font(11 * s, 1); qzg_col(on ? 0x0f1218 : hot ? qzg_c_tx : qzg_c_tx2, 1); qzg_text_c(lbl, x, y, w, h);
  lmb_down && hot ? ( lmb_down = 0; 1 ) : 0;
);

// ---- the dynamics panel (release 2, 2026-11-01): right of the editor's column when the window is 600 px wide or more.
// DYN: OFF (the band On), ABOVE (Mode Dyn above), BELOW (Dyn below), for Peak, Bell Prop Q and the shelves; then six
// fields: Threshold, Ratio, Range, Attack, Release, Release sync. A field: a vertical drag, the wheel, Ctrl + double-click
// for its default; the selection follows (qzg_targets). i = the band's control (7..12). ----
function qzg_dyn_lo(i) ( i == 7 ? -80 : i == 8 ? 1 : i == 9 ? -30 : i == 10 ? 0.1 : i == 11 ? 5 : 0; );
function qzg_dyn_hi(i) ( i == 7 ? 0 : i == 8 ? 20 : i == 9 ? 30 : i == 10 ? 500 : i == 11 ? 2000 : 21; );
function qzg_dyn_def(i) ( i == 7 ? -24 : i == 8 ? 4 : i == 9 ? -6 : i == 10 ? 10 : i == 11 ? 100 : 0; );
function qzg_dyn_lg(i) ( i == 8 || i == 10 || i == 11; );
function qzg_dyn_set(k, i, v) local(j) (
  v = max(qzg_dyn_lo(i), min(qzg_dyn_hi(i), v)); i == 12 ? v = floor(v + 0.5);
  j = 0; loop(16, qzg_targets(k, j) ? qzg_set(qzg_n(j, i), v); j += 1; );
);
// a dynamics field: its name in words over the box (the short name when the box is narrow), the value in the box;
// Attack and Release read "auto" while AUTO sets them (qzg_dau, from the panel)
function qzg_dyn_field(k, i, x, y, w, h, lbl, sl) local(s, v, hot) (
  s = qzg_s; v = qzg_v(k, i);
  hot = qzg_in(mx, my, x, y - 11 * s, w, h + 11 * s);
  hot ? qzg_cur = 32645;
  qzg_font(10 * s, 1); qzg_col(qzg_c_tx2, 1); qzg_text_l(qzg_tw(lbl) <= w - 4 * s ? lbl : sl, x + 2 * s, y - 11 * s, w, 11 * s);
  qzg_col(hot ? qzg_c_fldh : qzg_c_fld, 1); qzg_frr(x, y, w, h, 6 * s);
  (i == 10 || i == 11) && qzg_dau ? strcpy(#qzg_t, "auto") :
  i == 7 ? sprintf(#qzg_t, "%.0f dB", v) : i == 8 ? sprintf(#qzg_t, "%.1f:1", v) : i == 9 ? sprintf(#qzg_t, "%+.0f dB", v) :
  i == 10 ? sprintf(#qzg_t, v < 10 ? "%.1f ms" : "%.0f ms", v) : i == 11 ? sprintf(#qzg_t, "%.0f ms", v) :
  strcpy(#qzg_t, v < 1 ? "off" : v == 1 ? "1/64T" : v == 2 ? "1/64" : v == 3 ? "1/32T" : v == 4 ? "1/64." : v == 5 ? "1/32" :
         v == 6 ? "1/16T" : v == 7 ? "1/32." : v == 8 ? "1/16" : v == 9 ? "1/8T" : v == 10 ? "1/16." : v == 11 ? "1/8" :
         v == 12 ? "1/4T" : v == 13 ? "1/8." : v == 14 ? "1/4" : v == 15 ? "1/2T" : v == 16 ? "1/4." : v == 17 ? "1/2" :
         v == 18 ? "1/1T" : v == 19 ? "1/2." : v == 20 ? "1/1" : "1/1.");
  qzg_font(11 * s, 0);
  qzg_tw(#qzg_t) > w - 6 * s && i != 8 && i != 12 ? sprintf(#qzg_t, i == 10 && v < 10 ? "%.1f" : "%.0f", v);   // units off when narrow
  qzg_col(hot ? qzg_c_hot : qzg_c_tx, 1); qzg_text_c(#qzg_t, x, y, w, h);
  hot ? (
    qzg_hlp(i == 7 ? "Threshold (dB): where the band starts to move" : i == 8 ? "Ratio: how hard it moves past the threshold" :
            i == 9 ? "Range (dB): how far it may move; minus cuts, plus boosts" : i == 10 ? "Attack (ms): how fast it moves" :
            i == 11 ? "Release (ms): how fast it comes back" : "Release in time with the song (off: the Release time)");
    lmb_down ? (
      CTRL && qzg_now - qzg_dyt < qzg_dbl_t && qzg_dyl == k * 16 + i ? ( qzg_dyn_set(k, i, qzg_dyn_def(i)); qzg_dyt = 0; ) :
      ( qzg_dyt = qzg_now; qzg_dyl = k * 16 + i; qzg_ddrag = i; qzg_ddk = k; qzg_ddy = my; qzg_ddv = v; );
      lmb_down = 0;
    );
    frame_wheel != 0 ? (
      qzg_dyn_set(k, i, qzg_dyn_lg(i) ? v * 1.1 ^ sign(frame_wheel) : v + sign(frame_wheel) * (i == 12 ? 1 : i == 7 ? 1 : 0.5));
      frame_wheel = 0;
    );
  );
);
// the band's extras (ReEQ 2's; the host's qz_dyp block: Auto 0..15, linked 16..31, free detector Hz 32..47, octaves 48..63)
// a change here is no slider, so a hidden counter (slider 224) is bumped and automated: REAPER then reads the state
// again and marks the project changed (wiki 6.10's gk_ne_commit way)
function qzg_dyp_set(k, off, v) local(j) (
  !qzg_hrest ? qzg_hmark();            // an undo step, as a slider edit (the outside audit 2026-11-04)
  j = 0; loop(16, qzg_targets(k, j) ? qz_dyp[off + j] = v; j += 1; );
  qz_dydirty = (qz_dydirty + 1) % 1000000; slider_automate(qz_dydirty);
);
// a running dynamics-field drag (every window pass): 0.25 per px, log values over 300 px, sync one step per 12 px
function qzg_dyn_drag() local(d, i) (
  qzg_ddrag ? (
    LMB && qzg_live(qzg_ddk) ? (
      d = (qzg_ddy - my) / qzg_s; i = qzg_ddrag;
      i == 13 ? qzg_dyp_set(qzg_ddk, 32, max(20, min(20000, qzg_ddv * 1000 ^ (d / 300)))) :
      i == 14 ? qzg_dyp_set(qzg_ddk, 48, max(0.25, min(8, qzg_ddv + d / 40))) :
      qzg_dyn_set(qzg_ddk, i, qzg_dyn_lg(i) ? qzg_ddv * (qzg_dyn_hi(i) / qzg_dyn_lo(i)) ^ (d / 300) :
                               i == 12 ? qzg_ddv + d / 12 : qzg_ddv + d * 0.25);
    ) : qzg_ddrag = 0;
  );
);
// a free-detector field: d 0 = its frequency, 1 = its width (drag, wheel; Ctrl + double-click 1 kHz / 2 octaves)
function qzg_det_field(k, d, x, y, w, h, live) local(s, v, hot) (
  s = qzg_s; v = qz_dyp[(d ? 48 : 32) + k];
  hot = live && qzg_in(mx, my, x, y - 11 * s, w, h + 11 * s);
  hot ? qzg_cur = 32645;
  qzg_font(10 * s, 1); qzg_col(live ? qzg_c_tx2 : qzg_c_fnt, 1);
  strcpy(#qzg_t, d ? "Width" : "Listens at"); qzg_tw(#qzg_t) > w - 4 * s ? strcpy(#qzg_t, d ? "Wid" : "At");
  qzg_text_l(#qzg_t, x + 2 * s, y - 11 * s, w, 11 * s);
  qzg_col(hot ? qzg_c_fldh : qzg_c_fld, 1); qzg_frr(x, y, w, h, 6 * s);
  !live ? strcpy(#qzg_t, d ? "\xe2\x80\x94" : "own band") : d ? sprintf(#qzg_t, "%.1f oct", v) :
  v >= 1000 ? sprintf(#qzg_t, "%.1f kHz", v / 1000) : sprintf(#qzg_t, "%.0f Hz", v);
  qzg_font(11 * s, 0);
  qzg_tw(#qzg_t) > w - 6 * s ? ( !live ? strcpy(#qzg_t, d ? "\xe2\x80\x94" : "own") : d ? sprintf(#qzg_t, "%.1f", v) :
                                 v >= 1000 ? sprintf(#qzg_t, "%.1fk", v / 1000) : sprintf(#qzg_t, "%.0f", v); );
  qzg_col(!live ? qzg_c_off : hot ? qzg_c_hot : qzg_c_tx, 1); qzg_text_c(#qzg_t, x, y, w, h);
  hot ? (
    qzg_hlp(d ? "Width: how wide a range around Listens at the band hears, in octaves" : "Listens at: the frequency the band reacts to (OWN BAND off)");
    lmb_down ? (
      CTRL && qzg_now - qzg_dyt < qzg_dbl_t && qzg_dyl == k * 16 + 13 + d ? ( qzg_dyp_set(k, d ? 48 : 32, d ? 2 : 1000); qzg_dyt = 0; ) :
      ( qzg_dyt = qzg_now; qzg_dyl = k * 16 + 13 + d; qzg_ddrag = 13 + d; qzg_ddk = k; qzg_ddy = my; qzg_ddv = v; );
      lmb_down = 0;
    );
    frame_wheel != 0 ? (
      qzg_dyp_set(k, d ? 48 : 32, d ? max(0.25, min(8, v + 0.25 * sign(frame_wheel))) : max(20, min(20000, v * 2 ^ (sign(frame_wheel) / 12))));
      frame_wheel = 0;
    );
  );
);
// the lookahead field (every band): off, 1, 5 or 10 ms; a click or the wheel steps it
function qzg_la_field(x, y, w, h) local(s, hot) (
  s = qzg_s; hot = qzg_in(mx, my, x, y - 11 * s, w, h + 11 * s);
  hot ? qzg_cur = 32649;
  qzg_font(10 * s, 1); qzg_col(qzg_c_tx2, 1); strcpy(#qzg_t, "Lookahead"); qzg_tw(#qzg_t) > w - 4 * s ? strcpy(#qzg_t, "Look");
  qzg_text_l(#qzg_t, x + 2 * s, y - 11 * s, w, 11 * s);
  qzg_col(hot ? qzg_c_fldh : qzg_c_fld, 1); qzg_frr(x, y, w, h, 6 * s);
  qz_look < 0.5 ? strcpy(#qzg_t, "off") : sprintf(#qzg_t, "%d ms", qz_look < 1.5 ? 1 : qz_look < 2.5 ? 5 : 10);
  qzg_font(11 * s, 0); qzg_col(hot ? qzg_c_hot : qzg_c_tx, 1); qzg_text_c(#qzg_t, x, y, w, h);
  hot ? (
    qzg_hlp("Lookahead (every band): off, 1, 5 or 10 ms; adds that much latency. Click or wheel to step");
    lmb_down ? ( qzg_set(223, ((qz_look | 0) + 1) % 4); lmb_down = 0; );
    frame_wheel != 0 ? ( qzg_set(223, max(0, min(3, (qz_look | 0) + sign(frame_wheel)))); frame_wheel = 0; );
  );
);
// the panel's width: its button row in words, and five fields
function qzg_dyn_need() ( max(250 * qzg_s, qzg_chip_w("WHEN QUIET") + qzg_chip_w("AUTO") + qzg_chip_w("OWN BAND") +
                                           qzg_chip_w("LISTEN") + 9 * qzg_s); );
// where the band editor puts the dynamics (qzg_dpm): 1 beside the column (the column narrowing to 280 px for it; the
// user, 2026-11-03: "i liked dynamics on the same page as the peaks"), 2 on a page of its own behind the header's
// DYNAMICS button (only a window too narrow for both: never gone), 3 the "bells and shelves" note
// beside the column, 0 nothing; and the column's width and left edge (qzg_dcw, qzg_dc0)
function qzg_dcol(k) local(s, dn) (
  s = qzg_s;
  qzg_dcw = min(440 * s, gfx_w - 8 * s); qzg_dc0 = gfx_w >= 600 * s ? 4 * s : (gfx_w - qzg_dcw) / 2;
  qzg_dpm = 0;
  qz_dyn_able(qzg_shape(k)) ? (
    dn = qzg_dyn_need();
    gfx_w - 26 * s - qzg_dcw >= dn ? ( qzg_dpm = 1; qzg_dc0 = 4 * s; ) :
    gfx_w - 306 * s >= dn ? ( qzg_dpm = 1; qzg_dcw = gfx_w - 26 * s - dn; qzg_dc0 = 4 * s; ) : qzg_dpm = 2;
  ) : gfx_w >= 600 * s && gfx_w - 26 * s - qzg_dcw >= 170 * s ? qzg_dpm = 3;
);
function qzg_dyn_panel(k, x, y, w) local(s, m, j, fw, bx, bw, on, lk, au) (
  s = qzg_s; m = qzg_mode(k);
  qz_dyn_able(qzg_shape(k)) ? (
    // row 1 in words (the user, 2026-11-03: "the labels are confusing"): the mode (a click steps off -> WHEN LOUD ->
    // WHEN QUIET), AUTO, OWN BAND, LISTEN (the detector's headphones); the lookahead is a field
    bx = x; bw = qzg_chip_w("WHEN QUIET");
    strcpy(#qzg_t, m == 3 ? "WHEN LOUD" : m == 4 ? "WHEN QUIET" : "DYN OFF");
    qzg_chip(#qzg_t, bx, y + 28 * s, bw, 16 * s, m >= 3, qzg_bcol(k)) ? (
      j = 0; loop(16, qzg_targets(k, j) && qzg_on(j) && qz_dyn_able(qzg_shape(j)) ? qzg_set(qzg_n(j, 0), m == 2 ? 3 : m == 3 ? 4 : 2); j += 1; );
    );
    qzg_in(mx, my, bx, y + 28 * s, bw, 16 * s) ? qzg_hlp("Dynamics: off; WHEN LOUD the band moves as the sound gets loud; WHEN QUIET as it gets quiet");
    bx += bw + 3 * s;
    m >= 3 ? (
      au = qz_dyp[k] >= 0.5; lk = qz_dyp[16 + k] >= 0.5; qzg_dau = au;
      bw = qzg_chip_w("AUTO");
      qzg_chip("AUTO", bx, y + 28 * s, bw, 16 * s, au, qzg_bcol(k)) ? qzg_dyp_set(k, 0, !au);
      qzg_in(mx, my, bx, y + 28 * s, bw, 16 * s) ? qzg_hlp("Auto: Attack and Release set from the band's frequency");
      bx += bw + 3 * s; bw = qzg_chip_w("OWN BAND");
      qzg_chip("OWN BAND", bx, y + 28 * s, bw, 16 * s, lk, qzg_bcol(k)) ? qzg_dyp_set(k, 16, !lk);
      qzg_in(mx, my, bx, y + 28 * s, bw, 16 * s) ? qzg_hlp("Own band: the band reacts to its own frequencies; off: to Listens at and Width");
      bx += bw + 3 * s; bw = qzg_chip_w("LISTEN");
      on = qz_dlsn == k;
      qzg_chip("LISTEN", bx, y + 28 * s, bw, 16 * s, on, qzg_bcol(k)) ? qz_dlsn = on ? -1 : k;
      qzg_in(mx, my, bx, y + 28 * s, bw, 16 * s) ? qzg_hlp("Listen to what this band reacts to");
      // rows 2 and 3, each name over its box: Threshold Ratio Range Attack Release / Sync Listens at Width Lookahead
      fw = (w - 12 * s) / 5;
      qzg_dyn_field(k, 7, x, y + 56 * s, fw, 17 * s, "Threshold", "Thresh");
      qzg_dyn_field(k, 8, x + (fw + 3 * s), y + 56 * s, fw, 17 * s, "Ratio", "Ratio");
      qzg_dyn_field(k, 9, x + 2 * (fw + 3 * s), y + 56 * s, fw, 17 * s, "Range", "Range");
      qzg_dyn_field(k, 10, x + 3 * (fw + 3 * s), y + 56 * s, fw, 17 * s, "Attack", "Atk");
      qzg_dyn_field(k, 11, x + 4 * (fw + 3 * s), y + 56 * s, fw, 17 * s, "Release", "Rel");
      fw = (w - 9 * s) / 4;
      qzg_dyn_field(k, 12, x, y + 85 * s, fw, 17 * s, "Sync", "Sync");
      qzg_det_field(k, 0, x + (fw + 3 * s), y + 85 * s, fw, 17 * s, !lk);
      qzg_det_field(k, 1, x + 2 * (fw + 3 * s), y + 85 * s, fw, 17 * s, !lk);
      qzg_la_field(x + 3 * (fw + 3 * s), y + 85 * s, fw, 17 * s);
    ) : ( qzg_font(10 * s, 0); qzg_col(qzg_c_dim, 1);
          qzg_text_l("WHEN LOUD: the band moves as it gets loud; WHEN QUIET: as it gets quiet", x, y + 52 * s, w, 20 * s); );
  ) : ( qzg_font(10 * s, 0); qzg_col(qzg_c_dim, 1); qzg_text_l("Dynamics: bells and shelves only", x, y + 27 * s, w, 20 * s); );
);
function qzg_editor() local(s, x, y, w, k, sh, gl, j, step, bw, gx, cx, cut, style, k2, pl, on, nsel, cw, c0, qk, gw,
                            hh, hx, hp, hl, ls, hot, px)
(
  s = qzg_s; x = 4 * s; y = qzg_edy; w = gfx_w - 8 * s; k = qzg_prim;
  k >= 0 && !qzg_live(k) ? ( qzg_prim = k = -1; );
  qzg_obox(x, y, w, qzg_eh, 10 * s, qzg_c_pan, k >= 0 ? qzg_mix(qzg_bcol(k), qzg_c_win, 0.47) : qzg_c_line, 1);
  // header (24 px): the whole strip toggles the fold; the controls on its right win
  hh = qzg_in(mx, my, x, y, w, 24 * s);
  hh ? qzg_cur = 32649;
  qzg_col(hh ? qzg_c_tx : qzg_c_gly, 1); qzg_arrow(gfx_w - 19 * s, y + 13 * s, 4 * s, qzg_fold);
  hx = hp = hl = 0;
  k < 0 ? (
    qzg_font(11 * s, 1); qzg_col(qzg_c_dim, 1);
    strcpy(#qzg_t, qzg_live_count() ? "Click a dot or a band to edit it" : "No bands yet \xc2\xb7 double-click the graph to add one");
    qzg_fold ? qzg_text_l(#qzg_t, x + 13 * s, y, w - 40 * s, 26 * s) : qzg_text_c(#qzg_t, x, y + 22 * s, w, qzg_eh - 26 * s);
  ) : (
    sh = qzg_shape(k); on = qzg_on(k); nsel = qzg_sel_count();
    qzg_dcol(k);                       // where the dynamics go at this width (qzg_dpm)
    qzg_bandcol(k, 1); gfx_circle(17 * s, y + 13 * s, 4 * s, 1, 1);
    sprintf(#qzg_t, "Band %d \xc2\xb7 %s", qzg_dn[k] + 1, qzg_shape_name(sh));
    nsel > 1 ? ( sprintf(#qzg_t2, qzg_fold ? "  (+%d)" : "  (+%d selected)", nsel - 1); strcat(#qzg_t, #qzg_t2); );
    qzg_fold ? (
      strcat(#qzg_t, " \xc2\xb7 "); qzg_ftxt(#qzg_t2, qzg_v(k, 3)); strcat(#qzg_t, #qzg_t2);
      qzg_has_gain(sh) ? ( sprintf(#qzg_t2, " \xc2\xb7 %+.1f dB", qzg_v(k, 4)); strcat(#qzg_t, #qzg_t2); );
      qzg_has_q(sh) ? ( qzg_qtxt(#qzg_t3, qzg_v(k, 5));                 // the Pultec's Q is its dip: D, as the editor says
                        sprintf(#qzg_t2, sh == 10 ? " \xc2\xb7 D %s" : " \xc2\xb7 Q %s", #qzg_t3); strcat(#qzg_t, #qzg_t2); );
    );
    qzg_font(11 * s, 1); qzg_col(qzg_c_tx, 1);
    qzg_dpw = qzg_dpm == 2 && !qzg_fold ? qzg_chip_w("DYNAMICS") : 0;
    gfx_x = 27 * s; gfx_y = y; gfx_drawstr(#qzg_t, 4, gfx_w - 116 * s - (qzg_dpw ? qzg_dpw + 6 * s : 0), y + 26 * s);   // clipped before the controls
    hx = qzg_in(mx, my, gfx_w - 58 * s, y + 2 * s, 22 * s, 22 * s);
    hp = qzg_in(mx, my, gfx_w - 84 * s, y + 2 * s, 22 * s, 22 * s);
    hl = qzg_in(mx, my, gfx_w - 114 * s, y + 2 * s, 26 * s, 22 * s);
    hx ? qzg_hlp("Delete this band") : hp ? qzg_hlp("Band on / off (off keeps its settings)") :
    hl ? qzg_hlp("Listen to this band alone (Shift on the graph does it under the pointer)") :
    hh ? qzg_hlp("Fold or open the editor");
    qzg_font(15 * s, 1); qzg_col(hx ? 0xEB4D4D : qzg_c_gly, 1); qzg_text_c("\xc3\x97", gfx_w - 58 * s, y + 2 * s, 22 * s, 22 * s);
    on ? qzg_bandcol(k, 1) : qzg_col(hp ? qzg_c_tx2 : qzg_c_dim, 1);
    px = gfx_w - 73 * s;
    qzg_arcw(px, y + 14 * s, 5.25 * s, 0.63, 5.65, 1.5 * s);
    qzg_aline(px, y + 6 * s, px, y + 13 * s, 1.6 * s);
    // the headphones: this band alone, hands free (a radio button: one band at a time); a band-colour pill when on
    ls = qzg_lsn == k;
    ls ? ( qzg_bandcol(k, 1); qzg_pill(gfx_w - 112 * s, y + 4 * s, 22 * s, 18 * s); ) :
    hl ? ( qzg_col(qzg_c_chiph, 1); qzg_pill(gfx_w - 112 * s, y + 4 * s, 22 * s, 18 * s); );
    qzg_col(ls ? 0x0f1218 : hl ? qzg_c_tx : qzg_c_gly, 1);
    qzg_arcw(gfx_w - 101 * s, y + 15 * s, 5.75 * s, -1.5708, 1.5708, 1.5 * s);
    gfx_rect(gfx_w - 108 * s, y + 14 * s, 3 * s, 6 * s); gfx_rect(gfx_w - 97 * s, y + 14 * s, 3 * s, 6 * s);
    lmb_down && hx ? (                 // the editor moves on to the next band, selected alone, so x can be pressed again
      j = qzg_next_live(k); qzg_delete(k); j >= 0 ? qzg_sel_only(j); lmb_down = 0; k = -1;
    ) :
    lmb_down && hp ? ( qzg_toggle_power(k); lmb_down = 0; ) :
    lmb_down && hl ? ( qzg_lsn = ls ? -1 : k; lmb_down = 0; );
    // a window too narrow for the dynamics beside the band's settings: they take the editor's body, on this button
    qzg_dpw ? (
      qzg_chip("DYNAMICS", gfx_w - 118 * s - qzg_dpw, y + 5 * s, qzg_dpw, 16 * s, qzg_dpage, qzg_bcol(k)) ? qzg_dpage = !qzg_dpage;
      qzg_in(mx, my, gfx_w - 118 * s - qzg_dpw, y + 5 * s, qzg_dpw, 16 * s) ? qzg_hlp("Show this band's dynamics in place of its settings (the window is too narrow for both)");
    );
  );
  lmb_down && hh ? (
    qzg_fold ? ( qzv_fold = 0; qzg_fopen = 1; ) : ( qzv_fold = 1; qzg_fopen = 0; );
    lmb_down = 0;
  );
  // the column: 440 px at most, on the left from 600 px wide (release 2 puts the dynamics to its right), else centred
  !qzg_fold && k >= 0 ? (
    sh = qzg_shape(k); gl = qzg_glyph_of(sh); cut = qzg_is_cut(sh);
    cw = qzg_dcw; c0 = qzg_dc0;        // qzg_dcol: 440 px at most, narrower beside the dynamics
    qk = cw / 292;
    qzg_dpm == 2 && qzg_dpage ? qzg_dyn_panel(k, x + 10 * s, y, w - 20 * s) : (   // the dynamics' own page
    // 1. shape icons
    step = (cw - 12 * s) / 12; gx = c0 + 6 * s; gw = min(18 * s, step - 6 * s);
    j = 0;
    loop(12,
      hot = qzg_in(mx, my, gx + j * step, y + 27 * s, step - 2 * s, 20 * s);
      hot ? qzg_cur = 32649;
      hot ? qzg_hlp(j == 0 ? "Shape: bell" : j == 1 ? "Shape: low cut" : j == 2 ? "Shape: high cut" : j == 3 ? "Shape: low shelf" :
                    j == 4 ? "Shape: high shelf" : j == 5 ? "Shape: notch" : j == 6 ? "Shape: band pass" :
                    j == 7 ? "Shape: tilt shelf" : j == 8 ? "Shape: Pultec low shelf (boost with a dip above)" :
                    j == 9 ? "Shape: all pass (phase only)" : j == 10 ? "Shape: flat tilt, the whole range tilts" :
                    "Shape: flat gain, a volume-only band");
      j == gl ? qzg_bandcol(k, 1) : qzg_col(hot ? qzg_c_icoh : qzg_c_ico, 1);
      qzg_frr(gx + j * step, y + 27 * s, step - 2 * s, 20 * s, 6 * s);
      qzg_col(j == gl ? 0x0f1218 : hot ? qzg_c_tx : qzg_c_tx2, 1);
      // each type's own icon (never another's: a picked slot must look like itself), upside down while the band cuts
      // (a shape change keeps the gain, so that is what the pick plays)
      qzg_glyph(j + (qzg_gain_icon(j) && qzg_geff(k) < 0 ? 13 : 0), gx + j * step + (step - 2 * s - gw) / 2, y + 31 * s, gw,
                12 * s, 1.6 * s);
      lmb_down && hot ? (
        qzg_snap_targets(k);
        pl = 0;
        loop(16,
          qzg_bsel[pl] ? (
            // each band's own cut style (RES / BUTTER / ANLG) carries across sides; a bell keeps Prop Q
            style = qzg_shape(pl) == 2 || qzg_shape(pl) == 6 ? 1 : qzg_shape(pl) == 12 || qzg_shape(pl) == 13 ? 2 : 0;
            k2 = j == 0 ? (qzg_shape(pl) == 14 ? 14 : 0) : j == 1 ? (style == 1 ? 2 : style == 2 ? 12 : 1) :
                 j == 2 ? (style == 1 ? 6 : style == 2 ? 13 : 5) : j == 3 ? 3 : j == 4 ? 4 : j == 5 ? 7 : j == 6 ? 8 :
                 j == 7 ? 9 : j == 8 ? 10 : j == 9 ? 11 : j == 10 ? 15 : 16;
            qzg_set_shape(pl, k2);
          );
          pl += 1;
        );
        lmb_down = 0;
      );
      j += 1;
    );
    // 2. placement, then the cut style or PROP Q (all 16 px chips on one baseline)
    qzg_font(11 * s, 1); qzg_col(qzg_c_dim, 1); qzg_text_l("PLACE", c0 + 7 * s, y + 54 * s, 40 * s, 16 * s);
    cx = c0 + 46 * s; pl = qzg_place(k);
    j = 0;
    loop(5,
      strcpy(#qzg_t, j == 0 ? "ST" : j == 1 ? "M" : j == 2 ? "S" : j == 3 ? "L" : "R");
      bw = qzg_chip_w(#qzg_t);
      qzg_chip(#qzg_t, cx, y + 54 * s, bw, 16 * s, pl == j, qzg_bcol(k)) ? (
        k2 = 0; loop(16, qzg_targets(k, k2) ? qzg_set(qzg_n(k2, 1), j); k2 += 1; );
      );
      cx += bw + 3 * s; j += 1;
    );
    cx += 8 * s;
    cut ? (
      style = sh == 2 || sh == 6 ? 1 : sh == 12 || sh == 13 ? 2 : 0;
      j = 0;
      loop(3,
        strcpy(#qzg_t, j == 0 ? "RES" : j == 1 ? "BUTTER" : "ANLG");   // "BW" read as bandwidth (the user's rename)
        bw = qzg_chip_w(#qzg_t);
        cx + bw <= c0 + cw ? (
          qzg_chip(#qzg_t, cx, y + 54 * s, bw, 16 * s, style == j, qzg_bcol(k)) ? (
            qzg_snap_targets(k);
            pl = 0;
            loop(16,
              qzg_bsel[pl] && qzg_is_cut(qzg_shape(pl)) ? (    // each cut keeps its own side (low / high)
                k2 = qzg_shape(pl) == 1 || qzg_shape(pl) == 2 || qzg_shape(pl) == 12 ? (j == 0 ? 1 : j == 1 ? 2 : 12)
                                                                                      : (j == 0 ? 5 : j == 1 ? 6 : 13);
                qzg_set_shape(pl, k2);
              );
              pl += 1;
            );
          );
        );
        cx += bw + 3 * s; j += 1;
      );
    ) : gl == 0 ? (
      bw = qzg_chip_w("PROP Q");
      cx = min(cx, c0 + cw - bw - 6 * s);
      qzg_chip("PROP Q", cx, y + 54 * s, bw, 16 * s, sh == 14, qzg_bcol(k)) ? (
        pl = 0; loop(16, qzg_targets(k, pl) && qzg_glyph_of(qzg_shape(pl)) == 0 ? qzg_set(qzg_n(pl, 2), sh == 14 ? 0 : 14);
                     pl += 1; );
      );
    );
    // 3. values: one row, ending where the icon row ends
    cut ? (
      qzg_field(0, k, c0 + 6 * s, y + 77 * s, 74 * qk, 20 * s, 1, "F", 0);
      qzg_field(1, k, c0 + 6 * s + 78 * qk, y + 77 * s, 58 * qk, 20 * s, sh == 12 || sh == 13, "G", 2);
      qzg_stepper(2, k, c0 + 6 * s + 140 * qk, y + 77 * s, 52 * qk, 20 * s, qzg_res_cut(sh), 0);
      qzg_stepper(3, k, c0 + 6 * s + 196 * qk, y + 77 * s, cw - 14 * s - 196 * qk, 20 * s, qzg_has_slope(sh), 0);
    ) : (
      qzg_field(0, k, c0 + 6 * s, y + 77 * s, 96 * qk, 20 * s, 1, "F", 0);
      qzg_field(1, k, c0 + 6 * s + 100 * qk, y + 77 * s, 82 * qk, 20 * s, qzg_has_gain(sh), "G", 0);
      qzg_stepper(2, k, c0 + 6 * s + 186 * qk, y + 77 * s, cw - 14 * s - 186 * qk, 20 * s, qzg_has_q(sh), sh == 10 ? "D" : "Q");
    );
    // 4. dynamics, right of the column when there is room (qzg_dcol)
    qzg_dpm == 1 || qzg_dpm == 3 ? qzg_dyn_panel(k, c0 + cw + 10 * s, y, gfx_w - 12 * s - (c0 + cw + 10 * s));
    );
  );
);
// a running field drag (started in qzg_field): vertical; alt is 10x finer
function qzg_field_drag() local(dy, k, sp) (
  qzg_fdrag ? (
    LMB ? (
      k = qzg_fk;
      ALT !== qzg_fmod ? (             // re-anchor: Alt scales the distance from here on
        qzg_fy0 = my; qzg_fmod = ALT;
        qzg_fv0 = qzg_v(k, qzg_fdrag == 1 ? 3 : qzg_fdrag == 2 ? 4 : qzg_fdrag == 3 ? 5 : 6);
      );
      dy = qzg_fy0 - my; sp = ALT ? 0.1 : 1;
      abs(dy) >= 1 ? qzg_fmoved = 1;
      qzg_live(k) && qzg_fmoved ? (
        qzg_fdrag == 1 ? qzg_field_set(0, k, qzg_fv0 * 2 ^ (dy * sp / (60 * qzg_s))) :
        qzg_fdrag == 2 ? qzg_field_set(1, k, qzg_fv0 + dy * sp * 0.1 / qzg_s) :
        qzg_fdrag == 3 ? qzg_field_set(2, k, qzg_fv0 * 1.03 ^ (dy * sp / qzg_s)) :
                         qzg_field_set(3, k, floor(qzg_fv0 + dy / (12 * qzg_s) + 0.5));
      );
    ) : qzg_fdrag = 0;
  );
);

// ---- output bar: always visible at the bottom (the user, 2026-10-20), one row from 560 px wide, two below ----
// a knob: arc over lo..hi; a bipolar one draws its arc from the top (lo = -hi); hot = under the pointer or being dragged:
// it swells by a pixel (the house's hover: never a ring). Label regular 10 px (a bold 10 px "S" reads as "$"), value
// regular 11.
function qzg_knob(x, y, r, v, lo, hi, col, lbl, val, bip, hot) local(s, a0, a1, av) (
  s = qzg_s;
  hot ? r += 1 * s;
  qzg_col(qzg_c_kbg, 1); gfx_circle(x, y, r, 1, 1);
  qzg_col(qzg_c_ktr, 1); qzg_arcw(x, y, r - 2.7 * s, -2.356, 2.356, 2.4 * s);   // 2.4 px at 100 %: three arcs 0.7 apart
  av = -2.356 + 4.712 * max(0, min(1, (v - lo) / (hi - lo)));
  a0 = bip ? min(0, av) : -2.356; a1 = bip ? max(0, av) : av;
  a1 > a0 + 0.01 ? ( qzg_col(col, 1); qzg_arcw(x, y, r - 2.7 * s, a0, a1, 2.4 * s); );
  qzg_col(qzg_c_kpt, 1); qzg_aline(x, y, x + sin(av) * (r - 3.5 * s), y - cos(av) * (r - 3.5 * s), 1.6 * s);
  qzg_font(10 * s, 0); qzg_col(qzg_c_lbl, 1); qzg_text(lbl, x + 15 * s, y - 13 * s);
  qzg_font(11 * s, 0); qzg_col(hot ? qzg_c_hot : qzg_c_tx, 1); qzg_text(val, x + 15 * s, y - 1 * s);
);
function qzg_outbar() local(s, y, x, r, j, v, n, cx, cy, sp, ms, hot, bh, hx, hy, hw)
(
  s = qzg_s; y = qzg_oby; r = 9 * s; bh = qzg_obh - 4 * s;
  qzg_obox(4 * s, y, gfx_w - 8 * s, bh, 8 * s, qzg_c_drw, qzg_c_line, 1);
  ms = qz_st_mode < 0.5;
  sp = qzg_wide ? 61 * s : 58 * s;    // five knobs since the input trim (2026-10-31) in the four's old width
  j = 0;
  loop(5,
    x = 20 * s + j * sp; cy = y + 15 * s;
    n = j == 0 ? 222 : j == 1 ? 209 : j == 2 ? 215 : j == 3 ? 210 : 211;
    v = slider(n);
    hx = x - r - 3 * s; hy = cy - r - 3 * s; hw = sp - 4 * s;
    hot = qzg_kdrag == n || (!qzg_kdrag && !qzg_fdrag && qzg_drag < 0 && !qzg_box && qzg_in(mx, my, hx, hy, hw, 2 * r + 6 * s));
    hot ? qzg_cur = 32645;
    hot ? qzg_hlp(j == 0 ? "Input trim, before the bands: drag or wheel; double-click for 0 dB" :
                  j == 1 ? "Output gain: drag or wheel; double-click for 0 dB" :
                  j == 2 ? "Scale: every band's gain at once, 0 to 200 %; double-click for 100 %" :
                  j == 3 ? (ms ? "Mid gain: drag or wheel; double-click for 0 dB" : "Left gain: drag or wheel; double-click for 0 dB") :
                  (ms ? "Side gain: drag or wheel; double-click for 0 dB" : "Right gain: drag or wheel; double-click for 0 dB"));
    hot && !qzg_kdrag ? (
      lmb_down ? (
        qzg_now - qzg_kn_t < qzg_dbl_t && qzg_kn_last == n ? ( qzg_set(n, j == 2 ? 100 : 0); qzg_kn_t = 0; ) : (
          qzg_kn_t = qzg_now; qzg_kn_last = n; qzg_kdrag = n; qzg_ky0 = my; qzg_kv0 = v; qzg_kmod = ALT; qzg_kmoved = 0; );
        lmb_down = 0;
      );
      frame_wheel != 0 ? (            // a notch: 0.5 dB, or 5 % on SCALE
        qzg_set(n, j == 2 ? max(0, min(200, qzg_round(v + 5 * frame_wheel, 0.1)))
                          : max(j == 0 ? -30 : -136, min(30, qzg_round(max(-30, v) + 0.5 * frame_wheel, 0.01))));
        frame_wheel = 0; v = slider(n);
      );
    );
    j == 2 ? sprintf(#qzg_t, "%d %%", v + 0.5) : qzg_dbtxt(#qzg_t, v);
    qzg_knob(x, cy, r, v, j == 2 ? 0 : -30, j == 2 ? 200 : 30,
             j <= 1 ? qzg_c_tx : j == 2 ? qzg_c_acc : j == 3 ? 0x9AA3FF : 0xAD70F5,
             j == 0 ? "IN" : j == 1 ? "OUT" : j == 2 ? "SCALE" : j == 3 ? (ms ? "MID" : "L") : (ms ? "SIDE" : "R"), #qzg_t, j != 2, hot);
    j += 1;
  );
  // the buttons: after the knobs on one row, or a second row under them
  cx = qzg_wide ? 20 * s + 5 * sp - 6 * s : 12 * s;
  cy = qzg_wide ? y + 6 * s : y + 32 * s;
  qzg_chip("M/S", cx, cy, 36 * s, 18 * s, ms, 0x9AA3FF) ? qzg_set(212, 0);
  qzg_chip("L/R", cx + 39 * s, cy, 32 * s, 18 * s, !ms, 0x9AA3FF) ? qzg_set(212, 1);
  qzg_chip(ms ? "\xc3\x98M" : "\xc3\x98L", cx + 79 * s, cy, 34 * s, 18 * s, qz_ml_pol >= 0.5, 0xF07A5A) ?
    qzg_set(213, qz_ml_pol >= 0.5 ? 0 : 1);
  qzg_chip(ms ? "\xc3\x98S" : "\xc3\x98R", cx + 117 * s, cy, 32 * s, 18 * s, qz_sr_pol >= 0.5, 0xF07A5A) ?
    qzg_set(214, qz_sr_pol >= 0.5 ? 0 : 1);
  qzg_chip("LIMIT", cx + 157 * s, cy, 44 * s, 18 * s, qz_limit >= 0.5, 0xEB4D4D) ? qzg_set(217, qz_limit >= 0.5 ? 0 : 1);
  // auto gain (build step 2; ReEQ's AGC and "S"): AUTO switches it and, while on, reads the correction it applies;
  // SET, shown while it is on, bakes that correction into OUT and switches it off. The engine does the bake in @block
  // (qzm_bake counts the requests: written only here, a window pass), so OUT takes the gain over without a step.
  ag = qz_agc >= 0.5;
  v = floor(qz_ag_db * 10 + 0.5) / 10;
  ag ? sprintf(#qzg_t, "AUTO %+.1f", abs(v) < 0.05 ? 0 : v) : strcpy(#qzg_t, "AUTO");
  qzg_chip(#qzg_t, cx + 209 * s, cy, qzg_agw, 18 * s, ag, 0x5BC88A) ? qzg_set(216, ag ? 0 : 1);
  ag ? ( qzg_chip("SET", cx + 212 * s + qzg_agw, cy, qzg_stw, 18 * s, 0, 0x5BC88A) ? atomic_add(qzm_bake, 1); );
);
// a running knob drag: 0.1 dB per px (1 % for SCALE); alt is 10x finer; a gain drag starts from -30 at the lowest
function qzg_knob_drag() local(dy, v) (
  qzg_kdrag ? (
    LMB ? (
      ALT !== qzg_kmod ? ( qzg_ky0 = my; qzg_kv0 = slider(qzg_kdrag); qzg_kmod = ALT; );   // re-anchor on Alt
      abs(qzg_ky0 - my) >= 1 ? qzg_kmoved = 1;
      qzg_kmoved ? (
        dy = (qzg_ky0 - my) * (ALT ? 0.1 : 1) / qzg_s;
        v = qzg_kdrag == 215 ? max(0, min(200, qzg_kv0 + dy)) : max(qzg_kdrag == 222 ? -30 : -136, min(30, max(-30, qzg_kv0) + dy * 0.1));
        qzg_set(qzg_kdrag, qzg_round(v, qzg_kdrag == 215 ? 0.1 : 0.01));
      );
    ) : qzg_kdrag = 0;
  );
);

// ---- graph gestures (ReEQ, spec §3) ----
// Anchors for every band. ReEQ's Band_Invert_dB: when the grabbed band sits above 0 dB, every other band below 0 dB
// moves the opposite way vertically (and the reverse). Taken at the grab and again when alt or ctrl changes.
function qzg_drag_start(k) local(j, by, nd) (
  by = qzg_node_db(k);
  j = 0;
  loop(16,
    qzg_af[j] = qzg_v(j, 3); qzg_ag[j] = qzg_v(j, 4); qzg_aq[j] = qzg_v(j, 5);
    nd = qzg_node_db(j);
    qzg_ai[j] = j != k && (qzg_has_gain(qzg_shape(j)) || qzg_res_cut(qzg_shape(j))) && (by > 0 ? nd < 0 : nd > 0);
    j += 1;
  );
  qzg_dx0 = mx; qzg_dy0 = my; qzg_dmod = ALT * 2 + CTRL;
  qzg_lax = 0;                         // the locked drag's axis, not chosen yet
);
function qzg_drag_move() local(j, dx, dy, sp, sh, d, fr, gs) (
  (ALT * 2 + CTRL) !== qzg_dmod ? qzg_drag_start(qzg_drag);
  abs(mx - qzg_dx0) + abs(my - qzg_dy0) > 5 * qzg_s ? ( qzg_moved = 1; qzg_click_t = 0; );   // a moved drag is no first click
  qzg_moved ? (
    // Ctrl+Alt: the locked drag (step 7; the user, 2026-10-30: "Ctrl+Alt, first move"): the drag keeps to the way it
    // first moved, sideways = frequency only, up / down = gain only (a resonant cut's height). ReEQ's Ctrl alone (the
    // Q lock) and Alt alone (fine) stay; Ctrl+Alt is not fine.
    CTRL && ALT && !qzg_lax ? qzg_lax = abs(mx - qzg_dx0) >= abs(my - qzg_dy0) ? 1 : 2;
    sp = ALT && !CTRL ? 1 / 6 : 1;
    dx = (mx - qzg_dx0) * sp; dy = (my - qzg_dy0) * sp;
    CTRL && ALT ? ( qzg_lax == 1 ? dy = 0 : dx = 0; );
    fr = exp(QZG_LF * dx / qzg_gw);
    gs = max(0.01, qz_scale / 100);
    j = 0;
    loop(16,
      qzg_sel[j] && qzg_live(j) ? (
        sh = qzg_shape(j);
        qzg_setf(j, qzg_af[j] * fr);
        CTRL && !ALT ? (               // Q lock: gain stays, up = narrower (not the cuts)
          qzg_has_q(sh) && !qzg_is_cut(sh) ? qzg_setq(j, qzg_aq[j] * 1.03 ^ (-dy / qzg_s));
        ) : (
          d = dy / qzg_ghalf * qzg_r * (qzg_ai[j] ? 1 : -1);
          qzg_res_cut(sh) ? (
            qzg_slope(j) >= 1 ? qzg_setq(j, qzg_cut_q(qzg_slope(j), max(-qzg_r, min(qzg_r, qzg_cut_db(qzg_slope(j), qzg_aq[j]) + d))));
          ) : qzg_has_gain(sh) ? qzg_setg(j, qzg_round(qzg_ag[j] + d / gs, 0.1));
        );
      );
      j += 1;
    );
  );
);
// The box select, on its press and every held pass (ReEQ select_nodes_in_box 2917-2943, run every frame 4795-4815): mode
// 1 = the dots inside alone, mode 2 (ctrl) = the press-time selection with the dots inside flipped; a band that does not
// exist is never selected. Then the editor's band: the selected dot nearest the pointer within 70 px (ReEQ 2939-2942
// takes any band there; here only a selected one, since the editor's edits fan out over the selection only when its band
// is in it), else the one it had while that is still selected, else the highest-numbered selected dot inside the box,
// else the lowest selected one, else none.
function qzg_box_apply() local(j, x, y, v, bx0, by0, bx1, by1, n, bd, d, fb) (
  bx0 = min(qzg_bx0, qzg_bx); bx1 = max(qzg_bx0, qzg_bx); by0 = min(qzg_by0, qzg_by); by1 = max(qzg_by0, qzg_by);
  n = -1; fb = -1; bd = 4900 * qzg_s * qzg_s + 0.001; j = 0;
  loop(16,
    qzg_live(j) ? (
      x = qzg_f2x(qzg_v(j, 3)); y = qzg_node_y(j);
      v = x >= bx0 && x <= bx1 && y >= by0 && y <= by1;
      qzg_sel[j] = qzg_box == 2 ? (v ? !qzg_bsel[j] : qzg_bsel[j]) : v;
      qzg_sel[j] ? (
        v || fb < 0 ? fb = j;
        d = (x - qzg_bx) * (x - qzg_bx) + (y - qzg_by) * (y - qzg_by);
        d < bd ? ( bd = d; n = j; );
      );
    ) : qzg_sel[j] = 0;
    j += 1;
  );
  n < 0 && qzg_prim >= 0 && qzg_live(qzg_prim) && qzg_sel[qzg_prim] ? n = qzg_prim;
  qzg_prim = n >= 0 ? n : fb;
);
function qzg_graph_input() local(k, s, inr, j, sh) (
  s = qzg_s;
  inr = qzg_in(mx, my, 0, 30 * s, gfx_w, qzg_gbot - 30 * s) && !qzg_in(mx, my, 8 * s, 34 * s, 44 * s + qzg_bpw, 18 * s);
  qzg_lgd && !LMB ? qzg_lgd = 0;
  qzg_drag >= 0 ? (
    LMB ? qzg_drag_move() : (
      // an unmoved click on a dot that was already selected: a plain one keeps only it; a ctrl one takes it out of the
      // selection (ReEQ 4477-4510: ctrl + press never deselects at once, so a ctrl drag of a selected dot sets the Q of
      // the whole selection; only a still release deselects)
      // (the editor's band then goes back to the one it had before the press, while that is still selected: the review)
      !qzg_moved && qzg_dwas && !qzg_dnew ? (
        qzg_dctrl ? (
          qzg_sel[qzg_drag] = 0;
          qzg_prim = qzg_dprim >= 0 && qzg_dprim != qzg_drag && qzg_live(qzg_dprim) && qzg_sel[qzg_dprim] ? qzg_dprim : -1;
        ) : qzg_sel_only(qzg_drag);
      );
      qzg_drag = -1;
    );
  ) : qzg_box ? (
    LMB ? ( qzg_bx = mx; qzg_by = my; qzg_box_apply(); ) : qzg_box = 0;   // live while held (ReEQ 4795-4815)
  ) : inr ? (
    k = qzg_hit(mx, my, 14 * s);
    lmb_down && SHIFT && k < 0 ? (
      qzg_lgd = 1; lmb_down = 0;       // Shift + press on empty graph: the free listen's boost while held (no box)
    );
    lmb_down ? (
      qzg_dnew = 0;
      qzg_now - qzg_click_t < qzg_gdbl_t && abs(mx - qzg_click_x) < 28 * s && abs(my - qzg_click_y) < 28 * s ? (
        qzg_click_t = 0;               // double-click: a dot toggles (alt deletes it); empty space adds a band
        k < 0 && qzg_click_k >= 0 && qzg_live(qzg_click_k) ? k = qzg_click_k;   // the dot the first press took
        k >= 0 ? ( ALT && !qzg_simple ? ( qzg_delete(k); k = -1; ) : qzg_toggle_power(k); )
               : !ALT && !qzg_simple ? ( k = qzg_new_band(qzg_x2f(mx), qzg_y2d(my), -1); qzg_dnew = 1; );
      ) : ( qzg_click_t = qzg_now; qzg_click_x = mx; qzg_click_y = my; qzg_click_k = k; );
      k >= 0 ? (
        qzg_dwas = qzg_sel[k]; qzg_dctrl = CTRL; qzg_dprim = qzg_prim;
        CTRL ? ( qzg_sel[k] = 1; qzg_prim = k; )            // ctrl adds and drags (with ctrl held: the Q lock)
             : ( !qzg_sel[k] ? qzg_sel_only(k) : qzg_prim = k; );
        qzg_drag = k; qzg_moved = 0; qzg_drag_start(k);
      ) : (
        qzg_box = CTRL ? 2 : 1; qzg_bx0 = qzg_bx = mx; qzg_by0 = qzg_by = my;
        qzg_lsn = -1;                  // a press on empty graph stops the headphones (ReEQ)
        j = 0; loop(16, qzg_bsel[j] = qzg_sel[j]; j += 1; );
        qzg_box_apply();               // a plain press empties the selection at once (ReEQ 4653 + 4815)
      );
      lmb_down = 0;
    );
    rmb_down && k >= 0 && !qzg_simple ? ( !qzg_sel[k] ? qzg_sel_only(k) : qzg_prim = k; qzg_node_menu(k); rmb_down = 0; ) :
    rmb_down ? ( qzg_graph_menu(); rmb_down = 0; );   // on empty graph: the graph's own menu
    frame_wheel != 0 ? (               // wheel = Q, ctrl+wheel = slope, on the nearest dot within 70 px (ReEQ)
      k = qzg_hit(mx, my, 70 * s);
      k >= 0 ? (
        j = 0;
        loop(16,
          qzg_targets(k, j) ? (
            sh = qzg_shape(j);
            CTRL ? ( qzg_has_slope(sh) ? qzg_slope_keep(j, qzg_sl10_step(qzg_slope(j), frame_wheel)); )
                 : ( qzg_has_q(sh) && !qzg_is_cut(sh) ? qzg_setq(j, qzg_v(j, 5) * 1.12 ^ frame_wheel); );
          );
          j += 1;
        );
      ) : SHIFT ? (
        qzg_lw = max(0.01, min(0.3, qzg_lw + 0.005 * frame_wheel));   // off the dots: the free listen's width, up = wider
      );
      frame_wheel = 0;
    );
  );
);

// ---- listen (build step 4b, spec §3) ----
// What plays (0 off, 1..16 a band, 17 the free listen at the pointer): while Shift is held, what is under the pointer
// in the graph (the dot within reach, else the free listen; a dot being dragged keeps playing; a Shift press on empty
// graph holds the free listen and boosts it to the dB under the pointer); otherwise the band whose headphones are on.
// The headphones follow the editor's band, so the editor's button always says what plays: they are -1 or the primary
// band, and they stop on delete, on a press on empty graph (ReEQ), and when the window reopens.
function qzg_listen_src() local(s, k, ok, src) (
  s = qzg_s;
  qzg_lsn >= 0 ? ( qzg_prim >= 0 && qzg_live(qzg_prim) ? ( qzg_lsn = qzg_prim; ) : ( qzg_lsn = -1; ); );
  ok = SHIFT && !qzg_box && !qzg_fdrag && !qzg_kdrag && !rkm_on && !qzg_th_st;
  src = 0;
  ok && qzg_drag >= 0 ? ( src = qzg_drag + 1; ) :
  ok && qzg_lgd && LMB ? ( src = 17; ) :
  ok && qzg_in(mx, my, 0, 30 * s, gfx_w, qzg_gbot - 30 * s) && !qzg_in(mx, my, 8 * s, 34 * s, 44 * s + qzg_bpw, 18 * s) ? (
    k = qzg_hit(mx, my, 14 * s); src = k >= 0 ? k + 1 : 17;
  ) :
  qzg_lsn >= 0 ? ( src = qzg_lsn + 1; );
  src;
);
// the free listen's boost: the dB under the pointer while the Shift press is held, inside the graph's range
function qzg_listen_boost() ( qzg_lgd && LMB ? max(-qzg_r, min(qzg_r, qzg_y2d(my))) : 0; );
// The post to the audio side, after all of a drawn pass's input (a skipped pass changed nothing: it renews only the
// heartbeat). Kept global on purpose: qzm_* is the listen mailbox, written only here in window passes and read only in
// @block (the plugin's @init says how). The payload first, one write each; the selector last, and only on a change.
// The strip never posts: a strip pass posting "off" would fight the window's passes while both draw; the heartbeat
// ends a listen within 0.5 s of the window closing.
function qzg_listen_post() local(src) (
  src = qzg_listen_src();
  src == 17 ? ( qzm_f = qzg_x2f(mx); qzm_w = qzg_lw; qzm_lg = qzg_listen_boost(); );
  src !== qzm_src ? atomic_set(qzm_src, src);
  qzm_hb = qzg_now;
);
// The range that plays, from the engine's own edge functions, so the picture is what is heard: qzg_llo / qzg_lhi
// (Hz, inside 10 .. 0.49 x srate) and whether each is a real edge (qzg_lle / qzg_lhe; 10 and 22050 mean "none").
function qzg_listen_range(src) local(k, sh, f, q, g, fmax) (
  fmax = 0.49 * srate;
  src == 17 ? (
    f = qzg_x2f(mx); qzg_llo = qz_listen_lo(-1, f, 0.7071, 0, qzg_lw); qzg_lhi = qz_listen_hi(-1, f, 0.7071, 0, qzg_lw);
  ) : (
    k = src - 1; sh = qzg_shape(k); f = qzg_v(k, 3); q = max(0.1, qzg_v(k, 5)); g = qzg_v(k, 4) * qz_scale / 100;
    qzg_llo = qz_listen_lo(sh, f, q, g, 0); qzg_lhi = qz_listen_hi(sh, f, q, g, 0);
  );
  qzg_lle = qzg_llo > QZG_FMIN; qzg_lhe = qzg_lhi < QZG_FMAX;
  qzg_llo = max(QZG_FMIN, min(fmax, qzg_llo)); qzg_lhi = max(QZG_FMIN, min(fmax, qzg_lhi));
);
// a dashed vertical line, 3 on 3 (the mock's edges)
function qzg_dash_v(x, y0, y1) local(y, d, n) (
  d = max(1, floor(qzg_s)); x = floor(x - d / 2); y = y0;
  n = ceil((y1 - y0) / (6 * qzg_s));
  loop(n, gfx_rect(x, y, d, min(3 * qzg_s, y1 - y)); y += 6 * qzg_s; );
);
// under the dots: the graph dimmed outside the range, its edges dashed in the band's colour (the accent for the free
// listen), and the free listen's boost line while held
function qzg_draw_listen(src) local(s, x0, x1, y) (
  s = qzg_s;
  qzg_listen_range(src);
  x0 = qzg_f2x(qzg_llo); x1 = qzg_f2x(qzg_lhi);
  qzg_col(qzg_p_dov, qzg_p_dova);
  qzg_lle && x0 > qzg_gx ? gfx_rect(qzg_gx, qzg_gy, x0 - qzg_gx, qzg_gh);
  qzg_lhe && x1 < qzg_gx + qzg_gw ? gfx_rect(x1, qzg_gy, qzg_gx + qzg_gw - x1, qzg_gh);
  src == 17 ? qzg_col(qzg_p_acc, 0.9) : qzg_bandcol(src - 1, 0.9);
  qzg_lle ? qzg_dash_v(x0, 30 * s, qzg_gbot);
  qzg_lhe ? qzg_dash_v(x1, 30 * s, qzg_gbot);
  src == 17 && qzg_lgd && LMB ? (
    y = floor(qzg_d2y(qzg_listen_boost()));
    qzg_col(qzg_p_acc, 1); gfx_rect(x0, y - floor(s), max(1, x1 - x0), max(2, floor(2 * s)));
  );
);
// over the dots: the banner, "LISTENING · BAND n" (or the free listen's frequency and boost) on the band's colour
function qzg_draw_listen_banner(src) local(s, w, h, x, y) (
  s = qzg_s;
  src == 17 ? (
    strcpy(#qzg_t, "LISTENING \xc2\xb7 "); qzg_note(#qzg_t2, qzg_x2f(mx)); strcat(#qzg_t, #qzg_t2);   // ReEQ's listen readout
    strcat(#qzg_t, " \xc2\xb7 "); qzg_ftxt(#qzg_t2, qzg_x2f(mx)); strcat(#qzg_t, #qzg_t2);
    qzg_lgd && LMB ? ( sprintf(#qzg_t2, " \xc2\xb7 %+.1f dB", qzg_listen_boost()); strcat(#qzg_t, #qzg_t2); );
  ) : sprintf(#qzg_t, "LISTENING \xc2\xb7 BAND %d", qzg_dn[src - 1] + 1);
  qzg_font(11 * s, 1);
  w = qzg_tw(#qzg_t) + 20 * s; h = 18 * s;
  x = floor((gfx_w - w) / 2); y = 38 * s;
  src == 17 ? qzg_col(qzg_p_acc, 1) : qzg_bandcol(src - 1, 1);
  qzg_pill(x, y, w, h);
  qzg_col(0x0f1218, 1); qzg_text_c(#qzg_t, x, y, w, h);
);

// The dots (with their stems, rings, numbers and placement tags) show only while the real pointer is over the window or
// a gesture holds it (ReEQ 2329-2331, 4313-4329: a dot drag or a box; Quezy adds its field and knob drags and an open
// menu, which belong to a dot or move them all). mouse_x, not mx: the menu and theme gates move mx off the canvas.
// SHOW DOTS (the user, 2026-11-03: dots that vanish with the pointer read as missing): ALWAYS (qzv_dots 0, the
// default) or ON HOVER (1, ReEQ's way)
function qzg_dots_shown() (
  !qzv_dots || qzg_in(mouse_x, mouse_y, 0, 0, gfx_w, gfx_h) || qzg_drag >= 0 || qzg_box || qzg_fdrag || qzg_kdrag || rkm_on;
);

// ---- redraw only on a change (the host sets gfx_clear = -1, so a skipped pass keeps the last picture) ----
// What the picture depends on: the canvas, the scale, the rate, the pointer and buttons, the view state, the
// selection and every slider. A pass redraws when that changes, after any pass with input (a click handled late in
// the pass changes state the pass had already drawn), after a gap (a window that reopens has a blank canvas; an open
// menu is dropped then), while the menu is open or a hover ramp still moves, on the primary dot's pulse (15 a second)
// and at least once a second. A resize changes the canvas, so a resizing window redraws every pass (never a held
// picture over a resize). Per surface: two strips of one plugin alternate.
function qzg_sig() local(h, k) (
  // the pointer counts in a strip (it can pick a dot from just outside its canvas) and over the window; once it has left
  // the window nothing drawn depends on where it is, so moves out there stop redrawing (the pass it leaves still does)
  h = gfx_w * 3.1 + gfx_h * 7.3 + gfx_ext_retina * 11.7 + srate * 0.0013 +
      ((gfx_ext_flags & 1) || qzg_dots_shown() ? mx * 13.1 + my * 17.3 : -7.77) + mouse_cap * 19.7 +
      qzv_range * 23.1 + qzv_fold * 29.3 + qzg_prim * 37.1 + qzg_drag * 41.3 + qzg_box * 43.7 +
      qzg_fdrag * 47.1 + qzg_kdrag * 53.3 + qzg_moved * 57.7 + qzg_fopen * 61.9;
  k = 0; loop(16, h += qzg_sel[k] * (k + 1) * 59.1; k += 1; );
  k = 1; loop(221, h += slider(k) * sqrt(k + 1.618) * 73.1; k += 1; );
  h += gmem[GS_THEME_ID] * 0.37 + gmem[GS_THEME_CUR] * 0.53 + gmem[GS_THEME_KNOB_P] * 11.3 + rkth_local_off * 79.3 +
       rkth_cl_open * 83.9 + rkth_open * 89.3 + rkth_dd_open * 97.7 + qzg_lsn * 101.3 + qzg_lw * 1031.7 + qzg_lgd * 107.9 +
       qzv_renum * 109.1 + qzg_ed * 113.3 + qzg_em * 127.1 + qzg_eopen * 131.9 +
       qzv_wb * 137.3 + qzv_wn * 149.9 + qzv_sb * 151.7 + qzv_sn * 157.3 +   // the looks (gate 4)
       qzv_an_mode * 163.1 + qzv_an_disp * 167.3 + qzv_an_ceil * 173.9 + qzv_an_floor * 179.1 + qzv_an_tilt * 181.7 +
       qzv_an_win * 191.3 + qzv_an_fft * 193.9 + qzv_an_pre * 197.1 + qzv_an_peaks * 199.7 + qzv_an_piano * 211.3 +
       qzv_an_decay * 223.1 + qzv_an_smooth * 229.9 + qzv_an_strip * 227.7 + qzg_an_frz * 229.3 + qzv_an_phase * 233.7 +   // the analyser (gate 5)
       qzv_nlook * 239.1 + qzv_dots * 241.3 + qzv_txt * 251.9 +               // the native look (gate 6); gate 13
       qzg_hcur * 241.3 + qzg_htop * 251.1 + qzg_hdirty * 257.9 + qzv_ab * 263.3 +   // undo / redo, A / B
       qzm_byp * 269.9 + (qzm_byp > 0 ? floor(qz_byp_db * 10 + 0.5) * 271.3 : 0) +   // the bypass and its gain
       qz_cut_law * 277.1 +                                                           // the resonant cuts' law (an older save's check)
       qzv_swheel * 281.3 + qzg_skh * 283.7 + qzg_skd * 293.9 +                       // simple mode's knob strip
       qzv_simple * 307.1 + qzg_sdd * 0.0311;                                                     // simple mode
  // the window's AUTO chip reads the correction live (0.1 dB steps); a strip draws no output bar
  !(gfx_ext_flags & 1) && qz_agc >= 0.5 ? h += floor(qz_ag_db * 10 + 0.5) * 139.7;
  h;
);
// a reacting band's resting curve, dotted (the spare display object, snapped on the static setting, read at 96 points)
function qzg_dyn_rest() local(k, i, x, f, y, ly, on) (
  k = 0;
  loop(16,
    qzg_on(k) && abs(qz_dyng[k]) > 0.1 && qz_dyn_able(qzg_shape(k)) ? (
      qzg_bx.run_sr = srate;
      qzg_bx.qzg_rec_in();           // the spare's retarget on the face's workspace too (qzg_retarget's note)
      qzg_w.qz_band_shape(qzg_shape(k), min(max(qzg_v(k, 3), 10), 0.49 * srate), qzg_geff(k), max(0.1, qzg_v(k, 5)),
                          qzg_slope(k), 0.49 * srate);
      qzg_w.filter.rk_svf_set_to_target();
      qzg_bx.qzg_rec_out();
      qzg_bandcol(k, 0.55);
      i = 0; ly = 0; on = 1;
      loop(97,
        x = qzg_gx + qzg_gw * i / 96;
        f = QZG_FMIN * exp(QZG_LF * i / 96);
        y = qzg_d2y(20 * log10(max(10 ^ -9, qzg_bx.filter.rk_svfm_magnitude(min(f, 0.49 * srate), srate))));
        i > 0 && on ? gfx_line(x - qzg_gw / 96, ly, x, y);
        on = !on; ly = y; i += 1;
      );
    );
    k += 1;
  );
);
// a free detector's node: a small diamond near the graph's foot at its frequency (drag it sideways: qzg_det_drag)
function qzg_det_nodes() local(k, x, y, r) (
  r = 4 * qzg_s; y = qzg_gy + qzg_gh - 40 * qzg_s;
  k = 0;
  loop(16,
    qzg_on(k) && qzg_mode(k) >= 3 && qz_dyn_able(qzg_shape(k)) && qz_dyp[16 + k] < 0.5 ? (
      x = qzg_f2x(qz_dyp[32 + k]);
      qzg_bandcol(k, qzg_ddet == k + 1 ? 1 : 0.8);
      gfx_triangle(x, y - r, x + r, y, x, y + r, x - r, y);
      gfx_line(x, y - r, x, qzg_node_y(k));
    );
    k += 1;
  );
);
// the node's drag (before the graph's own input): a press on a node takes it; the frequency follows the pointer
function qzg_det_drag() local(k, x, y, hit) (
  qzg_ddet ? (
    LMB && qzg_live(qzg_ddet - 1) ? ( qzg_dyp_set(qzg_ddet - 1, 32, max(20, min(20000, qzg_x2f(mx)))); ) : qzg_ddet = 0;
  ) : lmb_down ? (
    y = qzg_gy + qzg_gh - 40 * qzg_s; hit = -1; k = 0;
    loop(16,
      qzg_on(k) && qzg_mode(k) >= 3 && qz_dyn_able(qzg_shape(k)) && qz_dyp[16 + k] < 0.5 ? (
        x = qzg_f2x(qz_dyp[32 + k]);
        abs(mx - x) <= 7 * qzg_s && abs(my - y) <= 7 * qzg_s ? hit = k;
      );
      k += 1;
    );
    hit >= 0 ? ( qzg_ddet = hit + 1; lmb_down = 0; );
  );
  qzg_ddet ? ( qzg_cur = 32644; qzg_hlp("Free detector: drag to the frequency this band listens to"); );
);
// a band reacting right now (the window redraws so its curve follows)
function qzg_dyn_moving() local(k, a) (
  qz_dlsn >= 0 && qzg_mode(qz_dlsn) < 3 ? qz_dlsn = -1;   // the listen chip lets go of a band that stopped reacting
  a = 0; k = 0; loop(16, abs(qz_dyng[k]) > 0.05 ? a = 1; k += 1; ); a;
);
function qzg_need_draw(pulse, force) local(m, sig, d, sr, two) (
  sr = max(0, min(2, _srf | 0));
  m = qzg_srfm + 4 * sr;                          // [0] last sig, [1] last drawn, [2] last pass, [3] input last pass
  // shown in the track panel AND the mixer at once: REAPER runs the two strips' passes in turn on ONE canvas, so a
  // skipped pass shows the other strip's picture or nothing (MEASURED 2026-11-04, qz_face_dual.cfg: black or the other
  // face, the user's "blinks all the time" under Swing). While the other strip has run in the last half second, every
  // pass draws (rk_embed_idle never skips there either: its hash holds the canvas size, which flips every pass)
  two = sr > 0 && qzg_now - qzg_srfm[4 * (3 - sr) + 2] < 0.5;
  sig = qzg_sig();
  qzg_now - m[2] > 0.25 ? rkm_close();
  d = force || two || rkm_on || sig !== m[0] || m[3] || frame_wheel != 0 || qzg_now - m[2] > 0.25 || qzg_now - m[1] > 1 ||
      (pulse && floor(qzg_now * 15) !== floor(m[1] * 15));
  m[0] = sig; m[2] = qzg_now;
  m[3] = LMB || RMB || lmb_down || rmb_down || frame_wheel != 0;
  d ? m[1] = qzg_now;
  d;
);
// The pointer shape the widgets asked for (qzg_cur: 32646 move over or while dragging a dot, 32645 up-down over or
// while dragging a field or knob, 32649 hand over buttons, chips, icons and the header), set every window pass while
// the pointer is over the window or a drag holds it; the arrow otherwise (the 3-Band's stuck-arrow lesson, wiki 4.5).
function qzg_cursor() (
  qzg_drag >= 0 || qzg_fdrag || qzg_kdrag || qzg_box ||
  (mouse_x >= 0 && mouse_y >= 0 && mouse_x < gfx_w && mouse_y < gfx_h) ? gfx_setcursor(qzg_curl > 0 ? qzg_curl : 32512);
);

// The theme panel's clicks (house rule 5): Quezy handles the graph before it draws the top bar (so the bar sits on top),
// so while the panel or one of its lists is open, a press over it must not reach the graph or the bars first. Take the
// pointer only on such passes, never from a running drag, never under the node menu; give it back only for the
// cluster's own call (qzg_topbar).
function qzg_th_gate() (
  qzg_th_st = 0;
  !rkm_on && qzg_drag < 0 && !qzg_fdrag && !qzg_kdrag && !qzg_box && !(qzg_lgd && LMB) &&
  (rkth_open || rkth_dd_open || (rkth_cl_open && qzg_in(mx, my, rkth_clp_x, rkth_clp_y, rkth_clp_w, rkth_clp_h))) ? (
    qzg_th_st = 1; qzg_th_mx = mx; qzg_th_my = my; qzg_th_l = lmb_down; qzg_th_r = rmb_down; qzg_th_w = frame_wheel;
    mx = my = -10000; lmb_down = rmb_down = 0; frame_wheel = 0;
  );
);

// ---- the window ----
// The scale: the screen's (gfx_ext_retina) times how far the window outgrows the 648 x 534 design, 1..3, so a big window
// gets bigger controls and text with the graph, not a small face in a large plate (the 4-Band's rule).
function qzg_window_full() local(s, k, hov, ret, r, t) (
  qzg_txk = qzv_txt == 1 ? 1.15 : qzv_txt == 2 ? 1.3 : 1;
  ret = max(1, gfx_ext_retina);
  qzg_s = s = ret * max(1, min(3, min(gfx_w / (648 * ret), gfx_h / (534 * ret))));
  qzg_bw = max(1, floor(s + 0.5)); qzg_hl = max(1, floor(s));   // the line widths for this scale (qzg_obox)
  qzg_now = time_precise();
  // the window reopened (or stalled as long as the audio side's heartbeat limit): the headphones start off
  qzg_now - qzg_wlast > 0.5 ? ( qzg_lsn = -1; qzg_lgd = 0; qzm_byp = 0; );   // and the bypass ends
  qzg_wlast = qzg_now;
  qzg_dbl_t = RK_DBLCLICK_T;           // the house's double-click time (0.3 s in a window) for the fields and knobs,
  qzg_gdbl_t = max(qzg_dbl_t, 0.4);    // ReEQ's 0.4 s on the graph (the user: double-click to add bands "the way
                                       // ReEQ can"); a wider one would turn a quick knob re-grab into a reset
  qzg_an_post();                       // what the audio side feeds the analyser (every pass, drawn or not)
  qzg_hist_tick();                     // undo: the first snapshot, then each finished edit's (every pass)
  qzg_need_draw(qzg_prim >= 0 && qzg_sel[qzg_prim] && qzg_dots_shown(), qzg_anim || qzg_an_live(0) || qzg_lk_busy() || qzg_hlp_pend || qzg_ty || qzg_dyn_moving() || qzg_ch > 0) ? (   // no pulse for a hidden dot
    qzg_dt = min(max(0, qzg_now - qzg_tlast), 0.05); qzg_tlast = qzg_now;
    qzg_cur = 0;
    qzg_hlp_on = 0;                    // the hover help: the control under the pointer names itself this pass
    qzg_retarget();
    qzg_curves();
    qzg_order();                       // band numbers and colours: by slot, or left to right
    qzg_layout();
    qzg_simple = qzg_simple_on();      // simple mode (§10b): the curve shorter, the deck under it, its eight dots
    qzg_simple ? qzg_simple_setup();
    qzg_simple ? ( qzg_gh = max(100 * s, gfx_h - 200 * s); qzg_ghalf = max(10, qzg_gh / 2 - 34 * s); qzg_gbot = qzg_gh; );
    qzg_xmap();                        // the curve's points across this width (after the layout and the curves)
    qzg_palette();                     // Midnight, or the suite theme's chrome (the graph stays dark)
    // the link controls' place (the top bar's right end), then their gate: while the group grid is open nothing below
    // sees a click or the wheel (rk_link_menu_gate; Esc closes it)
    qzg_lkrr = 6 * s; qzg_lkbs = 11 * s; qzg_lky = 15 * s; qzg_lkx = gfx_w - 8 * s - qzg_lkrr;
    qzg_lkw = 2 * qzg_lkrr + qzg_lkbs + 5 * s + 12 * s + 10 * s + 2 * 18 * s + 10 * s + 2 * 18 * s + 2 * s;   // + undo / redo / A | B
    qzg_font(11 * s, 1); qzg_lkw += qzg_tw("SIMPLE") + qzg_tw("FULL") + 36 * s;                                // + SIMPLE | FULL
    qzg_type_keys();                   // a field being typed into takes the key (and a click off it sets the value)
    // the 0 key: every band's gain to 0 dB (not while a menu or the theme panel is open, or a field takes the key)
    qzg_ch == '0' && !rkm_on && !rkth_open && !qzg_th_st && !rk_menu_open ? ( qzg_zero_all(); qzg_ch = 0; );   // + the link grid
    rk_link_key = qzg_ch;
    rk_link_menu_gate();
    rkm_gate();                        // while the menu is open nothing below sees the mouse
    qzg_th_gate();                     // while the theme panel is open, its clicks are its own
    qzg_simple ? (
      qzg_sdk_drag();                  // simple mode: the deck's knobs, and the graph's dots (no adding, deleting or
      !qzg_sdd ? qzg_graph_input();    // reshaping there: qzg_graph_input keeps simple's eight jobs)
    ) : (
      qzg_field_drag();
      qzg_knob_drag();
      qzg_dyn_drag();
      qzg_det_drag();
      !qzg_fdrag && !qzg_kdrag && !qzg_ddrag && !qzg_ddet ? qzg_graph_input();   // the graph's own area and its running drags
    );
    qzg_order();                       // again: this pass's input may have added, moved or deleted a band
    qzg_lsrc = qzg_listen_src();       // what plays, for the picture (the post at the end has the pass's last word)
    // the dot under the pointer (or the one being dragged) grows over ~90 ms
    qzg_hot = qzg_drag >= 0 ? qzg_drag : !qzg_box && !qzg_fdrag && !qzg_kdrag &&
              qzg_in(mx, my, 0, 30 * s, gfx_w, qzg_gbot - 30 * s) && !qzg_in(mx, my, 8 * s, 34 * s, 44 * s + qzg_bpw, 18 * s) ?
              qzg_hit(mx, my, 14 * s) : -1;
    qzg_prim >= 0 && qzg_live(qzg_prim) ? qzg_lastpl = qzg_place(qzg_prim);
    qzg_anim = 0; k = 0;
    loop(16,
      t = k == qzg_hot ? 1 : 0;
      qzg_hv[k] += max(-qzg_dt * 11, min(qzg_dt * 11, t - qzg_hv[k]));
      qzg_hv[k] !== t ? qzg_anim = 1;
      k += 1;
    );
    qzg_draw_backdrop();
    qzg_an_shown(0) && !qzg_simple ? ( qzg_an_apply(0); qzg_draw_an(0); qzg_an_tl = qzg_an_tail(); ) : qzg_an_tl = 0;   // under the grid
    qzg_draw_grid();
    qzv_an_piano && !qzg_simple ? qzg_draw_piano() : qzg_pkf = 0;
    // the Stereo fills and the Bypassed outlines, then (in Both) the Mid / Side / Left / Right bands' fills, then the
    // placements' totals, then the On Mid / Side / Left / Right bands' patterned lines over them, then the sum, then
    // (in Lines and Both) the Stereo bands' outlines on top; only rows gathered this pass
    qzg_lb = qzg_look(qzv_wb);
    k = 0; loop(16, qzg_live(k) && qzg_cvon[k] && !(qzg_on(k) && qzg_place(k)) ? qzg_draw_band_curve(k, 0); k += 1; );
    qzg_lb == 2 ? ( k = 0; loop(16, qzg_on(k) && qzg_place(k) && qzg_cvon[k] ? qzg_band_fill(k, 0); k += 1; ); );
    qzg_draw_ptot(1.6 * s);
    k = 0; loop(16, qzg_on(k) && qzg_place(k) && qzg_cvon[k] ? qzg_draw_band_curve(k, 0); k += 1; );
    qzg_draw_sum();
    qzg_draw_edges(0);
    qzv_an_phase ? qzg_draw_phase();
    qzg_live_count() == 0 && qzg_gh >= 176 * s ? (
      qzg_font(11 * s, 1); qzg_col(qzg_p_dim, 1);
      qzg_text_c("Empty and flat \xc2\xb7 double-click the graph to add a band", 0, qzg_gh / 2 - 32 * s, gfx_w, 16 * s);
    );
    hov = qzg_drag < 0 && !qzg_box && !qzg_fdrag && !qzg_kdrag && qzg_in(mx, my, 0, 30 * s, gfx_w, qzg_gbot - 30 * s) &&
          !qzg_in(mx, my, 8 * s, 34 * s, 44 * s + qzg_bpw, 18 * s);
    // the stems with the curves (the review): under the listen dimming and the hover readout, under every dot, and only
    // for rows gathered this pass (a band added by this pass's double-click has no curve yet to point at)
    qzg_dots_shown() ? ( k = 0; loop(16, qzg_live(k) && qzg_cvon[k] ? qzg_draw_stem(k); k += 1; ); );
    qzg_lsrc > 0 ? qzg_draw_listen(qzg_lsrc);
    hov && qzg_hot < 0 && qzg_lsrc != 17 && !qzg_simple ? qzg_draw_hover();
    qzg_dots_shown() ? ( k = 0; loop(16, qzg_live(k) ? qzg_draw_dot(k); k += 1; ); );
    // dynamics (ReEQ 2's way): the curve and its dot move with the band; while one is pulled away from its setting, its
    // resting curve shows as a dotted line; a free detector's node sits low on the graph at the frequency it listens to
    qzg_dyn_rest();
    qzg_det_nodes();
    qzg_drag >= 0 && qzg_moved ? qzg_draw_tag(qzg_drag);
    qzg_lsrc > 0 ? qzg_draw_listen_banner(qzg_lsrc);
    qzg_box ? (
      qzg_col(qzg_p_acc, 0.10); gfx_rect(min(qzg_bx0, qzg_bx), min(qzg_by0, qzg_by), abs(qzg_bx - qzg_bx0), abs(qzg_by - qzg_by0));
      qzg_col(qzg_p_acc, 1); qzg_orect(min(qzg_bx0, qzg_bx), min(qzg_by0, qzg_by), abs(qzg_bx - qzg_bx0), abs(qzg_by - qzg_by0));
    );
    qzg_topbar();
    qzg_simple ? qzg_simple_deck() : (
      qzg_bandbar();
      qzg_order();                     // + ADD in the band bar: the editor shows the new band's real number
      qzg_editor();
      qzg_txk0 = qzg_txk; qzg_txk = 1; qzg_outbar(); qzg_txk = qzg_txk0;   // the output bar's fixed spacing keeps its text size
    );
    qzg_hot >= 0 ? qzg_cur = 32646;
    qzg_hot >= 0 ? qzg_hlp("Drag: frequency + gain (Alt fine, Ctrl the Q, Ctrl+Alt one way); wheel: Q; double-click: on / off");
    qzg_fdrag || qzg_kdrag ? qzg_cur = 32645 : qzg_drag >= 0 ? qzg_cur = 32646;
    qzg_draw_help();
    rkth_cluster_overlay();            // the theme panel and its lists over the face, under the node menu (drawn passes only:
                                       // its shadow redrawn over a kept picture would darken toward black)
    rk_link_draw_menu(qzg_lkx - 165 * s, qzg_lky + qzg_lkrr + 4 * s, s, qzg_lkr, qzg_lkg, qzg_lkb, mx, my, lmb_down);   // the group grid
    // No rk_link_on_gfx_change here (the Codex review, 2026-10-30): its push loop's locals are static, shared with the
    // @slider call on the audio thread, so the two could interleave mid-loop (218 sliders wide in Quezy). @block's
    // rk_link_pull pushes this window's changes on the next block anyway.
    r = rkm_run(qzg_ch);               // last: the menu over everything; a pick acts now (the next pass redraws it)
    r > 0 && qzg_mkind == 1 ? qzg_node_pick(r);
    r > 0 && qzg_mkind == 2 ? qzg_graph_pick(r);
    r != 0 || !rkm_on ? qzg_mkind = 0;
    qzg_curl = qzg_cur;
    qzg_listen_post();                 // last: every input of the pass is in
  ) : (
    qzm_hb = qzg_now;                  // a skipped pass: the same post stands, the heartbeat goes on
  );
  qzg_cursor();
);

// ---- the strip view: the bands' fills and lines, the placements' totals, the summed curve and the dots (the user,
//      2026-10-21: "the strip view will get color fills per band like re-EQs"). A dot drags (step 4c, the user: "just draggable dots"); a
//      double-click adds a band on empty space, turns a dot's band on / off, deletes it with Alt (ReEQ's strip, the
//      user: "the way ReEQ can"); so a single click no longer opens the window: the OPEN bar along the top does
//      (Swing's, the user: "add the Open button to its embedded like you did with swing"). ----
// A strip's geometry, set on EVERY strip pass before anything reads it: the two strips of one instance (track panel and
// mixer) and the window share these globals, and the redraw skip leaves most strip passes undrawn.
function qzg_emb_geom() (
  qzg_gx = 0; qzg_gy = 0; qzg_gw = max(1, gfx_w); qzg_gh = gfx_h; qzg_ghalf = max(4, gfx_h / 2 - 4 * qzg_s); qzg_r = 18;
  qzg_ebh = max(9 * qzg_s, min(18 * qzg_s, floor(gfx_h * 0.09)));   // the OPEN bar's click band at the top (Swing's)
);
// where band k's dot sits in the strip: the one rule for drawing and grabbing (kept inside the canvas, so a dot at
// 10 Hz or past the 18 dB range is still whole and grabbable)
function qzg_emb_x(k) ( max(3 * qzg_s, min(gfx_w - 3 * qzg_s, qzg_f2x(qzg_v(k, 3)))); );
function qzg_emb_y(k) ( max(3 * qzg_s, min(gfx_h - 3 * qzg_s, qzg_d2y(qzg_node_db(k)))); );
// the live band whose dot is nearest within rad (the lower slot on a tie), or -1
function qzg_emb_hit(px, py, rad) local(k, best, bd, d, x, y) (
  best = -1; bd = rad * rad;
  k = 0;
  loop(16,
    qzg_live(k) ? (
      x = qzg_emb_x(k) - px; y = qzg_emb_y(k) - py; d = x * x + y * y;
      d < bd ? ( bd = d; best = k; );
    );
    k += 1;
  );
  best;
);
// One strip drag at a time (one mouse), owned by the surface it started on (qzg_eo = rk_srf's _srf). From the values
// latched at the press: frequency from the sideways travel, gain (or a resonant cut's height, as in the window) from the
// vertical; shapes with neither move sideways only. No selection, no modifiers (the wheel = Q: qzg_emb_input). A still
// click changes nothing: travel counts once it passes 2 px.
function qzg_emb_drag() local(k, sh, dx, dy, d, c0, lim, sl) (
  k = qzg_ed; sh = qzg_shape(k);
  dx = mx - qzg_ex0; dy = my - qzg_ey0;
  abs(dx) + abs(dy) > 2 * qzg_s ? ( qzg_em = 1; qzg_ect = 0; );   // a moved drag is not the first half of a double-click
  qzg_em ? (
    qzg_setf(k, qzg_ef0 * exp(QZG_LF * dx / qzg_gw));
    d = -dy / qzg_ghalf * qzg_r;
    qzg_res_cut(sh) ? (
      sl = qzg_slope(k);
      sl >= 1 ? (
        c0 = qzg_cut_db(sl, qzg_eq0); lim = max(qzg_r, abs(c0));   // a cut set taller than the strip's range: no jump
        qzg_setq(k, qzg_cut_q(sl, max(-lim, min(lim, c0 + d))));
      );
    ) : qzg_has_gain(sh) ? qzg_setg(k, qzg_round(qzg_eg0 + d / max(0.01, qz_scale / 100), 0.1));
  );
);
// The strip's input, on EVERY pass (outside the redraw skip, which would otherwise leave the 0x200 decision to a stale
// pass). qzg_ehot: this pass's pointer is on a dot or this surface owns the running drag; qzg_eopen: the pointer is on
// the OPEN bar and on no dot (the host arms 0x200, a click opens the window, only then). A pass handed the other
// strip's press (_srf_foreign) does nothing. qzg_ehv: the dot drawn hovered (the dragged one, else the one under the
// pointer). A double-click (the strip's house time, 0.6 s, and at least ReEQ's 0.4) on the same surface, within 8 px.
// ---- the strip's knob view (spec §10b): the 4-Band's strip inside Quezy (the user, 2026-10-30, with a picture of the
//      4-Band's strip beside Quezy's: "I wanted four band, but with the four bands in the middle having API knobs ...
//      and then the other knobs could be regular knobs"). Laid out as the 4-Band's 7-row strip: a top band with the low
//      cut (HPF) and high cut (LPF) knobs, their names under them; five rows, high shelf then bells 4, 3, 2, 1, each a
//      knob with its name on the left and an R (reset) on the right; a bottom band with the low shelf and OUT. Every knob
//      is ReaKit's house knob (the theme panel's KNOB while a suite theme shows, the SSL knob in Quezy's looks; the user,
//      2026-10-30: "having mixed knobs is ugly", then one house knob everywhere with the ring on the bells). The bells
//      wear ReaKit's ring (rk_knob_ring, "Saturn"): drag the knob = gain, the wheel over it = frequency, in steps (eight
//      per bell) or a sweep (the theme panel's WHEEL row). The cuts' knobs set their frequency, the shelves' and OUT's
//      their gain; drag or wheel. A name click switches its band On / Bypassed (a job not in use comes on at its
//      home); R puts the band back at its home (simple mode's jobs, qzg_sjob_*). A double-click on a knob resets its
//      value. Quezy's full ranges. Elements e: 0 HPF (slot 0), 1 LPF (slot 7), 2 HS (slot 6), 3-6 bells 4..1 (slots
//      5..2), 7 LS (slot 1), 8 OUT (slider 209). ----
function qzg_skn_f(b, i) (
  i = max(0, min(7, i | 0));
  b == 0 ? ( i == 0 ? 40 : i == 1 ? 60 : i == 2 ? 80 : i == 3 ? 100 : i == 4 ? 150 : i == 5 ? 200 : i == 6 ? 300 : 400 ) :
  b == 1 ? ( i == 0 ? 150 : i == 1 ? 200 : i == 2 ? 300 : i == 3 ? 400 : i == 4 ? 500 : i == 5 ? 700 : i == 6 ? 1000 : 1500 ) :
  b == 2 ? ( i == 0 ? 600 : i == 1 ? 800 : i == 2 ? 1000 : i == 3 ? 1400 : i == 4 ? 2000 : i == 5 ? 3000 : i == 6 ? 4000 : 5000 ) :
           ( i == 0 ? 2000 : i == 1 ? 3000 : i == 2 ? 3500 : i == 3 ? 5000 : i == 4 ? 7000 : i == 5 ? 10000 : i == 6 ? 12000 : 16000 );
);
function qzg_skn_def(b) ( b == 0 ? 200 : b == 1 ? 500 : b == 2 ? 1400 : 3500; );
// the step nearest frequency f for bell b (by ratio)
function qzg_skn_near(b, f) local(i, j, d, bd) (
  j = 0; bd = 1000000; i = 0;
  loop(8, d = abs(log(max(1, f) / qzg_skn_f(b, i))); d < bd ? ( bd = d; j = i; ); i += 1; );
  j;
);
// the shelves' frequency steps (eight each, around the 4-Band's 80 Hz / 6 kHz) and the cuts' slope steps (6, 12, 18,
// 24, 36, 48, 72, 96 dB/oct as Quezy's slope indexes): their rings (the user, 2026-10-30: "the high pass filter and the
// low pass filter could have rings on it because they actually could use it. Also, the high shelf and the low shelf")
function qzg_skn_sf(e, i) (
  i = max(0, min(7, i | 0));
  e == 7 ? ( i == 0 ? 30 : i == 1 ? 50 : i == 2 ? 80 : i == 3 ? 120 : i == 4 ? 200 : i == 5 ? 300 : i == 6 ? 500 : 800 )
         : ( i == 0 ? 2000 : i == 1 ? 3000 : i == 2 ? 4500 : i == 3 ? 6000 : i == 4 ? 8000 : i == 5 ? 10000 : i == 6 ? 12000 : 16000 );
);
function qzg_skn_snear(e, f) local(i, j, d, bd) (
  j = 0; bd = 1000000; i = 0;
  loop(8, d = abs(log(max(1, f) / qzg_skn_sf(e, i))); d < bd ? ( bd = d; j = i; ); i += 1; );
  j;
);
function qzg_skn_sl(i) ( i = max(0, min(7, i | 0)); i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 2 : i == 3 ? 3 : i == 4 ? 5 : i == 5 ? 7 : i == 6 ? 11 : 15; );
function qzg_skn_slnear(sl) local(i, j, d, bd) (
  j = 0; bd = 1000; i = 0;
  loop(8, d = abs(qzg_skn_sl(i) - sl); d < bd ? ( bd = d; j = i; ); i += 1; );
  j;
);
function qzg_skn_slot(e) ( e == 0 ? 0 : e == 1 ? 7 : e == 2 ? 6 : e <= 6 ? 8 - e : e == 7 ? 1 : -1; );
function qzg_skn_bell(e) ( e >= 3 && e <= 6 ? 6 - e : -1; );   // bell index 0..3 (bell 1 = e 6)
function qzg_skn_name(e) (
  e == 3 ? ( sprintf(#qzg_skb3, "%d", qzg_dn[qzg_skn_slot(3)] + 1); #qzg_skb3; ) :   // the bells: their dot's number
  e == 4 ? ( sprintf(#qzg_skb4, "%d", qzg_dn[qzg_skn_slot(4)] + 1); #qzg_skb4; ) :
  e == 5 ? ( sprintf(#qzg_skb5, "%d", qzg_dn[qzg_skn_slot(5)] + 1); #qzg_skb5; ) :
  e == 6 ? ( sprintf(#qzg_skb6, "%d", qzg_dn[qzg_skn_slot(6)] + 1); #qzg_skb6; ) :
  e == 0 ? "LOW CUT" : e == 1 ? "HIGH CUT" : e == 2 ? "HIGH" : e == 7 ? "LOW" : "OUT";   // in words, as the window's deck
);
// the 4-Band's sizing (its 1.6 strip): the knob radius solved from the height the bands and five rows leave (the side
// pairs at 0.85 of it), capped by the width; rows share what is left. Under the OPEN bar.
function qzg_skn_geom() local(top0) (
  // the column: the strip's whole width, or in the window a centred column of the 4-Band strip's shape (no OPEN bar)
  qzg_skwin ? ( qzg_ebh = 0; qzg_skw = min(gfx_w, max(170 * qzg_s, gfx_h * 0.42)); qzg_skx0 = floor((gfx_w - qzg_skw) / 2); )
            : ( qzg_skw = gfx_w; qzg_skx0 = 0; );
  qzg_sklf = max(9 * qzg_s, floor(min(qzg_skw * 0.12, 11 * qzg_s * (qzg_skwin ? 1.3 : 1))));
  qzg_font(qzg_sklf, 1); qzg_sklh = qzg_sklf + 2 * qzg_s;
  // the FULL button at the top (the 4-Band's NODES button)
  qzg_skbh = 14 * qzg_s * (qzg_skwin ? 1.3 : 1); qzg_skbw = max(36 * qzg_s, qzg_skw * 0.25);
  qzg_skby = qzg_ebh + 3 * qzg_s;
  top0 = qzg_skby + qzg_skbh + 3 * qzg_s;
  qzg_skt0 = top0;
  qzg_skr = (gfx_h - top0 - (1 * qzg_s + qzg_sklh + 3 * qzg_s) - 5 * 6 * qzg_s - (3 * qzg_s + 1 * qzg_s + qzg_sklh + 3 * qzg_s)) / (2 * 0.85 + 5 * 2 + 2 * 0.85);
  qzg_skr = max(6 * qzg_s, min(qzg_skr, qzg_skw * 0.22));
  qzg_skhr = qzg_skr * 0.85;
  qzg_sktop = top0 + 2 * qzg_skhr + 1 * qzg_s + qzg_sklh + 3 * qzg_s;
  qzg_skbot = 3 * qzg_s + 2 * qzg_skhr + 1 * qzg_s + qzg_sklh + 3 * qzg_s;
  qzg_skrow = (gfx_h - qzg_sktop - qzg_skbot) / 5;
  qzg_skrw = max(14 * qzg_s, qzg_skr * 0.55); qzg_skrh = max(10 * qzg_s, qzg_skr * 0.45);   // R
);
function qzg_skn_x(e) ( qzg_skx0 + qzg_skw * (e == 0 ? 0.28 : e == 1 ? 0.72 : e == 7 ? 0.32 : e == 8 ? 0.72 : 0.5); );
function qzg_skn_y(e) (
  e <= 1 ? qzg_skt0 + qzg_skhr : e >= 7 ? gfx_h - qzg_skbot + 3 * qzg_s + qzg_skhr : qzg_sktop + qzg_skrow * (e - 2 + 0.5);
);
// one size for every knob (the user, 2026-10-30: "it makes the knobs look different sizes ... I want it to have a more
// uniform look"): the side pairs' size (the 4-Band's 0.85 r), the rows' knobs drawn the same
function qzg_skn_r(e) ( qzg_skhr; );
// the name's box: under the knob in the bands, left of it in the rows
function qzg_skn_nmx(e) local(w) ( qzg_font(qzg_sklf, 1); w = qzg_tw(qzg_skn_name(e)) + 4 * qzg_s;
  e <= 1 || e >= 7 ? qzg_skn_x(e) - w / 2 : qzg_skx0 + 1 * qzg_s; );
function qzg_skn_nmy(e) ( e <= 1 || e >= 7 ? qzg_skn_y(e) + qzg_skhr : qzg_skn_y(e) - qzg_sklh / 2; );
function qzg_skn_nmw(e) ( qzg_font(qzg_sklf, 1); qzg_tw(qzg_skn_name(e)) + 4 * qzg_s; );
// what knob e sets: its slider and range (kind 0 gain, 1 frequency, 3 OUT)
function qzg_skn_n(e) local(k) ( k = qzg_skn_slot(e); e == 8 ? 209 : e <= 1 ? qzg_n(k, 3) : qzg_n(k, 4); );
function qzg_skn_kind(e) ( e == 8 ? 3 : e <= 1 ? 1 : 0; );
// the element under (px, py): 0..8 a knob, 10 + e a name, 20 + e an R, 30 the FULL button, else -1
function qzg_skn_hit(px, py) local(e, h, r, x, y) (
  h = qzg_in(px, py, qzg_skx0 + (qzg_skw - qzg_skbw) / 2, qzg_skby, qzg_skbw, qzg_skbh) ? 30 : -1; e = 0;
  loop(9,
    r = qzg_skn_r(e) + 3 * qzg_s; x = qzg_skn_x(e); y = qzg_skn_y(e);
    (px - x) ^ 2 + (py - y) ^ 2 <= r * r ? h = e;
    qzg_skn_slot(e) >= 0 && qzg_in(px, py, qzg_skn_nmx(e), qzg_skn_nmy(e), qzg_skn_nmw(e), qzg_sklh) ? h = 10 + e;
    e >= 2 && e <= 6 && qzg_in(px, py, qzg_skx0 + qzg_skw - qzg_skrw - 2 * qzg_s, y - qzg_skrh / 2, qzg_skrw, qzg_skrh) ? h = 20 + e;
    e += 1;
  );
  h;
);
// a value for knob e: set, after setting its band up at its job's home when it is not in use
function qzg_skn_set(e, v) local(k, kd) (
  k = qzg_skn_slot(e); kd = qzg_skn_kind(e);
  k >= 0 ? qzg_sjob_band(k);
  qzg_set(qzg_skn_n(e), qzg_round(kd == 1 ? max(10, min(22050, v)) : max(-30, min(30, v)), kd == 1 ? 0.01 : 0.1));
);
function qzg_skn_val(e) local(k) (
  k = qzg_skn_slot(e);
  e == 8 ? max(-30, slider(209)) : k >= 0 && !qzg_live(k) ? (e <= 1 ? qzg_sjob_f(k) : 0) : slider(qzg_skn_n(e));
);
// the knob view's input (in place of the dots'): the badge and the OPEN bar keep theirs
function qzg_skn_input() local(h, e, k, b, dbl, j, v, kd) (
  qzg_skn_geom();
  qzg_ehot = 0; qzg_ehv = -1; qzg_eopen = 0;
  qzg_elk = !_srf_foreign && qzg_skd < 0 && qzg_in(mx, my, gfx_w - 18 * qzg_sks0, 0, 18 * qzg_sks0, 16 * qzg_sks0);   // the badge is drawn unscaled
  qzg_skd >= 0 && qzg_now - qzg_skt > 0.4 ? qzg_skd = -1;   // its strip stopped running
  qzg_skd >= 0 ? (
    !_srf_foreign && _srf == qzg_sko ? (
      qzg_skt = qzg_now; e = qzg_skd; kd = qzg_skn_kind(e);
      abs(qzg_sky0 - my) >= 1 ? (
        v = kd == 1 ? qzg_skv0 * 2205 ^ ((qzg_sky0 - my) / (200 * qzg_sks0)) : qzg_skv0 + (qzg_sky0 - my) * 0.25 / qzg_sks0;   // the drag's feel, unscaled
        k = qzg_skn_slot(e);
        k < 0 || qzg_has_gain(qzg_shape(k)) || kd == 1 ? qzg_skn_set(e, v);
      );
      !LMB ? qzg_skd = -1 : ( qzg_ehot = 1; qzg_skh = e; );
    );
  );
  qzg_skd < 0 && !_srf_foreign ? (
    h = qzg_elk ? -1 : qzg_skn_hit(mx, my);
    qzg_skh = h;
    h >= 0 || qzg_elk ? qzg_ehot = 1;
    h < 0 && !qzg_elk && qzg_in(mx, my, 0, 0, gfx_w, qzg_ebh) ? qzg_eopen = 1;
    lmb_down && h >= 0 && !(_srf == 1 ? _srf_plmb2 : _srf == 2 ? _srf_plmb1 : 0) ? (
      h == 30 ? qzv_simple = 0 :       // FULL: back to the full window (and the curve in the strips)
      h >= 20 ? (                      // R: the band back at its job's home (and On)
        k = qzg_skn_slot(h - 20); qzg_sjob_band(k);
        qzg_setf(k, qzg_sjob_f(k)); qzg_setg(k, 0); qzg_setq(k, qzg_sjob_q(k)); qzg_set(qzg_n(k, 0), 2);
      ) : h >= 10 ? (                  // a name: the band On / Bypassed (a job not in use comes on at its home)
        k = qzg_skn_slot(h - 10);
        !qzg_live(k) ? qzg_sjob_band(k) : qzg_set(qzg_n(k, 0), qzg_on(k) ? 1 : 2);
      ) : (                            // a knob: a double-click resets its value, a press grabs it
        e = h;
        dbl = qzg_now - qzg_skc < max(RK_DBLCLICK_T, 0.4) && qzg_skck == e && _srf == qzg_skcs;
        dbl ? (
          b = qzg_skn_bell(e); k = qzg_skn_slot(e);
          e == 8 ? qzg_set(209, 0) : e <= 1 ? qzg_skn_set(e, qzg_sjob_f(k)) :
          b >= 0 ? ( qzg_skn_set(e, 0); qzg_setf(k, qzg_skn_def(b)); ) : qzg_skn_set(e, 0);
          qzg_skc = 0;
        ) : (
          qzg_skc = qzg_now; qzg_skck = e; qzg_skcs = _srf;
          k = qzg_skn_slot(e); k >= 0 ? qzg_sjob_band(k);
          qzg_skd = e; qzg_sko = _srf; qzg_skt = qzg_now; qzg_sky0 = my; qzg_skv0 = qzg_skn_val(e);
        );
      );
      lmb_down = 0;
    );
    frame_wheel != 0 ? (
      h = qzg_skn_hit(mx, my);
      h >= 0 && h <= 8 ? (
        e = h; b = qzg_skn_bell(e); k = qzg_skn_slot(e);
        b >= 0 ? (                     // a bell: the wheel is its frequency (its ring)
          qzg_sjob_band(k);
          qzv_swheel ? qzg_setf(k, qzg_v(k, 3) * 2 ^ (sign(frame_wheel) / 12))
                     : ( j = max(0, min(7, qzg_skn_near(b, qzg_v(k, 3)) + sign(frame_wheel))); qzg_setf(k, qzg_skn_f(b, j)); );
        ) : e == 2 || e == 7 ? (       // a shelf: the wheel is its frequency too
          qzg_sjob_band(k);
          qzv_swheel ? qzg_setf(k, qzg_v(k, 3) * 2 ^ (sign(frame_wheel) / 12))
                     : ( j = max(0, min(7, qzg_skn_snear(e, qzg_v(k, 3)) + sign(frame_wheel))); qzg_setf(k, qzg_skn_sf(e, j)); );
        ) : e <= 1 ? (                 // a cut: the wheel is its slope (its ring: 6 .. 96 dB/oct)
          qzg_sjob_band(k);
          j = max(0, min(7, qzg_skn_slnear(qzg_slope(k)) + sign(frame_wheel))); qzg_slope_keep(k, qzg_skn_sl(j));
        ) : (
          v = qzg_skn_val(e);
          qzg_skn_set(e, qzg_skn_kind(e) == 1 ? v * 2 ^ (sign(frame_wheel) / 12) : v + 0.5 * frame_wheel);
        );
        qzg_ehot = 1; qzg_skh = e;
      );
      frame_wheel = 0;
    );
  );
);
function qzg_skn_draw() local(e, k, b, live, on, c, cr, cg, cb, x, y, r, st, hot, f, v, nx, ny, nw, a, bgr, bgg, bgb)
(
  qzg_skn_geom();
  bgr = ((qzg_p_strip / 65536) | 0) / 255; bgg = (((qzg_p_strip / 256) | 0) & 255) / 255; bgb = (qzg_p_strip & 255) / 255;
  st = rkth_active() && gmem[GS_THEME_KNOB_P] > 0 ? (gmem[GS_THEME_KNOB_P] | 0) : 1;
  // the row dividers
  qzg_col(qzg_p_grid, 1); e = 0; loop(6, gfx_rect(qzg_skx0 + 3 * qzg_s, floor(qzg_sktop + qzg_skrow * e), qzg_skw - 6 * qzg_s, 1); e += 1; );
  // the FULL button (the 4-Band's NODES): back to Quezy's full face
  a = qzg_skh == 30;
  qzg_col(a ? qzg_lerpc(qzg_p_strip, qzg_p_acc, 0.55) : qzg_lerpc(qzg_p_strip, qzg_p_acc, 0.30), 1);
  gfx_rect(qzg_skx0 + (qzg_skw - qzg_skbw) / 2, qzg_skby, qzg_skbw, qzg_skbh);
  qzg_font(max(8, floor(qzg_skbh * 0.62)), 1); qzg_col(qzg_p_tx, 1);
  qzg_text_c("FULL", qzg_skx0 + (qzg_skw - qzg_skbw) / 2, qzg_skby, qzg_skbw, qzg_skbh);
  e = 0;
  loop(9,
    k = qzg_skn_slot(e); b = qzg_skn_bell(e);
    live = k < 0 || qzg_live(k); on = k < 0 || (live && qzg_on(k));
    c = e == 8 ? qzg_p_tx : e <= 1 ? 0x8c8c99 : qzg_bcol(k);
    cr = ((c / 65536) | 0) / 255; cg = (((c / 256) | 0) & 255) / 255; cb = (c & 255) / 255;
    x = qzg_skn_x(e); y = qzg_skn_y(e); r = qzg_skn_r(e);
    hot = qzg_skh == e || qzg_skd == e;
    b >= 0 ? (
      // a bell: ReaKit's ring (rk_knob_ring: the frequency, in its steps or along the sweep) round the house knob (the gain)
      f = live ? qzg_v(k, 3) : qzg_skn_def(b);
      rk_knob_ring_draw(x, y, r * 0.66, r, qzv_swheel ? log(max(10, f) / 10) / log(2205) : qzg_skn_near(b, f) / 7,
                        qzv_swheel ? 11 : 8, !qzv_swheel, hot ? 1 : 0, cr, cg, cb, bgr, bgg, bgb);
      rk_knob_draw(st, x, y, r * 0.58, live ? max(-30, min(30, qzg_v(k, 4))) : 0, -30, 30, 1, hot ? 1 : 0, cr, cg, cb, 0, bgr, bgg, bgb);
    ) : (
      // the cuts' rings = their slope (always steps), the shelves' = their frequency (steps or a sweep), OUT's empty
      v = qzg_skn_val(e);
      e <= 1 ? rk_knob_ring_draw(x, y, r * 0.66, r, qzg_skn_slnear(live ? qzg_slope(k) : 1) / 7, 8, 1, hot ? 1 : 0, cr, cg, cb, bgr, bgg, bgb) :
      e == 2 || e == 7 ? (
        f = live ? qzg_v(k, 3) : qzg_sjob_f(k);
        rk_knob_ring_draw(x, y, r * 0.66, r, qzv_swheel ? log(max(10, f) / 10) / log(2205) : qzg_skn_snear(e, f) / 7,
                          qzv_swheel ? 11 : 8, !qzv_swheel, hot ? 1 : 0, cr, cg, cb, bgr, bgg, bgb);
      ) : rk_knob_ring_draw(x, y, r * 0.66, r, 0, 0, 0, hot ? 1 : 0, cr, cg, cb, bgr, bgg, bgb);
      e <= 1 ? rk_knob_draw(st, x, y, r * 0.58, log(max(10, v)), log(10), log(22050), 0, hot ? 1 : 0, cr, cg, cb, 0, bgr, bgg, bgb)
             : rk_knob_draw(st, x, y, r * 0.58, v, -30, 30, 1, hot ? 1 : 0, cr, cg, cb, 0, bgr, bgg, bgb);
    );
    !on ? ( qzg_col(qzg_p_strip, 0.35); gfx_circle(x, y, r + 1, 1, 1); );   // a band Off or not in use: veiled
    // the name: in the band's colour while it is On, dim and struck through while not (the 4-Band's)
    qzg_font(qzg_sklf, 1);
    nx = qzg_skn_nmx(e); ny = qzg_skn_nmy(e); nw = qzg_skn_nmw(e);
    k >= 0 && qzg_skh == 10 + e ? ( qzg_col(c, 0.15); gfx_rect(nx, ny, nw, qzg_sklh); );
    e == 8 ? qzg_col(qzg_p_tx, 1) : on ? qzg_col(e <= 1 ? qzg_p_tx : c, 1) : qzg_col(qzg_p_dim, 0.6);
    gfx_x = nx + 2 * qzg_s; gfx_y = ny + 1 * qzg_s; gfx_drawstr(qzg_skn_name(e));
    !on ? ( qzg_col(qzg_p_dim, 0.6); gfx_rect(nx + 2 * qzg_s, ny + qzg_sklh / 2, nw - 4 * qzg_s, 1); );
    // R on the five rows
    e >= 2 && e <= 6 ? (
      a = qzg_skh == 20 + e;
      qzg_col(c, a ? 0.55 : 0.35); gfx_rect(qzg_skx0 + qzg_skw - qzg_skrw - 2 * qzg_s, y - qzg_skrh / 2, qzg_skrw, qzg_skrh);
      qzg_font(max(8, floor(min(qzg_skrw * 0.7, qzg_skrh * 0.75))), 1); qzg_col(0xebebf2, a ? 1 : 0.7);
      qzg_text_c("R", qzg_skx0 + qzg_skw - qzg_skrw - 2 * qzg_s, y - qzg_skrh / 2, qzg_skrw, qzg_skrh);
    );
    e += 1;
  );
);
// The tall twin (QZ_TALL, wiki 6.17): simple mode's strip is the tall copy, the full strip the short one. A strip's
// pass asks GainKit Plus (running, and new enough: EON_RKFX_EMBED +3 >= 8 serves Quezy) to swap this instance for the
// other copy whenever the two disagree, in the band the Filter's arrow uses (mode 5 = to the tall copy, 6 = back: where
// this instance sits, the counter LAST), at most every 2 s (a swap takes a moment; Plus holds it while the song plays,
// since Quezy's state is too big for the click-free hand-over). Without Plus the short strip shows the knobs, smaller.
function qzg_long_ok() ( rkth_em_alive() && gmem[RKTH_EM_BASE + 3] >= 8; );
// the strip's knob column at any height (the user, 2026-11-02: "I never want simple mode to show growing. It should
// shrink like any other gui would"): below its 190 px design height everything in it scales down evenly
function qzg_skn_scaled(draw) local(s0) (
  s0 = qzg_sks0 = qzg_s; qzg_s = s0 * max(0.3, min(1, gfx_h / (190 * s0)));   // qzg_sks0: the badge and the drag keep the real scale
  draw ? qzg_skn_draw() : qzg_skn_input();
  qzg_s = s0;
);
function qzg_long_tick() local(t, p, f, g) (
  (qzg_simple_on() ? 1 : 0) != QZ_TALL && qzg_long_ok() && abs(time_precise() - qzg_lv_t) >= 2 ? (
    p = 0; f = 0;
    t = get_host_placement(p, f);
    gmem[RKTH_EM_BASE + 8] = QZ_TALL ? 6 : 5;
    gmem[RKTH_EM_BASE + 9] = t;
    gmem[RKTH_EM_BASE + 10] = p;
    gmem[RKTH_EM_BASE + 11] = f;
    g = (gmem[RKTH_EM_BASE + 12] | 0) + 1;
    gmem[RKTH_EM_BASE + 12] = g;
    qzg_lv_t = time_precise();
  );
);
// the window: the full face, simple mode's deck inside it (the user, 2026-10-31: "remember when you had a full simple
// with all the knobs? When I go to simple, that's what I want to see"); the strips take the 4-Band's knob column
function qzg_window() (
  qzg_once();
  qzg_window_full();
);
function qzg_emb_input() local(k, dbl) (
  qzg_ehot = 0; qzg_ehv = -1; qzg_eopen = 0;
  // the link badge in the top right corner (as the Filter's and GainKit's strips): its press is the badge's (drawn and
  // handled in qzg_embed), never a dot's, a double-click's or the OPEN bar's
  qzg_elk = !_srf_foreign && qzg_ed < 0 && qzg_in(mx, my, gfx_w - 18 * qzg_s, 0, 18 * qzg_s, 16 * qzg_s);
  // the SIMPLE chip in the bottom left corner (simple mode, §10b): a press switches the strips and the window to the
  // 4-Band layout (greyed while the setup does not fit); like the badge, never a dot's, a double-click's or the bar's
  qzg_font(max(8, 9 * qzg_s), 1); qzg_esw = qzg_tw("SIMPLE") + 8 * qzg_s;
  qzg_esm = !_srf_foreign && qzg_ed < 0 && qzg_in(mx, my, 0, gfx_h - 15 * qzg_s, qzg_esw + 2 * qzg_s, 15 * qzg_s);
  qzg_esm ? ( qzg_elk = 1; lmb_down && qzg_simple_fits() ? ( qzv_simple = qzg_simple_on() ? 0 : 1; lmb_down = 0; ); );
  qzg_ed >= 0 && (qzg_now - qzg_et > 0.4 || !qzg_live(qzg_ed)) ? qzg_ed = -1;   // its strip stopped running, or the band went
  qzg_ed >= 0 ? (
    !_srf_foreign && _srf == qzg_eo ? (
      qzg_et = qzg_now;
      qzg_emb_drag();                  // the release pass's own pointer counts too (a quick flick lands where it ended)
      !LMB ? ( qzg_ed = -1; ) : ( qzg_ehot = 1; qzg_ehv = qzg_ed; );
    );
  );
  // the dot under the pointer, also on the pass that ends a drag (the pointer is still on the dot it let go: a second
  // press there must grab, never open the window)
  qzg_ed < 0 && !_srf_foreign ? (
    k = qzg_elk ? -1 : qzg_emb_hit(mx, my, 7 * qzg_s);
    k >= 0 ? ( qzg_ehot = 1; qzg_ehv = k; );
    k < 0 && !qzg_elk && qzg_in(mx, my, 0, 0, gfx_w, qzg_ebh) ? qzg_eopen = 1;   // a dot in the bar keeps its own click
    qzg_elk ? qzg_ehot = 1;
    // a press edge (never on the OPEN bar, never while the other strip holds a press): a double-click acts first,
    // then a dot (the one pressed, or the band just added) is grabbed, so the second press can drag it on
    lmb_down && !qzg_eopen && !qzg_elk && !(_srf == 1 ? _srf_plmb2 : _srf == 2 ? _srf_plmb1 : 0) ? (
      dbl = qzg_now - qzg_ect < max(RK_DBLCLICK_T, 0.4) && _srf == qzg_ecs &&
